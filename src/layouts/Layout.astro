---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ChrisLogo from '../components/ChrisLogo.astro';
import { t } from '../utils/i18n.ts';

interface Props {
	title?: string;
	titleKey?: string;
	description?: string;
	descriptionKey?: string;
	preloadImage?: string;
}

const brandName = t('meta.title', 'en');
const {
	title = brandName,
	titleKey = title === brandName ? 'meta.title' : undefined,
	description = t('meta.description', 'en'),
	descriptionKey = title === brandName ? 'meta.description' : undefined,
	preloadImage,
} = Astro.props;

const pageTitle = title === brandName ? title : `${title} — ${brandName}`;
---

<!doctype html>
<html
	lang="en"
	data-title-key={titleKey}
	data-description-key={descriptionKey}
	transition:animate="none"
	style="background-color: #131415;"
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fustat:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		{
			preloadImage ? (
				<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
			) : null
		}
		<ClientRouter />
		<style is:inline>
			html.intro-pending #page-transition-overlay {
				pointer-events: auto;
			}

			html.intro-pending .page-transition-bar {
				transform: translateY(0);
			}

			html.intro-pending body {
				overflow: hidden;
			}

			html.intro-pending:not(.intro-revealing) body > :not(#page-transition-overlay) {
				visibility: hidden;
			}
		</style>
		<script is:inline>
			(function () {
				var path = window.location.pathname.replace(/\/$/, '') || '/';
				if (path === '/' || path.endsWith('/index.html')) {
					document.documentElement.classList.add('intro-pending');
				}
				try {
					var locale = window.localStorage.getItem('portfolio-locale');
					if (locale) document.documentElement.dataset.locale = locale;
				} catch (e) {}

				var KEY = 'cb-load-scroll';
				var TOP = 24;
				if ('scrollRestoration' in history) {
					try {
						history.scrollRestoration = 'manual';
					} catch (err) {}
				}
				function currentY() {
					return window.scrollY || document.documentElement.scrollTop || 0;
				}
				function jumpTo(y) {
					var html = document.documentElement;
					var previous = html.style.scrollBehavior;
					html.style.scrollBehavior = 'auto';
					window.scrollTo(0, y);
					html.scrollTop = y;
					if (document.body) document.body.scrollTop = y;
					html.style.scrollBehavior = previous;
				}
				function save() {
					var state = window.__cbLoadScroll;
					var y = state && state.stayTop && !state.cancelled ? 0 : currentY();
					try {
						sessionStorage.setItem(KEY, JSON.stringify({ p: path, y: y }));
					} catch (err) {}
				}
				window.addEventListener('pagehide', save);
				window.addEventListener('beforeunload', save);

				var stayTop = !location.hash;
				var restoreY = 0;
				try {
					var saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
					if (saved && saved.p === path) {
						stayTop = stayTop && saved.y <= TOP;
						restoreY = saved.y > TOP ? saved.y : 0;
					}
				} catch (err) {}

				window.__cbLoadScroll = { stayTop: stayTop, restoreY: restoreY };
				if (location.hash) return;
				if (stayTop) jumpTo(0);
				else if (restoreY) jumpTo(restoreY);
			})();
		</script>
	</head>
	<body class="relative flex min-h-screen max-w-[100vw] flex-col overflow-x-clip bg-[#131415] font-sans text-base text-setin-fg antialiased">
		<div class="noise-overlay noise-overlay--coarse" aria-hidden="true"></div>
		<div class="noise-overlay noise-overlay--fine" aria-hidden="true"></div>
		<div class="noise-scanlines" aria-hidden="true"></div>

		<div
			id="page-transition-overlay"
			class="page-transition-overlay pointer-events-none fixed inset-0 z-[9999] overflow-hidden"
			transition:persist="page-transition"
			aria-hidden="true"
		>
			<div class="page-transition-bars">
				<div class="page-transition-bar" aria-hidden="true"></div>
				<div class="page-transition-bar" aria-hidden="true"></div>
				<div class="page-transition-bar page-transition-bar--center">
					<ChrisLogo size="intro" handOnly />
				</div>
				<div class="page-transition-bar" aria-hidden="true"></div>
				<div class="page-transition-bar" aria-hidden="true"></div>
			</div>
		</div>

		<slot />

		<div
			id="site-cursor"
			class="site-cursor"
			transition:persist="site-cursor"
			aria-hidden="true"
		>
			<span class="site-cursor__glow"></span>
			<span class="site-cursor__dot"></span>
		</div>

		<script>
			import { initI18n } from '../scripts/initI18n.ts';
			import { initGlobalPreloader } from '../scripts/initGlobalPreloader.ts';
			import { initLoadScroll } from '../scripts/initLoadScroll.ts';
			import { initPageTransitionOverlay } from '../scripts/initPageTransitionOverlay.ts';
			import { initSiteCursor } from '../scripts/initSiteCursor.ts';
			import { initSmoothHashScroll } from '../scripts/initSmoothHashScroll.ts';
			import { initHeroParticles } from '../scripts/initHeroParticles.ts';
			import { initHandParticles } from '../scripts/initHandParticles.ts';
			import { initRivePlayers } from '../scripts/initRivePlayers.ts';

			initLoadScroll();
			initI18n();
			initPageTransitionOverlay();
			initGlobalPreloader();
			initSiteCursor();
			initSmoothHashScroll();
			initHeroParticles();
			initHandParticles();
			initRivePlayers();
			document.addEventListener('astro:page-load', () => {
				initI18n();
				initGlobalPreloader();
				initSiteCursor();
				initSmoothHashScroll();
				initHeroParticles();
				initHandParticles();
				initRivePlayers();
			});
		</script>
	</body>
</html>

<style is:global>
	@keyframes noise-animation {
		0% {
			transform: translate(0, 0);
		}
		10% {
			transform: translate(-5%, -5%);
		}
		20% {
			transform: translate(-10%, 10%);
		}
		30% {
			transform: translate(5%, -10%);
		}
		40% {
			transform: translate(-5%, 15%);
		}
		50% {
			transform: translate(-10%, 5%);
		}
		60% {
			transform: translate(10%, 10%);
		}
		70% {
			transform: translate(5%, -5%);
		}
		80% {
			transform: translate(-10%, -10%);
		}
		90% {
			transform: translate(10%, -5%);
		}
		100% {
			transform: translate(0, 0);
		}
	}

	@keyframes tv-flicker {
		0%,
		100% {
			opacity: 0.09;
		}
		25% {
			opacity: 0.13;
		}
		50% {
			opacity: 0.07;
		}
		75% {
			opacity: 0.11;
		}
	}

	@keyframes preloader-bar-cover {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes preloader-bar-reveal {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(100%);
		}
	}

	.page-transition-bars {
		display: flex;
		width: 100%;
		height: 100%;
	}

	.page-transition-bar {
		flex: 1 1 20%;
		height: 100%;
		background-color: #1f1f1f;
		transform: translateY(-100%);
		will-change: transform;
	}

	.page-transition-bar--center {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.page-transition-bar:nth-child(1) {
		--bar-delay: 0ms;
	}

	.page-transition-bar:nth-child(2) {
		--bar-delay: 75ms;
	}

	.page-transition-bar:nth-child(3) {
		--bar-delay: 150ms;
	}

	.page-transition-bar:nth-child(4) {
		--bar-delay: 225ms;
	}

	.page-transition-bar:nth-child(5) {
		--bar-delay: 300ms;
	}

	.page-transition-overlay.is-active {
		pointer-events: auto;
	}

	.page-transition-overlay.is-covered .page-transition-bar {
		transform: translateY(0);
	}

	.page-transition-overlay.is-covering .page-transition-bar {
		animation: preloader-bar-cover 900ms cubic-bezier(0.85, 0, 0.15, 1) forwards;
		animation-delay: var(--bar-delay);
	}

	.page-transition-overlay.is-revealing .page-transition-bar {
		animation: preloader-bar-reveal 900ms cubic-bezier(0.85, 0, 0.15, 1) forwards;
		animation-delay: var(--bar-delay);
	}

	.page-transition-overlay .logo-mark {
		position: relative;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.page-transition-overlay.is-covering .page-transition-bar,
		.page-transition-overlay.is-revealing .page-transition-bar {
			animation: none !important;
		}

		.page-transition-overlay.is-covered .page-transition-bar {
			transform: translateY(0);
		}

		.page-transition-overlay:not(.is-covered):not(.is-active) .page-transition-bar {
			transform: translateY(-100%);
		}
	}

	.noise-overlay {
		position: fixed;
		top: -50%;
		left: -50%;
		right: -50%;
		bottom: -50%;
		width: 200%;
		height: 200%;
		pointer-events: none;
	}

	/* Gruba ziarnistość — efekt śniegu na starym TV */
	.noise-overlay--coarse {
		z-index: 10;
		background: transparent
			url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.55' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")
			repeat 0 0;
		background-size: 180px 180px;
		opacity: 0.1;
		mix-blend-mode: overlay;
	}

	/* Drobniejszy szum — gęsta taśma filmowa */
	.noise-overlay--fine {
		z-index: 11;
		background: transparent
			url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")
			repeat 0 0;
		background-size: 128px 128px;
		opacity: 0.07;
		mix-blend-mode: soft-light;
	}

	/* Poziome linie scanline — charakterystyczny wygląd CRT */
	.noise-scanlines {
		position: fixed;
		inset: 0;
		z-index: 12;
		pointer-events: none;
		background: repeating-linear-gradient(
			0deg,
			rgba(0, 0, 0, 0.08) 0px,
			rgba(0, 0, 0, 0.08) 1px,
			transparent 1px,
			transparent 3px
		);
		opacity: 0.35;
		mix-blend-mode: multiply;
	}

	@media (max-width: 767px) {
		.noise-overlay--coarse {
			opacity: 0.07;
			background-size: 220px 220px;
		}

		.noise-overlay--fine {
			display: none;
		}

		.noise-scanlines {
			opacity: 0.2;
		}
	}
</style>
