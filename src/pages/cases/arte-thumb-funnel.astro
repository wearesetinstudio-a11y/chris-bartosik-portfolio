---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArteThumbFunnelCase from '../../components/cases/ArteThumbFunnelCase.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getSiteCounts } from '../../utils/getSiteCounts.ts';

const { projectCount } = await getSiteCounts();
---

<Layout
	title="Arte Thumb Funnel Case"
	description="How we engineered a thumb-driven conversion funnel for mobile-first user journeys? — Arte de Baile case study."
>
	<Header theme="light-bg" projectCount={projectCount} />

	<main class="relative z-20 flex flex-1 flex-col">
		<ArteThumbFunnelCase />
		<ContactSection />
	</main>

	<Footer />
</Layout>

<script>
	import { initProjectGalleryVideos } from '../../scripts/initProjectGalleryVideos.ts';

	function initCasePage() {
		initProjectGalleryVideos();
	}

	initCasePage();
	document.addEventListener('astro:page-load', initCasePage);
</script>
