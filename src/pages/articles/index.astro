---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticlesSection from '../../components/ArticlesSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getSiteCounts } from '../../utils/getSiteCounts.ts';
import { t } from '../../utils/i18n.ts';

const { projectCount, articleCount } = await getSiteCounts();
---

<Layout title={t('articles.pageTitle', 'en')} description={t('articles.pageDescription', 'en')}>
	<Header theme="light-bg" projectCount={projectCount} articleCount={articleCount} />

	<main class="flex-1">
		<ArticlesSection standalone />
		<ContactSection />
	</main>

	<Footer />
</Layout>
