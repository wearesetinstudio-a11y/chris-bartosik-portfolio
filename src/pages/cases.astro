---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CasesPage from '../components/CasesPage.astro';
import ContactSection from '../components/ContactSection.astro';
import { getSiteCounts } from '../utils/getSiteCounts.ts';
import { t } from '../utils/i18n.ts';

const { projectCount } = await getSiteCounts();
---

<Layout
	title={t('cases.pageTitle', 'en')}
	titleKey="cases.pageTitle"
	description={t('cases.pageDescription', 'en')}
	descriptionKey="cases.pageDescription"
>
	<Header theme="light-bg" projectCount={projectCount} />

	<main class="relative z-20 flex flex-1 flex-col">
		<CasesPage />
		<ContactSection />
	</main>

	<Footer />
</Layout>
