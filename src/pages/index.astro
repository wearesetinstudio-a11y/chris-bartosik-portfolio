---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ArticlesSection from '../components/ArticlesSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { getCollection } from 'astro:content';
import { getSiteCounts } from '../utils/getSiteCounts.ts';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const { projectCount, articleCount } = await getSiteCounts();
---

<Layout>
	<video
		src="/videos/hero-background.mp4"
		class="hero-background-video pointer-events-none fixed inset-0 z-0 h-full w-full object-cover object-center brightness-[0.85] contrast-[1.15] grayscale"
		autoplay
		muted
		loop
		playsinline
		preload="auto"
		aria-hidden="true"
	>
		<source src="/videos/hero-background.mp4" type="video/mp4" />
	</video>

	<div class="pointer-events-none fixed inset-0 z-[1] bg-[#131415]/15"></div>

	<Header projectCount={projectCount} articleCount={articleCount} waitForIntro={true} />

	<main class="relative z-20 flex-1">
		<section id="hero-section" class="relative flex min-h-[96vh] flex-col justify-end overflow-hidden px-[60px] pb-[80px] pt-28">
			<canvas
				id="cinema-pure-noise-filter"
				class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
				aria-hidden="true"
			></canvas>

			<div class="relative z-10 grid w-full grid-cols-1 items-end gap-10 lg:grid-cols-2 lg:gap-16">
				<div>
					<h1 id="hero-headline" class="hero-headline max-w-3xl uppercase text-setin-fg">
						<div class="block overflow-hidden">
							<span
								class="hero-reveal-line block translate-y-full transform opacity-0 transition-all duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
							>
								Digital legacies
							</span>
						</div>
						<div class="block overflow-hidden">
							<span
								class="hero-reveal-line block translate-y-full transform opacity-0 transition-all duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
							>
								for the outliers
							</span>
						</div>
					</h1>
				</div>

				<div class="block overflow-hidden lg:ml-auto lg:pb-1">
					<p
						class="hero-description hero-reveal-desc max-w-sm translate-y-full transform opacity-0 transition-all delay-300 duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)]"
					>
						Rooted in heritage. Built for the future. A multidisciplinary studio forging distinct
						identities, seamless interfaces, and high-performance builds.
					</p>
				</div>
			</div>
		</section>

		<script>
			import { initCinemaPureNoise } from '../scripts/initCinemaPureNoise.ts';

			initCinemaPureNoise('cinema-pure-noise-filter', { observeElementId: 'hero-section' });
		</script>

		<ClientsSection />

		<ProjectsSection projects={projects} />

		<AboutSection />

		<TestimonialsSection />

		<ArticlesSection />

		<ContactSection />
	</main>

	<Footer />

	<script>
		import { hasCompletedIntro } from '../scripts/introState.ts';

		function initHeroSlideUpReveal() {
			function revealHeroText() {
				document.querySelectorAll('.hero-reveal-line, .hero-reveal-desc').forEach((element) => {
					element.classList.remove('translate-y-full', 'opacity-0');
					element.classList.add('translate-y-0', 'opacity-100');
				});
			}

			if (hasCompletedIntro()) {
				revealHeroText();
				return;
			}

			window.addEventListener('intro-complete', revealHeroText, { once: true });
		}

		initHeroSlideUpReveal();
		document.addEventListener('astro:page-load', initHeroSlideUpReveal);
	</script>
</Layout>

<style is:global>
	.hero-background-video {
		transform: scale(1.48);
		transform-origin: center center;
	}

	.hero-headline {
		font-size: 3.8rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.hero-description {
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.625;
		color: #ffffff;
	}
</style>
