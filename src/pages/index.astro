---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import ToolsSection from '../components/ToolsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { getCollection } from 'astro:content';
import { getSiteCounts } from '../utils/getSiteCounts.ts';
import { sortProjects } from '../utils/sortProjects.ts';

const allProjects = await getCollection('projects');
const projects = sortProjects(allProjects);
const { projectCount } = await getSiteCounts();
---

<Layout>
	<Header projectCount={projectCount} theme="light-bg" />

	<main class="relative z-20 flex-1">
		<HeroSection />

		<script>
			import { initHeroSparks } from '../scripts/initHeroSparks.ts';
			import { initHeroTime } from '../scripts/initHeroTime.ts';

			function initHeroInteractions() {
				initHeroSparks();
			}

			initHeroInteractions();
			initHeroTime();

			document.addEventListener('astro:page-load', () => {
				initHeroInteractions();
				initHeroTime();
			});
		</script>

		<ToolsSection />

		<ClientsSection />

		<ProjectsSection projects={projects} />

		<AboutSection />

		<TestimonialsSection />

		<div class="contact-parallax-shell" data-contact-parallax-shell>
			<div class="contact-parallax-track" data-contact-parallax-track>
				<ContactSection />
				<Footer />
			</div>
		</div>
	</main>
</Layout>
