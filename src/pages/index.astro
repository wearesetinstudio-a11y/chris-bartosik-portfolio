---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import ToolsSection from '../components/ToolsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { getCollection } from 'astro:content';
import { getSiteCounts } from '../utils/getSiteCounts.ts';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const { projectCount } = await getSiteCounts();
---

<Layout>
	<Header projectCount={projectCount} waitForIntro={true} />

	<main class="relative z-20 flex-1">
		<HeroSection />

		<script>
			import { initHeroParticles } from '../scripts/initHeroParticles.ts';
			import { initHeroTime } from '../scripts/initHeroTime.ts';
			import { initHeroDescriptionLines } from '../scripts/splitHeroDescription.ts';
			import { initHeroGlitch } from '../scripts/initHeroGlitch.ts';
			import { initHeroCtaTilt } from '../scripts/initHeroCtaTilt.ts';
			import { initHeroBadgeStreak } from '../scripts/initHeroBadgeStreak.ts';
			import { initHeroHeadlineGlitch } from '../scripts/initHeroHeadlineGlitch.ts';

			function initHeroInteractions() {
				initHeroParticles();
				initHeroGlitch();
				initHeroHeadlineGlitch();
				initHeroCtaTilt();
				initHeroBadgeStreak();
			}

			initHeroDescriptionLines();
			initHeroInteractions();
			initHeroTime();

			document.addEventListener('astro:page-load', () => {
				initHeroDescriptionLines();
				initHeroInteractions();
				initHeroTime();
			});
		</script>

		<ToolsSection />

		<ClientsSection />

		<ProjectsSection projects={projects} />

		<AboutSection />

		<TestimonialsSection />

		<ContactSection />
	</main>

	<Footer />
</Layout>
