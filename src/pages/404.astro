---
import Layout from '../layouts/Layout.astro';
import ChrisLogo from '../components/ChrisLogo.astro';
import WorkWithUsButton from '../components/WorkWithUsButton.astro';
import { t } from '../utils/i18n.ts';
---

<Layout
	title={t('errorPage.title', 'en')}
	titleKey="errorPage.title"
	description={t('errorPage.description', 'en')}
	descriptionKey="errorPage.description"
>
	<main class="error-page">
		<section class="error-page__panel error-page__panel--copy" aria-labelledby="error-heading">
			<a
				href="/"
				class="error-page__logo"
				aria-label={t('nav.homeAria', 'en')}
				data-i18n-aria="nav.homeAria"
			>
				<ChrisLogo />
			</a>

			<div class="error-page__content">
				<h1 id="error-heading" class="error-page__heading section-headline" data-i18n="errorPage.heading">
					{t('errorPage.heading', 'en')}
				</h1>

				<div class="error-page__cta">
					<WorkWithUsButton
						href="/"
						variant="dark"
						label={t('errorPage.cta', 'en')}
						i18nKey="errorPage.cta"
					/>
				</div>
			</div>
		</section>

		<section
			id="error-hand-stage"
			class="error-page__panel error-page__panel--hand"
			aria-hidden="true"
		>
			<canvas id="hand-particles" class="error-page__canvas"></canvas>
		</section>
	</main>
</Layout>

<style is:global>
	.error-page {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-height: 100svh;
		background: #131415;
	}

	.error-page__panel--copy {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 3rem;
		padding: calc(72px + 40px) var(--page-gutter) 60px;
		background: #fff;
		color: #000;
	}

	.error-page__logo {
		display: inline-flex;
		width: fit-content;
		text-decoration: none;
		color: inherit;
	}

	.error-page__logo .logo-mark__name {
		filter: invert(1);
	}

	.error-page__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.75rem;
		max-width: 28rem;
		margin-top: auto;
		margin-bottom: auto;
	}

	.error-page__heading {
		margin: 0;
		text-transform: uppercase;
		color: #000;
	}

	.error-page__cta {
		margin-top: 0.25rem;
	}

	.error-page__panel--hand {
		position: relative;
		min-height: 48svh;
		overflow: hidden;
		background: #000;
	}

	.error-page__canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (min-width: 900px) {
		.error-page {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.error-page__panel--copy {
			padding: calc(100px + 2.5rem) var(--page-gutter) 80px;
			gap: 4rem;
		}

		.error-page__panel--hand {
			min-height: 100svh;
		}
	}
</style>
