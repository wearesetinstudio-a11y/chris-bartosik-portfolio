---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectHero from '../../components/projects/ProjectHero.astro';
import ProjectOverviewSection from '../../components/projects/ProjectOverviewSection.astro';
import ProjectContentBlock from '../../components/projects/ProjectContentBlock.astro';
import ProjectGallerySection from '../../components/projects/ProjectGallerySection.astro';
import ProjectQuoteSection from '../../components/projects/ProjectQuoteSection.astro';
import ProjectSidebar, { type SidebarNavItem } from '../../components/projects/ProjectSidebar.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getCollection } from 'astro:content';
import {
	buildGalleryLayout,
	getCoverFilename,
	getOverviewGraphic,
	resolveProjectFolderName,
	type GalleryLayoutBlock,
} from '../../utils/getProjectGallery';
import { withPublicAssetVersion } from '../../utils/withPublicAssetVersion';
import { t } from '../../utils/i18n.ts';
import { buildProjectCopyBundle } from '../../utils/getProjectCopy.ts';
import {
	buildProjectPageSegments,
	isSummaryLabel,
	resolveProjectSections,
} from '../../utils/getProjectSections.ts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	const publishedProjects = projects.filter((project) => !project.data.comingSoon);

	return publishedProjects.map((project) => ({
		params: { slug: project.id },
		props: {
			project,
			projectCount: projects.length,
		},
	}));
}

const { project, projectCount } = Astro.props;
const data = project.data;

const title = data.title ?? 'Project';
const heroSubtitle = data.heroSubtitle ?? '';
const heroBackground = data.heroBackground ?? '';
const client = data.client ?? '';
const clientLabel = data.clientLabel;
const heroImage = withPublicAssetVersion(data.heroImage || heroBackground);
const year = data.year;
const logo = data.logo ?? '';
const service = data.service ?? '';
const industry = data.industry ?? '';
const market = data.market ?? '';
const tools = data.tools ?? '';
const liveLabel = data.liveLabel ?? '';
const liveUrl = data.liveUrl ?? '';
const folderName = resolveProjectFolderName(project);
const coverFilename = getCoverFilename(data.thumbnail);
const galleryLayout = buildGalleryLayout(folderName, coverFilename);
const customOverviewLabel = (data.overviewLabel ?? '').trim();
const overviewLabel = customOverviewLabel || t('project.overview', 'en');
const overviewUsesI18nDefault = !customOverviewLabel;
const overviewTitle = data.overviewTitle ?? '';
const overviewText = data.overviewText ?? '';
const overviewGraphicItem = getOverviewGraphic(folderName, coverFilename);
const hasGroupOne = galleryLayout.some((block) => block.group === 1);
const overviewGraphicSrc = hasGroupOne
	? (data.overviewGraphic ? withPublicAssetVersion(data.overviewGraphic) : undefined)
	: (data.overviewGraphic ? withPublicAssetVersion(data.overviewGraphic) : (overviewGraphicItem ? withPublicAssetVersion(overviewGraphicItem.src) : undefined));
const overviewGraphicType = overviewGraphicItem?.type ?? 'image';
const pageGalleryLayout = galleryLayout;

const quote = data.quote ?? '';
const quoteAuthor = data.quoteAuthor ?? '';
const quoteRole = data.quoteRole ?? '';
const customQuoteLabel = (data.quoteLabel ?? '').trim();
const defaultQuoteLabel = t('project.testimonial', 'en');
const quoteLabel = customQuoteLabel || defaultQuoteLabel;
const quoteUsesI18nDefault = !customQuoteLabel;
const hasQuote = Boolean(quote || quoteAuthor);

const projectSections = resolveProjectSections(data);

type InfoRow = {
	label: string;
	labelKey: string;
	value: string;
	href?: string;
	isLink?: boolean;
	underlined?: boolean;
	fieldKey?: string;
};

const liveDisplay =
	liveLabel || (liveUrl ? liveUrl.replace(/^https?:\/\//, '') : '');

const infoRows = [
	service ? { label: t('project.service', 'en'), labelKey: 'project.service', value: service, fieldKey: 'service' } : null,
	industry ? { label: t('project.industry', 'en'), labelKey: 'project.industry', value: industry, fieldKey: 'industry' } : null,
	market ? { label: t('project.market', 'en'), labelKey: 'project.market', value: market, fieldKey: 'market' } : null,
	tools ? { label: t('project.tools', 'en'), labelKey: 'project.tools', value: tools, fieldKey: 'tools' } : null,
	year ? { label: t('project.year', 'en'), labelKey: 'project.year', value: String(year) } : null,
	liveDisplay
		? {
				label: t('project.live', 'en'),
				labelKey: 'project.live',
				value: liveDisplay,
				href: liveUrl || undefined,
				isLink: Boolean(liveUrl),
				underlined: true,
				fieldKey: 'liveLabel',
			}
		: null,
].filter((row): row is InfoRow => row !== null);

const showOverview = Boolean(overviewTitle || overviewText || infoRows.length);
const pageDescription =
	projectSections.find((section) => section.text)?.text ||
	overviewText ||
	heroSubtitle ||
	title;

function splitGalleryAfterGroup(
	blocks: GalleryLayoutBlock[],
	afterGroup: number,
): { before: GalleryLayoutBlock[]; after: GalleryLayoutBlock[] } {
	const before: GalleryLayoutBlock[] = [];
	const after: GalleryLayoutBlock[] = [];

	for (const block of blocks) {
		if (block.group <= afterGroup) before.push(block);
		else after.push(block);
	}

	return { before, after };
}

const pageSegments = buildProjectPageSegments(
	pageGalleryLayout,
	projectSections,
	splitGalleryAfterGroup,
);

let galleryMediaCursor = 0;
const projectCopy = buildProjectCopyBundle(data);
const projectCopyJson = JSON.stringify(projectCopy).replace(/</g, '\\u003c');
const revealHeadingIds = [
	'project-overview-heading',
	...projectSections
		.filter((section) => section.title)
		.map((section) => `project-section-${section.index}-heading`),
];

const navItems: SidebarNavItem[] = [
	...(showOverview
		? [
				{
					id: 'project-section-0',
					num: '01',
					label: overviewLabel,
					isOverview: true,
					labelKey: overviewUsesI18nDefault ? 'project.overview' : undefined,
				},
			]
		: []),
	...projectSections.map((section, idx) => ({
		id: `project-section-${section.index + 1}`,
		num: String(showOverview ? idx + 2 : idx + 1).padStart(2, '0'),
		label: section.label,
		sectionIndex: section.index,
	})),
];
---

<Layout title={title} description={pageDescription}>
	<Header projectCount={projectCount} />

	<main id="project-page" class="project-page relative z-20 flex-1" data-project-client={client}>
		<template id="project-copy-data" data-project-copy="true" set:html={projectCopyJson} />
		<script is:inline define:vars={{ projectCopy }}>
			globalThis.__projectCopy = projectCopy;
		</script>
		<ProjectHero
			heroImage={heroImage}
			heroSubtitle={heroSubtitle}
			client={client}
			clientLabel={clientLabel}
		/>

		<div class="project-page__body relative z-10 bg-white pb-20 transition-colors duration-500 lg:pb-0">
			<div class="project-page__container relative mx-auto w-full px-[var(--page-gutter)] py-12 md:py-20 lg:py-24">
				<div class="project-page__layout grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_65%] lg:gap-14 xl:gap-20">
					{navItems.length > 0 ? <ProjectSidebar items={navItems} /> : null}

					<div class="project-page__content flex min-w-0 flex-col gap-14 md:gap-20 lg:gap-24">
						{
							showOverview ? (
								<ProjectOverviewSection
									id="project-section-0"
									num="01"
									label={overviewLabel}
									labelKey={overviewUsesI18nDefault ? 'project.overview' : undefined}
									title={overviewTitle}
									text={overviewText}
									graphicSrc={overviewGraphicSrc}
									graphicType={overviewGraphicType}
									graphicAlt={client || title}
									rows={infoRows}
								/>
							) : null
						}

						{
							pageSegments.map((segment) => {
								if (segment.type === 'gallery') {
									const startIndex = galleryMediaCursor;
									galleryMediaCursor += segment.blocks.reduce((count, block) => {
										if (block.kind === 'full') return count + 1;
										return count + block.items.length;
									}, 0);

									return (
										<ProjectGallerySection
											blocks={segment.blocks}
											title={title}
											startIndex={startIndex}
										/>
									);
								}

								const { section } = segment;
								const sectionNum = String(
									showOverview
										? projectSections.findIndex((s) => s.index === section.index) + 2
										: projectSections.findIndex((s) => s.index === section.index) + 1,
								).padStart(2, '0');

								const isSummary = isSummaryLabel(section.label) || isSummaryLabel(section.title);

								return (
									<ProjectContentBlock
										id={`project-section-${section.index + 1}`}
										num={sectionNum}
										index={section.index + 1}
										sectionIndex={section.index}
										label={section.label}
										title={section.title}
										text={section.text}
										theme="light"
										headingId={`project-section-${section.index}-heading`}
									/>
								);
							})
						}

						{
							hasQuote ? (
								<ProjectQuoteSection
									label={quoteLabel}
									labelKey={quoteUsesI18nDefault ? 'project.testimonial' : undefined}
									quote={quote}
									author={quoteAuthor}
									role={quoteRole}
								/>
							) : null
						}
					</div>
				</div>
			</div>
		</div>

		<ContactSection />
	</main>

	<Footer />

	<script is:inline define:vars={{ revealHeadingIds }}>
		globalThis.__projectRevealHeadings = revealHeadingIds;
	</script>

	<script>
		import { bootSlideUpReveal } from '../../scripts/initSlideUpReveal.ts';
		import { initScrollLetterReveals } from '../../scripts/initScrollLetterReveal.ts';
		import { initProjectGalleryVideos } from '../../scripts/initProjectGalleryVideos.ts';
		import { initRivePlayers } from '../../scripts/initRivePlayers.ts';
		import { initProjectSidebar } from '../../scripts/initProjectSidebar.ts';

		function initProjectPage() {
			bootSlideUpReveal();
			const ids =
				(globalThis as { __projectRevealHeadings?: string[] }).__projectRevealHeadings ?? [];
			initScrollLetterReveals(ids);
			initProjectGalleryVideos();
			initRivePlayers();
			initProjectSidebar();
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initProjectPage, { once: true });
		} else {
			initProjectPage();
		}

		document.addEventListener('astro:page-load', initProjectPage);
	</script>
</Layout>

<style>
	.project-page :global([data-slide-up].is-revealed .slide-up-line) {
		transform: translateY(0);
		opacity: 1;
	}

	.project-page__body {
		background: #ffffff;
	}

	.project-page__body :global(img),
	.project-page__body :global(video) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Consistent gutter between consecutive gallery elements if any */
	.project-page__content > :global(.project-gallery + .project-gallery) {
		margin-top: calc(var(--project-gallery-gap, 20px) - 3.5rem);
	}

	@media (min-width: 768px) {
		.project-page__content > :global(.project-gallery + .project-gallery) {
			margin-top: calc(var(--project-gallery-gap, 20px) - 5rem);
		}
	}

	@media (min-width: 1024px) {
		.project-page__content > :global(.project-gallery + .project-gallery) {
			margin-top: calc(var(--project-gallery-gap, 20px) - 6rem);
		}
	}

	/* Same gutter between section↔gallery as between gallery images */
	.project-page__content > :global(.project-gallery + .project-content-block),
	.project-page__content > :global(.project-content-block + .project-gallery) {
		margin-top: 0;
	}
</style>
