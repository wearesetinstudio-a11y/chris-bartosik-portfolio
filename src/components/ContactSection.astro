---
import { t } from '../utils/i18n.ts';

const emailHref =
	'mailto:chrisdesignpty@gmail.com?subject=Hello%20Chris!%20:)';

const socialLinks: { label: string; href: string; meta?: string }[] = [
	{
		label: 'WhatsApp',
		href: 'https://api.whatsapp.com/message/IDQVMTROBPOXM1?autoload=1&app_absent=0',
		meta: '+507 6628 6524',
	},
	{
		label: 'Email',
		href: emailHref,
		meta: 'CHRISDESIGNPTY@GMAIL.COM',
	},
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/bartosik_k/',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/krzysztof-bartosik-a98855226/',
	},
];
---

<section id="contact" class="relative bg-[#131415] px-[var(--page-gutter)] py-[var(--section-padding-y)]">
	<div class="grid gap-8 md:gap-16 lg:grid-cols-2 lg:items-start lg:gap-24">
		<div class="flex flex-col">
			<h2 id="contact-heading" class="contact-heading uppercase leading-[1.15] text-setin-fg">
				<span data-reveal-line data-i18n="contact.line1">{t('contact.line1', 'en')}</span>
				<br />
				<span data-reveal-line data-i18n="contact.line2">{t('contact.line2', 'en')}</span>
			</h2>

			<p class="contact-description mt-6 max-w-md" data-i18n="contact.description">
				{t('contact.description', 'en')}
			</p>

			<div id="contact-email-wrap" class="contact-email-cta-wrap mt-10">
				<a
					href={emailHref}
					id="contact-email-cta"
					class="contact-email-cta group relative flex w-full items-center px-8 md:px-10"
				>
					<span class="contact-email-cta__inner">
						<span class="contact-email-cta__label-wrap">
							<span class="contact-email-cta__roll-inner">
								<span class="contact-email-cta__label-line contact-email-cta__label-line--default">
									<span data-i18n="contact.sendEmail">{t('contact.sendEmail', 'en')}</span>
								</span>
								<span class="contact-email-cta__label-line contact-email-cta__label-line--hover">
									<span data-i18n="contact.sendEmail">{t('contact.sendEmail', 'en')}</span>
								</span>
							</span>
						</span>
						<span
							class="contact-email-cta__hand"
							data-contact-cta-hand
							aria-hidden="true"
						>
							<img src="/chris-hand-logo.svg" alt="" width="28" height="30" />
						</span>
					</span>
				</a>
			</div>
		</div>

		<div class="contact-social lg:ml-auto lg:w-full lg:max-w-md">
			{
				socialLinks.map((link) => (
					<a
						href={link.href}
						class="contact-social__link group block border-b border-white/15 py-6 transition-colors duration-300 hover:border-white md:py-7"
						target={link.href.startsWith('http') ? '_blank' : undefined}
						rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
					>
						<span class="flex min-w-0 items-center justify-between gap-4 md:gap-8">
							<span class="contact-social__label-wrap flex h-[1.5em] min-w-0 flex-col overflow-hidden">
								<span
									class="contact-social__roll flex flex-col transition-transform duration-300 ease-in group-hover:-translate-y-1/2 group-hover:duration-[450ms] group-hover:ease-out"
								>
									<span
										class="contact-social__label-line flex h-[1.5em] items-center gap-3 text-[1rem] font-semibold uppercase leading-none text-setin-fg"
									>
										<span>{link.label}</span>
										{link.meta && <span class="contact-social__meta">{link.meta}</span>}
									</span>
									<span
										class="contact-social__label-line flex h-[1.5em] items-center gap-3 text-[1rem] font-semibold uppercase leading-none text-setin-fg"
									>
										<span>{link.label}</span>
										{link.meta && <span class="contact-social__meta">{link.meta}</span>}
									</span>
								</span>
							</span>
							<img
								src="/icons/simple-arrow.svg"
								alt=""
								width="22"
								height="18"
								class="contact-social__arrow h-4 w-auto"
							/>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style is:global>
	.contact-parallax-shell {
		--contact-parallax-overlap: min(40vh, 360px);
		position: relative;
		z-index: 10;
		margin-top: calc(-1 * var(--contact-parallax-overlap));
	}

	.contact-parallax-track {
		position: relative;
		transform: translateZ(0);
		backface-visibility: hidden;
		will-change: transform;
	}

	@media (max-width: 767px) {
		.contact-parallax-shell {
			--contact-parallax-overlap: min(30vh, 220px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-parallax-shell {
			margin-top: 0;
		}

		.contact-parallax-track {
			will-change: auto;
		}
	}

	.contact-heading {
		font-size: 1.4rem;
		line-height: 1.15;
		color: #f5f5f5;
		min-width: 0;
		max-width: 100%;
	}

	.contact-heading [data-reveal-line] {
		display: inline-block;
		white-space: nowrap;
	}

	.contact-description {
		font-size: var(--body-text-size);
		font-weight: 400;
		line-height: var(--body-text-lh);
		color: rgba(245, 245, 245, 0.55);
	}

	@media (min-width: 768px) {
		.contact-heading {
			font-size: 2rem;
		}

		.contact-description {
			font-size: 1.05rem;
			font-weight: 400;
			line-height: 1.8;
		}
	}

	#contact-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#contact-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}

	.contact-email-cta {
		height: 80px;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1;
		text-transform: uppercase;
		background-color: #252628;
		transition:
			transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
			background-color 0.35s ease;
	}

	.contact-email-cta__inner {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		line-height: 1;
	}

	.contact-email-cta__label-wrap {
		display: block;
		min-width: 0;
		height: 1em;
		overflow: hidden;
	}

	.contact-email-cta__roll-inner {
		display: flex;
		flex-direction: column;
		transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.contact-email-cta__label-line {
		display: flex;
		align-items: center;
		height: 1em;
		line-height: 1;
		white-space: nowrap;
	}

	.contact-email-cta__label-line,
	.contact-email-cta__hand img {
		transition:
			color 0.35s ease,
			filter 0.35s ease;
	}

	.contact-email-cta__label-line--default {
		color: #f5f5f5;
	}

	.contact-email-cta__label-line--hover {
		color: #18191b !important;
	}

	.contact-email-cta:hover .contact-email-cta__roll-inner,
	.contact-email-cta:focus-visible .contact-email-cta__roll-inner,
	.contact-email-cta.is-hovering .contact-email-cta__roll-inner {
		transform: translateY(-50%);
	}

	.contact-email-cta:hover .contact-email-cta__label-line--default,
	.contact-email-cta:focus-visible .contact-email-cta__label-line--default,
	.contact-email-cta.is-hovering .contact-email-cta__label-line--default {
		color: #18191b;
	}

	.contact-email-cta__hand {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.65rem;
		height: 1.65rem;
		flex-shrink: 0;
		transform-origin: 50% 100%;
	}

	.contact-email-cta__hand img {
		display: block;
		width: 100%;
		height: auto;
		filter: brightness(0) invert(1);
	}

	.contact-email-cta__hand.is-waving {
		animation: contact-cta-hand-wave 0.95s cubic-bezier(0.45, 0, 0.2, 1) 0.12s 1;
	}

	.contact-email-cta:hover .contact-email-cta__hand,
	.contact-email-cta:focus-visible .contact-email-cta__hand {
		animation: contact-cta-hand-wave 0.95s cubic-bezier(0.45, 0, 0.2, 1) 0.12s infinite;
	}

	@keyframes contact-cta-hand-wave {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}
		18% {
			transform: translateY(0) rotate(18deg);
		}
		38% {
			transform: translateY(0) rotate(-10deg);
		}
		58% {
			transform: translateY(0) rotate(14deg);
		}
		78% {
			transform: translateY(0) rotate(-6deg);
		}
	}

	.contact-email-cta:hover,
	.contact-email-cta:focus-visible,
	.contact-email-cta.is-hovering {
		background-color: #ffffff;
	}

	.contact-email-cta:hover .contact-email-cta__hand img,
	.contact-email-cta:focus-visible .contact-email-cta__hand img {
		filter: none;
	}

	.contact-social__arrow {
		display: block;
		flex-shrink: 0;
		align-self: center;
		transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.contact-social__meta {
		text-transform: none;
		font-weight: 500;
		letter-spacing: 0;
		color: #a3a3a3;
	}

	.contact-social__link:hover .contact-social__arrow,
	.contact-social__link:focus-visible .contact-social__arrow {
		transform: translateX(-6px) rotate(45deg);
	}

	@media (max-width: 767px) {
		.contact-social__label-wrap {
			height: auto;
			overflow: visible;
		}

		.contact-social__roll {
			transform: none !important;
		}

		.contact-social__roll .contact-social__label-line:last-child {
			display: none;
		}

		.contact-social__label-line {
			flex-wrap: nowrap;
			white-space: nowrap;
		}

		.contact-social__meta {
			flex: 0 1 auto;
			min-width: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-email-cta:hover,
		.contact-email-cta:focus-visible,
		.contact-email-cta.is-hovering {
			background-color: #ffffff;
		}

		.contact-email-cta:hover .contact-email-cta__label-line--default,
		.contact-email-cta:focus-visible .contact-email-cta__label-line--default,
		.contact-email-cta.is-hovering .contact-email-cta__label-line--default {
			color: #18191b;
		}

		.contact-email-cta:hover .contact-email-cta__roll-inner,
		.contact-email-cta:focus-visible .contact-email-cta__roll-inner,
		.contact-email-cta.is-hovering .contact-email-cta__roll-inner {
			transform: none;
		}

		.contact-email-cta:hover .contact-email-cta__hand img,
		.contact-email-cta:focus-visible .contact-email-cta__hand img {
			filter: none;
		}

		.contact-email-cta__hand.is-waving,
		.contact-email-cta:hover .contact-email-cta__hand,
		.contact-email-cta:focus-visible .contact-email-cta__hand {
			animation: none;
		}
	}
</style>

<script>
	import { initScrollLetterReveals } from '../scripts/initScrollLetterReveal.ts';
	import { initContactParallax } from '../scripts/initContactParallax.ts';

	function initContactHeadingReveal() {
		initScrollLetterReveals(['contact-heading']);
	}

	function initContactEmailButton() {
		const section = document.getElementById('contact');
		const button = document.getElementById('contact-email-cta');
		const hand = button?.querySelector<HTMLElement>('[data-contact-cta-hand]');

		if (!section || !button || button.dataset.emailInit === 'true') return;

		button.dataset.emailInit = 'true';

		const MAX_MOVE = 10;
		const HAND_WAVE_INTERVAL_MS = 3000;
		let handWaveIntervalId: number | null = null;
		let isButtonHovered = false;

		function stopHandWaveLoop() {
			if (handWaveIntervalId !== null) {
				window.clearInterval(handWaveIntervalId);
				handWaveIntervalId = null;
			}
		}

		function playHandWave() {
			if (!hand || isButtonHovered) return;

			hand.classList.remove('is-waving');
			void hand.offsetWidth;
			hand.classList.add('is-waving');

			const onWaveEnd = () => {
				hand.classList.remove('is-waving');
				hand.removeEventListener('animationend', onWaveEnd);
			};

			hand.addEventListener('animationend', onWaveEnd);
		}

		function startHandWaveLoop() {
			if (!hand || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if (isButtonHovered || handWaveIntervalId !== null) return;

			playHandWave();
			handWaveIntervalId = window.setInterval(playHandWave, HAND_WAVE_INTERVAL_MS);
		}

		function pauseHandWaveLoop() {
			stopHandWaveLoop();
			hand?.classList.remove('is-waving');
		}

		function onButtonHoverStart() {
			if (isButtonHovered) return;
			isButtonHovered = true;
			pauseHandWaveLoop();
		}

		function onButtonHoverEnd() {
			if (!isButtonHovered) return;
			isButtonHovered = false;
			startHandWaveLoop();
		}

		function onSectionMove(event: MouseEvent) {
			const rect = button.getBoundingClientRect();
			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;
			const deltaX = event.clientX - centerX;
			const deltaY = event.clientY - centerY;
			const moveX = Math.max(-MAX_MOVE, Math.min(MAX_MOVE, deltaX * 0.075));
			const moveY = Math.max(-MAX_MOVE, Math.min(MAX_MOVE, deltaY * 0.075));

			const isHovering =
				event.clientX >= rect.left &&
				event.clientX <= rect.right &&
				event.clientY >= rect.top &&
				event.clientY <= rect.bottom;

			button.classList.toggle('is-hovering', isHovering);

			const scale = isHovering ? 1.02 : 1;
			button.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) scale(${scale})`;
		}

		function onSectionLeave() {
			button.classList.remove('is-hovering');
			button.style.transform = 'translate3d(0, 0, 0) scale(1)';
		}

		button.addEventListener('mouseenter', onButtonHoverStart);
		button.addEventListener('mouseleave', onButtonHoverEnd);
		button.addEventListener('focus', onButtonHoverStart);
		button.addEventListener('blur', onButtonHoverEnd);

		section.addEventListener('mousemove', onSectionMove, { passive: true });
		section.addEventListener('mouseleave', onSectionLeave, { passive: true });

		startHandWaveLoop();
	}

	function bootContactSection() {
		initContactHeadingReveal();
		initContactEmailButton();
		initContactParallax();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', bootContactSection, { once: true });
	} else {
		bootContactSection();
	}

	document.addEventListener('astro:page-load', bootContactSection);
	document.addEventListener('i18n-applied', initContactHeadingReveal);
</script>
