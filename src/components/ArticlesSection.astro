---
import WorkWithUsButton from './WorkWithUsButton.astro';
import { articles } from '../data/articles.ts';

interface Props {
	standalone?: boolean;
}

const { standalone = false } = Astro.props;
const featuredArticles = articles.slice(0, 3);
const displayedArticles = standalone ? articles : featuredArticles;
---

<section
	id="articles"
	class:list={[
		'relative z-20 bg-white px-[var(--page-gutter)] py-[var(--section-padding-y)]',
		standalone && 'pt-[calc(var(--section-padding-y)+5.5rem)]',
	]}
>
	<div class="mb-16 grid gap-6 md:mb-20 md:grid-cols-2 md:items-start md:gap-16">
		<h2 id="articles-heading" class="articles-heading max-w-md uppercase leading-[1.15]">
			<span data-reveal-line>Inside</span>
			<br />
			<span data-reveal-line>the process</span>
		</h2>

		<div class="md:ml-auto md:max-w-md">
			<p class="articles-description leading-relaxed text-black/55">
				We're opening our internal documentation to showcase the systems, technical shifts, and
				strategic decisions that drive our studio.
			</p>
			{
				!standalone && (
					<div class="mt-8">
						<WorkWithUsButton
							href="/articles"
							label={`View more articles [${articles.length}]`}
							variant="dark"
						/>
					</div>
				)
			}
		</div>
	</div>

	<div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
		{
			displayedArticles.map((article) => (
				<a href={`/articles/${article.slug}`} class="article-card group block">
					<div class="article-card__image aspect-[4/3] overflow-hidden bg-[#F5F5F5]">
						<img
							src={article.image}
							alt=""
							width="640"
							height="480"
							class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
							loading="lazy"
						/>
					</div>
					<h3 class="article-card__title mt-5 text-black">{article.title}</h3>
				</a>
			))
		}
	</div>
</section>

<style is:global>
	.articles-heading {
		font-size: 2rem;
		color: #000000;
	}

	#articles-heading .reveal-char {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	#articles-heading .reveal-char.active {
		color: #000000;
	}

	.article-card__title {
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.45;
	}
</style>

<script>
	function wrapLetters(element: HTMLElement) {
		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? '\u00a0' : char;
			element.appendChild(span);
		}
	}

	function updateArticlesHeadingReveal() {
		const heading = document.getElementById('articles-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	let scrollTicking = false;

	function onArticlesScroll() {
		if (scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			updateArticlesHeadingReveal();
			scrollTicking = false;
		});
	}

	function initArticlesHeadingReveal() {
		const heading = document.getElementById('articles-heading');
		if (!heading) return;

		if (heading.dataset.revealInit !== 'true') {
			heading.dataset.revealInit = 'true';

			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			window.addEventListener('scroll', onArticlesScroll, { passive: true });
			window.addEventListener('resize', updateArticlesHeadingReveal, { passive: true });
		}

		updateArticlesHeadingReveal();
	}

	function bootArticlesHeadingReveal() {
		initArticlesHeadingReveal();

		const section = document.getElementById('articles');
		if (!section || section.dataset.revealObserved === 'true') return;

		section.dataset.revealObserved = 'true';

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) updateArticlesHeadingReveal();
				}
			},
			{ threshold: [0, 0.25, 0.5, 0.75, 1] },
		);

		observer.observe(section);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', bootArticlesHeadingReveal, { once: true });
	} else {
		bootArticlesHeadingReveal();
	}

	document.addEventListener('astro:page-load', bootArticlesHeadingReveal);
</script>
