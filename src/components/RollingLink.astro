---
interface Props {
	href: string;
	label: string;
	count?: number;
	countStyle?: 'brackets' | 'plus';
	inverted?: boolean;
	i18nKey?: string;
	current?: boolean;
	variant?: 'nav' | 'footer';
	underlined?: boolean;
}

const {
	href,
	label,
	count,
	countStyle = 'brackets',
	inverted = false,
	i18nKey,
	current = false,
	variant = 'nav',
	underlined = false,
} = Astro.props;
const text =
	count !== undefined
		? countStyle === 'plus'
			? `${label} +${count}`
			: `${label} [${count}]`
		: label;
const isFooter = variant === 'footer';

const lineClass = isFooter
	? 'site-footer__roll-line flex h-[1.35em] items-center leading-none uppercase'
	: inverted
		? 'flex h-[1.5em] items-center leading-none text-[1.05rem] font-semibold uppercase text-black'
		: 'flex h-[1.5em] items-center leading-none text-[1.05rem] font-semibold uppercase text-setin-fg';
---

<a
	href={href}
	aria-current={current ? 'page' : undefined}
	class:list={[
		'rolling-link group relative inline-flex',
		isFooter
			? 'rolling-link--footer'
			: ['flex-col -mx-1 -my-2 px-1 py-2', inverted ? 'text-black' : 'text-setin-fg'],
		current && 'rolling-link--current',
		underlined && 'rolling-link--underlined',
	]}
>
	<span class="rolling-link__label relative inline-block min-w-0">
		<div class:list={['flex flex-col overflow-hidden', isFooter ? 'h-[1.35em]' : 'h-[1.5em]']}>
			<div
				class="flex flex-col transition-transform duration-300 ease-in group-hover:-translate-y-1/2 group-hover:duration-[450ms] group-hover:ease-out"
			>
				<span
					class={lineClass}
					data-i18n={i18nKey}
					data-i18n-count={count}
					data-i18n-count-style={count !== undefined ? countStyle : undefined}
				>
					{text}
				</span>
				<span
					class={lineClass}
					data-i18n={i18nKey}
					data-i18n-count={count}
					data-i18n-count-style={count !== undefined ? countStyle : undefined}
					aria-hidden="true"
				>
					{text}
				</span>
			</div>
		</div>
		{
			underlined && (
				<span
					class="rolling-link__underline absolute left-0 top-[calc(100%+0.15em)] h-[1.5px] w-full origin-left scale-x-100 bg-current transition-transform duration-300 ease-out group-hover:origin-right group-hover:scale-x-0"
					aria-hidden="true"
				/>
			)
		}
	</span>

	{
		isFooter ? (
			<svg
				class="rolling-link__arrow"
				viewBox="0 0 18 15"
				width="18"
				height="15"
				fill="none"
				aria-hidden="true"
			>
				<path
					d="M1 7.5H17M10.6552 14L17 7.5L10.6552 1"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linejoin="bevel"
				/>
			</svg>
		) : null
	}
</a>

<style is:global>
	.rolling-link--footer {
		box-sizing: border-box;
		flex-direction: row;
		align-items: center;
		gap: 0.45em;
		min-height: 40px;
		height: 40px;
		justify-content: flex-start;
		color: #f5f5f5;
		text-decoration: none;
		transition: color 0.25s ease;
	}

	.rolling-link--footer:hover,
	.rolling-link--footer:focus-visible {
		color: rgba(245, 245, 245, 0.45);
	}

	.rolling-link--footer .site-footer__roll-line {
		font-size: inherit;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: inherit;
		text-decoration: none;
	}

	.rolling-link--footer .rolling-link__arrow {
		display: block;
		flex-shrink: 0;
		width: auto;
		height: 0.78em;
		transform: rotate(-45deg) translateZ(0);
		transform-origin: center;
		backface-visibility: hidden;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.rolling-link--footer:hover .rolling-link__arrow,
	.rolling-link--footer:focus-visible .rolling-link__arrow {
		transform: rotate(0deg) translateZ(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.rolling-link--footer,
		.rolling-link--footer .rolling-link__arrow {
			transition: none;
		}

		.rolling-link--footer .rolling-link__arrow,
		.rolling-link--footer:hover .rolling-link__arrow,
		.rolling-link--footer:focus-visible .rolling-link__arrow {
			transform: rotate(-45deg) translateZ(0);
		}
	}

	.rolling-link--underlined {
		text-decoration: none;
	}

	.rolling-link__underline {
		pointer-events: none;
	}
</style>
