---
import { t } from '../utils/i18n.ts';

const clients = [
	{ name: 'Epic Realty', src: '/logos/epic-realty.svg', height: 34 },
	{ name: 'See More Logistics', src: '/logos/see-more.svg', height: 42 },
	{ name: 'Snacks Lovers', src: '/logos/snacks-lovers.svg', height: 48 },
	{ name: 'Detalles', src: '/logos/detalles.svg', height: 34 },
	{ name: 'Avendin', src: '/logos/avendin.svg', height: 27 },
	{ name: 'Andrea Vega', src: '/logos/andrea-vega.svg', height: 48 },
	{ name: 'NRV Control Systems', src: '/logos/nrv.svg', height: 38 },
	{ name: 'Mexi Munchies', src: '/logos/meximunchies.svg', height: 48 },
	{ name: 'TRG Abogada', src: '/logos/trg.svg', height: 48 },
];
---

<section id="clients-section" class="relative z-20 bg-[#131415] px-[var(--page-gutter)] py-[var(--section-padding-y)]">
	<div class="grid gap-6 md:grid-cols-2 md:gap-16">
		<h2 id="clients-heading" class="clients-heading max-w-sm uppercase leading-[1.15]">
			<span data-reveal-line data-i18n="clients.line1">{t('clients.line1', 'en')}</span>
			<br />
			<span data-reveal-line data-i18n="clients.line2">{t('clients.line2', 'en')}</span>
		</h2>
		<p class="clients-description max-w-md leading-relaxed md:ml-auto" data-i18n="clients.description">
			{t('clients.description', 'en')}
		</p>
	</div>

	<div
		id="clients-logos"
		class="clients-logos mt-10 grid grid-cols-3 gap-x-6 gap-y-10 sm:grid-cols-3 md:mt-20 lg:grid-cols-5 lg:gap-x-14 lg:gap-y-14"
	>
		{
			clients.map((client) => (
				<div class="client-logo-item flex min-h-[48px] items-center">
					<img
						src={client.src}
						alt={client.name}
						width="200"
						height={client.height}
						style={`max-height: ${client.height}px`}
						class="h-auto w-auto max-w-full object-contain object-left brightness-0 invert"
						loading="lazy"
					/>
				</div>
			))
		}
	</div>
</section>

<style is:global>
	.clients-heading {
		font-size: 2rem;
		line-height: 1.15;
	}

	.clients-description {
		color: #ffffff;
	}

	#clients-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#clients-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}

	.client-logo-item {
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1),
			transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.client-logo-item.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	import { t } from '../utils/i18n.ts';

	function wrapLetters(element: HTMLElement) {
		const key = element.dataset.i18n;
		if (key) element.textContent = t(key);

		const text = element.textContent ?? '';
		element.textContent = '';

		for (const char of text) {
			const span = document.createElement('span');
			span.className = 'reveal-char';
			span.textContent = char === ' ' ? '\u00a0' : char;
			element.appendChild(span);
		}
	}

	function updateHeadingReveal() {
		const heading = document.getElementById('clients-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	function revealClientLogos() {
		const grid = document.getElementById('clients-logos');
		if (!grid || grid.dataset.revealed === 'true') return;

		grid.dataset.revealed = 'true';

		const items = grid.querySelectorAll('.client-logo-item');
		items.forEach((item, index) => {
			window.setTimeout(() => {
				item.classList.add('is-visible');
			}, index * 70);
		});
	}

	function initLogosReveal() {
		const grid = document.getElementById('clients-logos');
		if (!grid) return;

		if (grid.dataset.revealed === 'true') return;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						revealClientLogos();
						observer.disconnect();
					}
				}
			},
			{ threshold: 0.2, rootMargin: '0px 0px -5% 0px' },
		);

		observer.observe(grid);

		// Fallback if grid is already in view when the script runs.
		const rect = grid.getBoundingClientRect();
		if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) {
			revealClientLogos();
			observer.disconnect();
		}
	}

	function initClientsSection() {
		const heading = document.getElementById('clients-heading');

		if (heading && heading.dataset.revealInit !== 'true') {
			heading.dataset.revealInit = 'true';
			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			updateHeadingReveal();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', updateHeadingReveal, { passive: true });
		}

		initLogosReveal();
	}

	let ticking = false;

	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateHeadingReveal();
			ticking = false;
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initClientsSection, { once: true });
	} else {
		initClientsSection();
	}

	document.addEventListener('astro:page-load', initClientsSection);
</script>
