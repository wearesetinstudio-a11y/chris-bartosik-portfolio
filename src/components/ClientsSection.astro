---
import { t } from '../utils/i18n.ts';

const clients = [
	{ name: 'PhotoAiD', src: '/logos/photoaid.svg', height: 34 },
	{ name: 'Epic Realty', src: '/logos/epic-realty.svg', height: 34 },
	{ name: 'See More Logistics', src: '/logos/see-more.svg', height: 42 },
	{ name: 'Snacks Lovers', src: '/logos/snacks-lovers.svg', height: 48 },
	{ name: 'Mi Pronto', src: '/logos/detalles.svg', height: 34 },
	{ name: 'Avendin', src: '/logos/avendin.svg', height: 27 },
	{ name: 'Andrea Vega', src: '/logos/andrea-vega.svg', height: 48 },
	{ name: 'NRV Control Systems', src: '/logos/nrv.svg', height: 38 },
	{ name: 'Mexi Munchies', src: '/logos/meximunchies.svg', height: 48 },
	{ name: 'WCR Kraków', src: '/logos/wcr-krakow.svg', height: 48 },
];
---

<section id="clients-section" class="relative z-20 bg-[#131415] px-[var(--page-gutter)] pt-10 pb-[60px] md:pt-[60px] md:pb-[120px]">
	<div class="grid gap-6 md:grid-cols-2 md:gap-16">
		<h2 id="clients-heading" class="clients-heading uppercase leading-[1.15]">
			<span data-reveal-line data-i18n="clients.line1">{t('clients.line1', 'en')}</span>
			<br />
			<span data-reveal-line data-i18n="clients.line2">{t('clients.line2', 'en')}</span>
		</h2>
		<p class="clients-description max-w-md md:ml-auto" data-i18n="clients.description">
			{t('clients.description', 'en')}
		</p>
	</div>

	<div
		id="clients-logos"
		class="clients-logos mt-10 grid grid-cols-3 gap-x-6 gap-y-10 sm:grid-cols-3 md:mt-20 lg:grid-cols-5 lg:gap-x-14 lg:gap-y-14"
	>
		{
			clients.map((client) => (
				<div class="client-logo-item flex min-h-[48px] items-center justify-center">
					<img
						src={client.src}
						alt={client.name}
						width="200"
						height={client.height}
						style={`height: ${client.height}px; width: auto;`}
						class="max-w-full object-contain object-center brightness-0 invert"
						loading="lazy"
					/>
				</div>
			))
		}
	</div>
</section>

<style is:global>
	.clients-heading {
		font-size: 1.4rem;
		line-height: 1.15;
		min-width: 0;
	}

	.clients-heading [data-reveal-line] {
		display: inline-block;
		white-space: nowrap;
	}

	.clients-description {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.5;
		color: #ffffff;
	}

	@media (min-width: 768px) {
		.clients-heading {
			font-size: 2rem;
		}

		.clients-description {
			font-size: 1.1rem;
			line-height: 1.55;
		}
	}

	#clients-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#clients-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}

	.client-logo-item {
		opacity: 0;
		transform: translateY(8px);
		user-select: none;
		-webkit-user-select: none;
		transition:
			opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1),
			transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.client-logo-item.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.client-logo-item img {
		opacity: 0.7;
		user-select: none;
		-webkit-user-select: none;
		-webkit-user-drag: none;
		transition: opacity 0.3s ease;
	}

	.client-logo-item:hover img {
		opacity: 1;
	}
</style>

<script>
	import { wrapRevealLetters } from '../scripts/initScrollLetterReveal.ts';

	function wrapLetters(element: HTMLElement) {
		wrapRevealLetters(element);
	}

	function updateHeadingReveal() {
		const heading = document.getElementById('clients-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	function revealClientLogos() {
		const grid = document.getElementById('clients-logos');
		if (!grid || grid.dataset.revealed === 'true') return;

		grid.dataset.revealed = 'true';

		const items = grid.querySelectorAll('.client-logo-item');
		items.forEach((item, index) => {
			window.setTimeout(() => {
				item.classList.add('is-visible');
			}, index * 70);
		});
	}

	function initLogosReveal() {
		const grid = document.getElementById('clients-logos');
		if (!grid) return;

		if (grid.dataset.revealed === 'true') return;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						revealClientLogos();
						observer.disconnect();
					}
				}
			},
			{ threshold: 0.2, rootMargin: '0px 0px -5% 0px' },
		);

		observer.observe(grid);

		// Fallback if grid is already in view when the script runs.
		const rect = grid.getBoundingClientRect();
		if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) {
			revealClientLogos();
			observer.disconnect();
		}
	}

	function fitClientsHeading() {
		const heading = document.getElementById('clients-heading');
		if (!heading) return;

		const mobile = window.matchMedia('(max-width: 767px)').matches;
		heading.style.fontSize = '';
		if (!mobile) return;

		const lines = [...heading.querySelectorAll<HTMLElement>('[data-reveal-line]')].filter((line) =>
			(line.textContent ?? '').trim(),
		);
		if (!lines.length) return;

		const width = heading.clientWidth;
		if (width < 8) return;

		const maxPx = parseFloat(getComputedStyle(heading).fontSize) || 22.4;
		const fits = () => lines.every((line) => line.scrollWidth <= width + 1);
		if (fits()) return;

		// Only shrink when overflowing — keep visual weight close to projects heading.
		let lo = Math.max(18, maxPx * 0.88);
		let hi = maxPx;
		let best = lo;
		for (let i = 0; i < 16; i += 1) {
			const mid = (lo + hi) / 2;
			heading.style.fontSize = `${mid}px`;
			if (fits()) {
				best = mid;
				lo = mid;
			} else {
				hi = mid;
			}
		}
		heading.style.fontSize = `${best}px`;
	}

	function initClientsSection() {
		const heading = document.getElementById('clients-heading');

		if (heading && heading.dataset.revealInit !== 'true') {
			heading.dataset.revealInit = 'true';
			heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
				wrapLetters(line as HTMLElement);
			});

			fitClientsHeading();
			updateHeadingReveal();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onClientsResize, { passive: true });
			document.addEventListener('i18n-applied', onClientsLocale);
		} else {
			fitClientsHeading();
		}

		initLogosReveal();
	}

	let ticking = false;
	let resizeTick = 0;

	function onClientsResize() {
		if (resizeTick) return;
		resizeTick = window.requestAnimationFrame(() => {
			resizeTick = 0;
			fitClientsHeading();
			updateHeadingReveal();
		});
	}

	function onClientsLocale() {
		const heading = document.getElementById('clients-heading');
		if (!heading) return;
		heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
			wrapLetters(line as HTMLElement);
		});
		fitClientsHeading();
		updateHeadingReveal();
	}

	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateHeadingReveal();
			ticking = false;
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initClientsSection, { once: true });
	} else {
		initClientsSection();
	}

	document.addEventListener('astro:page-load', initClientsSection);
</script>
