---
import { localeMeta, type Locale } from '../utils/i18n.ts';

const switcherLocales: Locale[] = ['pl', 'en', 'pa'];
---

<div class="lang-switcher flex items-center gap-3" role="group" aria-label="Language" data-i18n-aria="nav.language">
	{
		switcherLocales.map((locale, index) => (
			<>
				{index > 0 && <span class="lang-switcher__sep" aria-hidden="true">/</span>}
				<button
					type="button"
					class="lang-switcher__btn"
					data-locale-option={locale}
					aria-label={localeMeta[locale].label}
				>
					{localeMeta[locale].label}
				</button>
			</>
		))
	}
</div>

<style>
	.lang-switcher__btn {
		font-family: 'Fustat', ui-sans-serif, system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		line-height: 1;
		text-transform: uppercase;
		color: currentColor;
		opacity: 0.38;
		transition: opacity 0.25s ease;
	}

	.lang-switcher__btn.is-active,
	.lang-switcher__btn:focus-visible {
		opacity: 1;
	}

	@media (hover: hover) and (pointer: fine) {
		.lang-switcher__btn:hover {
			opacity: 1;
		}
	}

	.lang-switcher__sep {
		font-size: 0.72rem;
		letter-spacing: 0;
		opacity: 0.22;
	}
</style>

<script>
	import { getLocale, isLocale, setLocale } from '../utils/i18n.ts';
	import { applyLocale } from '../scripts/initI18n.ts';
	import { prepareHeroIntroReplay, replayHeroIntro } from '../scripts/initHeroIntro.ts';
	import { isIntroSequenceRunning } from '../scripts/introState.ts';
	import {
		animatePageTransitionCover,
		animatePageTransitionReveal,
	} from '../scripts/pageTransitionPanel.ts';

	let switchingLocale = false;

	function syncLanguageSwitcher() {
		const current = getLocale();

		document.querySelectorAll<HTMLButtonElement>('[data-locale-option]').forEach((button) => {
			const locale = button.dataset.localeOption;
			button.classList.toggle('is-active', locale === current);
			button.setAttribute('aria-pressed', locale === current ? 'true' : 'false');
		});
	}

	async function switchLocale(locale: ReturnType<typeof getLocale>) {
		if (switchingLocale) return;
		if (locale === getLocale()) return;

		switchingLocale = true;
		setLocale(locale);

		try {
			if (document.body.classList.contains('mobile-nav-open')) {
				document.getElementById('mobile-nav-toggle')?.click();
			}

			if (!isIntroSequenceRunning()) {
				await animatePageTransitionCover({ href: window.location.href, source: null });
			}

			prepareHeroIntroReplay();
			applyLocale(locale);
			syncLanguageSwitcher();

			if (!isIntroSequenceRunning()) {
				await animatePageTransitionReveal();
				replayHeroIntro();
			}
		} finally {
			switchingLocale = false;
		}
	}

	function initLanguageSwitcher() {
		document.querySelectorAll<HTMLButtonElement>('[data-locale-option]').forEach((button) => {
			if (button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';

			button.addEventListener('click', () => {
				const locale = button.dataset.localeOption;
				if (!isLocale(locale)) return;
				void switchLocale(locale);
			});
		});

		syncLanguageSwitcher();
	}

	initLanguageSwitcher();
	document.addEventListener('astro:page-load', initLanguageSwitcher);
	document.addEventListener('i18n-applied', syncLanguageSwitcher);
</script>
