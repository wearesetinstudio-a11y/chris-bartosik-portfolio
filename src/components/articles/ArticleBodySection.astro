---
import ArticleProse from './ArticleProse.astro';

interface Props {
	sideMedia: string;
	sideMediaAlt?: string;
}

const { sideMedia, sideMediaAlt = '' } = Astro.props;
const isVideo = /\.(webm|mp4|mov)(\?|$)/i.test(sideMedia);
---

<section class="article-body-section px-[var(--article-gutter)] py-16 md:py-24">
	<div class="article-body-section__grid grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-20 xl:gap-24">
		<div class="article-body-section__media min-w-0">
			<div class="article-body-section__sticky lg:sticky lg:top-[100px] lg:w-full">
				<div class="article-body-section__frame w-full overflow-hidden bg-[#ECECEC]">
					{
						isVideo ? (
							<video
								src={sideMedia}
								class="block h-auto w-full"
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								aria-label={sideMediaAlt}
							/>
						) : (
							<img
								src={sideMedia}
								alt={sideMediaAlt}
								width="720"
								height="900"
								class="block h-auto w-full"
								loading="lazy"
								decoding="async"
							/>
						)
					}
				</div>
			</div>
		</div>

		<div class="article-body-section__content min-w-0">
			<ArticleProse embedded>
				<slot />
			</ArticleProse>
		</div>
	</div>
</section>

<style>
	@media (min-width: 1024px) {
		.article-body-section__media {
			align-self: stretch;
		}

		.article-body-section__sticky {
			height: fit-content;
		}
	}
</style>
