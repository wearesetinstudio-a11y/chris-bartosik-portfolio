---
interface Props {
	src: string;
	fit?: 'cover' | 'contain';
	class?: string;
	label?: string;
}

const { src, fit = 'contain', class: className = '', label = '' } = Astro.props;
---

<div
	class:list={['rive-player', className]}
	data-rive-src={src}
	data-rive-fit={fit}
	role="img"
	aria-label={label || undefined}
	aria-hidden={label ? undefined : 'true'}
>
	<canvas class="rive-player__canvas"></canvas>
</div>

<style is:global>
	.rive-player {
		position: relative;
		display: block;
		width: 100%;
		overflow: hidden;
		background: transparent;
	}

	.rive-player__canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.project-card__media .rive-player {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background: transparent;
	}

	.project-card__media .rive-player .rive-player__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* Soft fallback until artboard ratio is applied inline on load */
	.project-gallery__item--rive .rive-player,
	.project-overview__frame .rive-player {
		width: 100%;
		min-height: 240px;
		aspect-ratio: 16 / 10;
		height: auto;
		background: transparent;
	}
</style>
