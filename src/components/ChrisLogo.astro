---
import { withPublicAssetVersion } from '../utils/withPublicAssetVersion';

interface Props {
	size?: 'nav' | 'intro';
}

const { size = 'nav' } = Astro.props;
const isIntro = size === 'intro';
const nameSrc = withPublicAssetVersion('/chris-name-logo.svg');
const handSrc = withPublicAssetVersion('/chris-hand-logo.svg');
---

<span
	class:list={['logo-mark', isIntro ? 'logo-mark--intro' : 'logo-mark--nav']}
	aria-hidden="true"
>
	<img
		src={nameSrc}
		alt=""
		width="146"
		height="51"
		class="logo-mark__name"
		data-overlay-chris={isIntro ? 'true' : undefined}
		id={isIntro ? 'overlay-chris-name' : undefined}
		decoding="async"
	/>
	{isIntro && (
		<span class="logo-mark__page is-hidden" data-overlay-page id="overlay-page-name"></span>
	)}
	<img
		src={handSrc}
		alt=""
		width="52"
		height="55"
		class="logo-mark__hand"
		data-logo-hand={isIntro ? 'intro' : 'nav'}
		decoding="async"
	/>
</span>
