---
import { t } from '../utils/i18n.ts';

const socialLinks = [
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/bartosik_k/',
		icon: '/icons/insta.svg',
	},
	{
		label: 'WhatsApp',
		href: 'https://api.whatsapp.com/message/IDQVMTROBPOXM1?autoload=1&app_absent=0',
		icon: '/icons/whatsapp.svg',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/krzysztof-bartosik-a98855226/',
		icon: '/icons/linkedin.svg',
	},
] as const;
---

<div
	id="contact-modal"
	class="contact-modal"
	role="dialog"
	aria-modal="true"
	aria-hidden="true"
	aria-labelledby="contact-modal-title"
	transition:persist="contact-modal"
>
	<button
		type="button"
		class="contact-modal__backdrop"
		data-contact-close
		tabindex="-1"
		aria-hidden="true"
	></button>

	<div class="contact-modal__sheet" data-contact-sheet>
		<button
			type="button"
			class="contact-modal__close"
			data-contact-close
			aria-label={t('contact.modal.close', 'en')}
			data-i18n-aria="contact.modal.close"
		>
			<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
				<path d="M1.5 1.5L16.5 16.5M16.5 1.5L1.5 16.5" stroke="currentColor" stroke-width="1.75"></path>
			</svg>
		</button>

		<div class="contact-modal__body">
			<div class="contact-modal__socials contact-modal__socials--mobile" aria-hidden="false">
				{
					socialLinks.map((link) => (
						<a
							href={link.href}
							class="contact-modal__social"
							target="_blank"
							rel="noopener noreferrer"
							aria-label={link.label}
						>
							<img src={link.icon} alt="" width="18" height="18" />
						</a>
					))
				}
			</div>

			<div class="contact-modal__header">
				<h2 id="contact-modal-title" class="contact-modal__title" data-i18n="contact.modal.title">
					{t('contact.modal.title', 'en')}
				</h2>
				<div class="contact-modal__socials contact-modal__socials--desktop">
					{
						socialLinks.map((link) => (
							<a
								href={link.href}
								class="contact-modal__social"
								target="_blank"
								rel="noopener noreferrer"
								aria-label={link.label}
							>
								<img src={link.icon} alt="" width="18" height="18" />
							</a>
						))
					}
				</div>
			</div>

			<form id="contact-modal-form" class="contact-modal__form" novalidate>
				<div class="contact-modal__row">
					<label class="contact-modal__field">
						<input
							type="text"
							name="firstName"
							class="contact-modal__input"
							autocomplete="given-name"
							placeholder=" "
							required
						/>
						<span class="contact-modal__label" data-i18n="contact.modal.firstName">
							{t('contact.modal.firstName', 'en')}
						</span>
					</label>
					<label class="contact-modal__field">
						<input
							type="text"
							name="secondName"
							class="contact-modal__input"
							autocomplete="family-name"
							placeholder=" "
							required
						/>
						<span class="contact-modal__label" data-i18n="contact.modal.secondName">
							{t('contact.modal.secondName', 'en')}
						</span>
					</label>
				</div>

				<label class="contact-modal__field">
					<input
						type="text"
						name="contact"
						class="contact-modal__input"
						autocomplete="email"
						inputmode="email"
						placeholder=" "
						required
					/>
					<span class="contact-modal__label" data-i18n="contact.modal.contact">
						{t('contact.modal.contact', 'en')}
					</span>
				</label>

				<label class="contact-modal__field">
					<textarea
						name="message"
						class="contact-modal__input contact-modal__input--area"
						rows="1"
						placeholder=" "
						required
					></textarea>
					<span class="contact-modal__label" data-i18n="contact.modal.message">
						{t('contact.modal.message', 'en')}
					</span>
				</label>

				<button type="submit" id="contact-modal-submit" class="contact-modal__submit group">
					<span class="contact-modal__submit-inner">
						<span class="contact-modal__submit-label-wrap">
							<span class="contact-modal__submit-roll">
								<span
									class="contact-modal__submit-line contact-modal__submit-line--default"
									data-i18n="contact.modal.send"
								>
									{t('contact.modal.send', 'en')}
								</span>
								<span
									class="contact-modal__submit-line contact-modal__submit-line--hover"
									data-i18n="contact.modal.send"
									aria-hidden="true"
								>
									{t('contact.modal.send', 'en')}
								</span>
							</span>
						</span>
						<img
							src="/icons/arrow.svg"
							alt=""
							width="20"
							height="16"
							class="contact-modal__submit-arrow"
							aria-hidden="true"
						/>
					</span>
				</button>

				<p class="contact-modal__footnote" data-i18n="contact.modal.footnote">
					{t('contact.modal.footnote', 'en')}
				</p>
			</form>
		</div>
	</div>
</div>

<div
	id="contact-toast"
	class="contact-toast"
	role="status"
	aria-live="polite"
	aria-hidden="true"
	transition:persist="contact-toast"
>
	<span class="contact-toast__icon" aria-hidden="true">
		<svg class="contact-toast__check" width="18" height="18" viewBox="0 0 18 18" fill="none">
			<path
				class="contact-toast__check-path"
				d="M3.5 9.2L7.2 12.8L14.5 5"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</span>
	<span class="contact-toast__label" data-i18n="contact.modal.toast">
		{t('contact.modal.toast', 'en')}
	</span>
</div>

<style is:global>
	.contact-modal {
		--contact-modal-ease-in: cubic-bezier(0.16, 1, 0.3, 1);
		--contact-modal-ease-out: cubic-bezier(0.7, 0, 0.84, 0);
		--contact-modal-duration: 0.55s;
		position: fixed;
		inset: 0;
		z-index: 80;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.contact-modal.is-open,
	.contact-modal.is-closing {
		visibility: visible;
	}

	.contact-modal.is-open {
		pointer-events: auto;
	}

	.contact-modal__backdrop {
		position: absolute;
		inset: 0;
		border: 0;
		padding: 0;
		margin: 0;
		cursor: pointer;
		background: rgba(19, 20, 21, 0.45);
		opacity: 0;
		transition: opacity var(--contact-modal-duration) var(--contact-modal-ease-in);
	}

	.contact-modal.is-open .contact-modal__backdrop {
		opacity: 1;
	}

	.contact-modal.is-closing .contact-modal__backdrop {
		opacity: 0;
		transition-timing-function: var(--contact-modal-ease-out);
	}

	.contact-modal__sheet {
		position: relative;
		z-index: 1;
		width: min(560px, 100%);
		max-height: min(92dvh, 100%);
		margin: 0;
		overflow: visible;
		background: #ffffff;
		border-radius: 0;
		transform: translate3d(0, 100%, 0);
		transition: transform var(--contact-modal-duration) var(--contact-modal-ease-in);
		will-change: transform;
	}

	.contact-modal.is-open .contact-modal__sheet {
		transform: translate3d(0, 0, 0);
	}

	.contact-modal.is-closing .contact-modal__sheet {
		transform: translate3d(0, 100%, 0);
		transition-timing-function: var(--contact-modal-ease-out);
	}

	.contact-modal__close {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: #ffffff;
		color: #18191b;
		transform: translate(-50%, -50%);
		cursor: pointer;
		transition: color 0.25s ease, background-color 0.25s ease;
	}

	.contact-modal__close:hover,
	.contact-modal__close:focus-visible {
		color: #000;
		background: #f3f3f3;
		outline: none;
	}

	.contact-modal__body {
		max-height: min(92dvh, 100%);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 36px var(--page-gutter) calc(22px + env(safe-area-inset-bottom, 0px));
		-webkit-overflow-scrolling: touch;
	}

	.contact-modal__header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		margin-bottom: 28px;
		text-align: center;
	}

	.contact-modal__title {
		margin: 0;
		font-size: clamp(2.15rem, 8vw, 2.75rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: #18191b;
		text-align: center;
	}

	.contact-modal__socials {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.contact-modal__socials--desktop {
		display: none;
	}

	.contact-modal__socials--mobile {
		justify-content: center;
		width: 100%;
		margin-bottom: 22px;
	}

	.contact-modal__social {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 0;
		background: #f3f3f3;
		border: 0;
		transition: background-color 0.25s ease;
	}

	.contact-modal__social:hover,
	.contact-modal__social:focus-visible {
		background: #e8e8e8;
		outline: none;
	}

	.contact-modal__social img {
		display: block;
		width: 18px;
		height: 18px;
		object-fit: contain;
	}

	.contact-modal__form {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.contact-modal__row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 28px;
	}

	.contact-modal__field {
		position: relative;
		display: block;
		min-width: 0;
		padding-top: 1.15rem;
	}

	.contact-modal__label {
		position: absolute;
		left: 0;
		top: calc(1.15rem + 0.15em);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.3;
		text-transform: none;
		color: rgba(24, 25, 27, 0.4);
		pointer-events: none;
		transform-origin: left top;
		transition:
			top 0.28s cubic-bezier(0.16, 1, 0.3, 1),
			font-size 0.28s cubic-bezier(0.16, 1, 0.3, 1),
			color 0.25s ease,
			letter-spacing 0.28s ease;
	}

	.contact-modal__input {
		width: 100%;
		padding: 0.15em 0 12px;
		border: 0;
		border-radius: 0;
		border-bottom: 1px solid rgba(24, 25, 27, 0.18);
		background: transparent;
		color: #18191b;
		font: inherit;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.3;
		text-transform: none;
		letter-spacing: 0;
		outline: none;
		resize: none;
		transition: border-color 0.25s ease;
		caret-color: #18191b;
	}

	.contact-modal__input--area {
		min-height: 0;
		field-sizing: content;
		overflow-y: hidden;
	}

	.contact-modal__input--area:focus,
	.contact-modal__input--area:not(:placeholder-shown) {
		min-height: 2.6em;
		overflow-y: auto;
	}

	.contact-modal__input:focus {
		border-bottom-color: #18191b;
	}

	.contact-modal__field:focus-within .contact-modal__label,
	.contact-modal__input:not(:placeholder-shown) + .contact-modal__label,
	.contact-modal__input:-webkit-autofill + .contact-modal__label {
		top: 0;
		font-size: 0.7rem;
		letter-spacing: 0;
		line-height: 1;
		color: rgba(24, 25, 27, 0.45);
	}

	.contact-modal__input::placeholder {
		color: transparent;
		opacity: 0;
	}

	.contact-modal__input:-webkit-autofill,
	.contact-modal__input:-webkit-autofill:hover,
	.contact-modal__input:-webkit-autofill:focus,
	.contact-modal__input:-webkit-autofill:active {
		-webkit-text-fill-color: #18191b;
		caret-color: #18191b;
		box-shadow: 0 0 0 1000px #ffffff inset;
		transition: background-color 99999s ease-out 0s;
	}

	.contact-modal__submit {
		position: relative;
		display: block;
		width: 100%;
		margin-top: 12px;
		padding: 1.15rem 1.25rem;
		border: 0;
		border-radius: 0;
		background-color: #efefef;
		color: #18191b;
		cursor: pointer;
		transition:
			transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
			background-color 0.35s ease;
	}

	.contact-modal__submit-inner {
		position: relative;
		z-index: 1;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		padding-inline: 0;
		transition: padding-inline 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.contact-modal__submit-label-wrap {
		display: flex;
		height: 1.5em;
		flex-direction: column;
		overflow: hidden;
	}

	.contact-modal__submit-roll {
		display: flex;
		flex-direction: column;
		transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.contact-modal__submit-line {
		display: flex;
		height: 1.5em;
		align-items: center;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1;
		text-transform: uppercase;
		transition: color 0.35s ease;
	}

	.contact-modal__submit-line--default {
		color: #18191b;
	}

	.contact-modal__submit-line--hover {
		color: #f5f5f5 !important;
	}

	.contact-modal__submit-arrow {
		width: 20px;
		height: auto;
		flex-shrink: 0;
		filter: brightness(0);
		transition: filter 0.35s ease;
	}

	.contact-modal__submit:focus-visible .contact-modal__submit-inner,
	.contact-modal__submit.is-hovering .contact-modal__submit-inner {
		padding-inline: 8px;
	}

	.contact-modal__submit:focus-visible .contact-modal__submit-roll,
	.contact-modal__submit.is-hovering .contact-modal__submit-roll {
		transform: translateY(-50%);
	}

	.contact-modal__submit:focus-visible .contact-modal__submit-line--default,
	.contact-modal__submit.is-hovering .contact-modal__submit-line--default {
		color: #f5f5f5;
	}

	.contact-modal__submit:focus-visible,
	.contact-modal__submit.is-hovering {
		background-color: #18191b;
	}

	.contact-modal__submit:focus-visible .contact-modal__submit-arrow,
	.contact-modal__submit.is-hovering .contact-modal__submit-arrow {
		filter: brightness(0) invert(1);
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-modal__submit:hover .contact-modal__submit-inner {
			padding-inline: 8px;
		}

		.contact-modal__submit:hover .contact-modal__submit-roll {
			transform: translateY(-50%);
		}

		.contact-modal__submit:hover .contact-modal__submit-line--default {
			color: #f5f5f5;
		}

		.contact-modal__submit:hover {
			background-color: #18191b;
		}

		.contact-modal__submit:hover .contact-modal__submit-arrow {
			filter: brightness(0) invert(1);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.contact-modal__submit:active .contact-modal__submit-inner {
			padding-inline: 8px;
		}

		.contact-modal__submit:active .contact-modal__submit-roll {
			transform: translateY(-50%);
		}

		.contact-modal__submit:active .contact-modal__submit-line--default {
			color: #f5f5f5;
		}

		.contact-modal__submit:active {
			background-color: #18191b;
		}

		.contact-modal__submit:active .contact-modal__submit-arrow {
			filter: brightness(0) invert(1);
		}
	}

	.contact-modal__footnote {
		margin: 2px 0 0;
		text-align: center;
		font-size: 0.8rem;
		line-height: 1.4;
		color: rgba(24, 25, 27, 0.42);
	}

	.contact-toast {
		position: fixed;
		left: 50%;
		bottom: max(2.5rem, calc(env(safe-area-inset-bottom, 0px) + 1.5rem));
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 12px 18px;
		border: 1px solid #7dffa9;
		border-radius: 0;
		background: #0f2f22;
		color: #9af0b8;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translate3d(-50%, 18px, 0);
		transition:
			opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0s linear 0.45s;
	}

	.contact-toast.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translate3d(-50%, 0, 0);
		transition:
			opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0s linear 0s;
	}

	.contact-toast__icon {
		display: flex;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		color: #8ef0b8;
	}

	.contact-toast__check {
		display: block;
		width: 18px;
		height: 18px;
	}

	.contact-toast__check-path {
		stroke-dasharray: 24;
		stroke-dashoffset: 24;
	}

	.contact-toast.is-visible .contact-toast__check-path {
		animation: contact-toast-check 0.55s cubic-bezier(0.65, 0, 0.35, 1) 0.12s forwards;
	}

	@keyframes contact-toast-check {
		from {
			stroke-dashoffset: 24;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	.contact-toast__label {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	body.contact-modal-open {
		overflow: hidden;
		overscroll-behavior: none;
	}

	html.contact-modal-open {
		overflow: hidden;
		overscroll-behavior: none;
	}

	@media (min-width: 768px) {
		.contact-modal {
			align-items: flex-end;
			padding: 0;
		}

		.contact-modal__sheet {
			width: min(640px, 100%);
			margin: 0;
			border-radius: 0;
		}

		.contact-modal__body {
			padding: 44px 40px calc(32px + env(safe-area-inset-bottom, 0px));
		}

		.contact-modal__header {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			margin-bottom: 36px;
			text-align: left;
		}

		.contact-modal__title {
			text-align: left;
			font-size: 2.15rem;
		}

		.contact-modal__socials--mobile {
			display: none;
		}

		.contact-modal__socials--desktop {
			display: flex;
			flex-shrink: 0;
		}

		.contact-modal__row {
			grid-template-columns: 1fr 1fr;
			gap: 36px;
		}

		.contact-modal__form {
			gap: 36px;
		}

		.contact-modal__submit {
			padding: 1.35rem 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-modal__backdrop,
		.contact-modal__sheet,
		.contact-toast,
		.contact-modal__submit,
		.contact-modal__submit-inner,
		.contact-modal__submit-roll,
		.contact-modal__submit-line,
		.contact-modal__submit-arrow,
		.contact-modal__label {
			transition: none !important;
		}

		.contact-modal.is-open .contact-modal__sheet,
		.contact-modal.is-closing .contact-modal__sheet {
			transform: none;
		}

		.contact-toast.is-visible .contact-toast__check-path {
			animation: none;
			stroke-dashoffset: 0;
		}

		.contact-modal__submit:focus-visible .contact-modal__submit-roll,
		.contact-modal__submit.is-hovering .contact-modal__submit-roll {
			transform: none;
		}

		@media (hover: hover) and (pointer: fine) {
			.contact-modal__submit:hover .contact-modal__submit-roll {
				transform: none;
			}
		}
	}
</style>

<script>
	import {
		getLenis,
		scrollToImmediate,
		startSmoothScroll,
		stopSmoothScroll,
	} from '../scripts/initSmoothScroll.ts';

	const WEB3FORMS_ACCESS_KEY = 'd93f56b2-3ee9-43e1-8cd5-14d2782ea282';
	const MODAL_CLOSE_MS = 560;
	let lockedScrollY = 0;
	let toastTimer: number | null = null;
	let modalCleanup: (() => void) | null = null;
	let closeTimer: number | null = null;

	function prefersReducedMotion() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function getModal() {
		return document.getElementById('contact-modal');
	}

	function getToast() {
		return document.getElementById('contact-toast');
	}

	function isModalOpen() {
		return getModal()?.classList.contains('is-open') ?? false;
	}

	function isModalBusy() {
		const modal = getModal();
		return !!modal && (modal.classList.contains('is-open') || modal.classList.contains('is-closing'));
	}

	function lockScroll() {
		lockedScrollY = window.scrollY;
		stopSmoothScroll();
		document.documentElement.classList.add('contact-modal-open');
		document.body.classList.add('contact-modal-open');
		document.body.style.position = 'fixed';
		document.body.style.top = `-${lockedScrollY}px`;
		document.body.style.left = '0';
		document.body.style.right = '0';
		document.body.style.width = '100%';
	}

	function unlockScroll() {
		if (!document.body.classList.contains('contact-modal-open')) return;

		document.documentElement.classList.remove('contact-modal-open');
		document.body.classList.remove('contact-modal-open');
		document.body.style.position = '';
		document.body.style.top = '';
		document.body.style.left = '';
		document.body.style.right = '';
		document.body.style.width = '';
		scrollToImmediate(lockedScrollY);
		startSmoothScroll();
		getLenis()?.resize();
		requestAnimationFrame(() => {
			scrollToImmediate(lockedScrollY);
			getLenis()?.resize();
		});
	}

	function closeMobileNavIfOpen() {
		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');
		if (!toggle || !panel) return;
		if (!panel.classList.contains('is-open') && !toggle.classList.contains('is-open')) return;
		toggle.click();
	}

	function showToast() {
		const toast = getToast();
		if (!toast) return;

		if (toastTimer != null) {
			window.clearTimeout(toastTimer);
			toastTimer = null;
		}

		toast.setAttribute('aria-hidden', 'false');
		toast.classList.remove('is-visible');
		void toast.offsetWidth;
		toast.classList.add('is-visible');

		toastTimer = window.setTimeout(() => {
			toast.classList.remove('is-visible');
			toast.setAttribute('aria-hidden', 'true');
			toastTimer = null;
		}, 3200);
	}

	function revealModal(modal: HTMLElement) {
		if (closeTimer != null) {
			window.clearTimeout(closeTimer);
			closeTimer = null;
		}

		lockScroll();
		modal.classList.remove('is-closing');
		modal.classList.add('is-open');
		modal.setAttribute('aria-hidden', 'false');
	}

	function openContactModal() {
		const modal = getModal();
		if (!modal || isModalBusy()) return;

		const navWasOpen = document.body.classList.contains('mobile-nav-open');
		closeMobileNavIfOpen();

		if (navWasOpen && !prefersReducedMotion()) {
			window.setTimeout(() => revealModal(modal), 420);
			return;
		}

		revealModal(modal);
	}

	function finishClose(modal: HTMLElement) {
		modal.classList.remove('is-closing', 'is-open');
		closeTimer = null;
		unlockScroll();
	}

	function closeContactModal() {
		const modal = getModal();
		if (!modal || !modal.classList.contains('is-open')) return;
		if (modal.classList.contains('is-closing')) return;

		modal.classList.remove('is-open');
		modal.classList.add('is-closing');
		modal.setAttribute('aria-hidden', 'true');

		const active = document.activeElement;
		if (active instanceof HTMLElement && modal.contains(active)) {
			active.blur();
		}

		if (prefersReducedMotion()) {
			finishClose(modal);
			return;
		}

		const sheet = modal.querySelector<HTMLElement>('[data-contact-sheet]');
		let settled = false;

		const settle = () => {
			if (settled) return;
			settled = true;
			sheet?.removeEventListener('transitionend', onEnd);
			finishClose(modal);
		};

		const onEnd = (event: TransitionEvent) => {
			if (event.target !== sheet || event.propertyName !== 'transform') return;
			settle();
		};

		sheet?.addEventListener('transitionend', onEnd);
		closeTimer = window.setTimeout(settle, MODAL_CLOSE_MS);
	}

	async function deliverMessage(payload: {
		firstName: string;
		secondName: string;
		contact: string;
		message: string;
	}) {
		const name = `${payload.firstName} ${payload.secondName}`.trim();
		const looksLikeEmail = payload.contact.includes('@');

		const body: Record<string, string> = {
			access_key: WEB3FORMS_ACCESS_KEY,
			subject: 'New inquiry from chrisbartosik.com',
			name,
			from_name: name,
			contact: payload.contact,
			message: payload.message,
		};

		if (looksLikeEmail) {
			body.email = payload.contact;
		}

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					Accept: 'application/json',
				},
				body: JSON.stringify(body),
			});
			const result = await response.json();
			if (!response.ok || !result?.success) {
				throw new Error(result?.message || 'delivery failed');
			}
		} catch (error) {
			console.warn('[contact-modal] delivery failed', error);
		}
	}

	function initSubmitMagnet(button: HTMLButtonElement, scope: HTMLElement) {
		const MAX_MOVE = 10;

		function onMove(event: MouseEvent) {
			if (window.matchMedia('(hover: none), (pointer: coarse)').matches) return;

			const rect = button.getBoundingClientRect();
			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;
			const moveX = Math.max(-MAX_MOVE, Math.min(MAX_MOVE, (event.clientX - centerX) * 0.075));
			const moveY = Math.max(-MAX_MOVE, Math.min(MAX_MOVE, (event.clientY - centerY) * 0.075));
			const isHovering =
				event.clientX >= rect.left &&
				event.clientX <= rect.right &&
				event.clientY >= rect.top &&
				event.clientY <= rect.bottom;

			button.classList.toggle('is-hovering', isHovering);
			const scale = isHovering ? 1.02 : 1;
			button.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) scale(${scale})`;
		}

		function onLeave() {
			button.classList.remove('is-hovering');
			button.style.transform = 'translate3d(0, 0, 0) scale(1)';
		}

		function onPressStart() {
			if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
			button.classList.add('is-hovering');
		}

		function onPressEnd() {
			if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
			button.classList.remove('is-hovering');
		}

		scope.addEventListener('mousemove', onMove, { passive: true });
		scope.addEventListener('mouseleave', onLeave, { passive: true });
		button.addEventListener('pointerdown', onPressStart);
		button.addEventListener('pointerup', onPressEnd);
		button.addEventListener('pointercancel', onPressEnd);
		button.addEventListener('pointerleave', onPressEnd);

		return () => {
			scope.removeEventListener('mousemove', onMove);
			scope.removeEventListener('mouseleave', onLeave);
			button.removeEventListener('pointerdown', onPressStart);
			button.removeEventListener('pointerup', onPressEnd);
			button.removeEventListener('pointercancel', onPressEnd);
			button.removeEventListener('pointerleave', onPressEnd);
		};
	}

	function initContactModal() {
		modalCleanup?.();
		modalCleanup = null;

		const modal = getModal();
		const form = document.getElementById('contact-modal-form') as HTMLFormElement | null;
		const submit = document.getElementById('contact-modal-submit') as HTMLButtonElement | null;
		const sheet = modal?.querySelector<HTMLElement>('[data-contact-sheet]');
		if (!modal || !form || !submit || !sheet) return;

		if (isModalBusy()) {
			const modalNode = getModal();
			if (modalNode) {
				modalNode.classList.remove('is-open', 'is-closing');
				modalNode.setAttribute('aria-hidden', 'true');
			}
			if (document.body.classList.contains('contact-modal-open')) {
				unlockScroll();
			}
		}

		const onTriggerClick = (event: MouseEvent) => {
			const target = event.target as HTMLElement | null;
			const trigger = target?.closest<HTMLElement>('[data-open-contact]');
			if (!trigger) return;
			event.preventDefault();
			event.stopPropagation();
			openContactModal();
		};

		const onCloseClick = (event: MouseEvent) => {
			const target = event.target as HTMLElement | null;
			if (!target?.closest('[data-contact-close]')) return;
			closeContactModal();
		};

		const onKeyDown = (event: KeyboardEvent) => {
			if (event.key === 'Escape' && isModalOpen()) {
				event.preventDefault();
				closeContactModal();
			}
		};

		const onSubmit = async (event: SubmitEvent) => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			const data = new FormData(form);
			const payload = {
				firstName: String(data.get('firstName') ?? '').trim(),
				secondName: String(data.get('secondName') ?? '').trim(),
				contact: String(data.get('contact') ?? '').trim(),
				message: String(data.get('message') ?? '').trim(),
			};

			submit.disabled = true;
			closeContactModal();
			showToast();
			form.reset();

			try {
				await deliverMessage(payload);
			} finally {
				submit.disabled = false;
				submit.classList.remove('is-hovering');
				submit.style.transform = '';
			}
		};

		const magnetCleanup = initSubmitMagnet(submit, sheet);

		document.addEventListener('click', onTriggerClick, true);
		modal.addEventListener('click', onCloseClick);
		window.addEventListener('keydown', onKeyDown);
		form.addEventListener('submit', onSubmit);

		modalCleanup = () => {
			document.removeEventListener('click', onTriggerClick, true);
			modal.removeEventListener('click', onCloseClick);
			window.removeEventListener('keydown', onKeyDown);
			form.removeEventListener('submit', onSubmit);
			magnetCleanup();
			if (isModalOpen()) closeContactModal();
		};
	}

	(window as Window & { __cbOpenContactModal?: () => void }).__cbOpenContactModal = openContactModal;

	initContactModal();
	document.addEventListener('astro:page-load', initContactModal);
</script>
