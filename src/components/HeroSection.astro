---
import { t } from '../utils/i18n.ts';
import { formatPanamaTimeLabel } from '../scripts/initHeroTime.ts';

const pillars = [
	{ key: 'hero.pillar1', label: t('hero.pillar1', 'en'), href: '/skills#product-ux-ui' },
	{ key: 'hero.pillar2', label: t('hero.pillar2', 'en'), href: '/skills#interactive-motion' },
	{ key: 'hero.pillar3', label: t('hero.pillar3', 'en'), href: '/skills#no-code-handoff' },
	{ key: 'hero.pillar4', label: t('hero.pillar4', 'en'), href: '/skills#generative-ai' },
];

const panamaTime = formatPanamaTimeLabel();
---

<section id="hero-section" class="hero-section relative">
	<div class="hero-bg" aria-hidden="true">
		<canvas id="hero-particles" class="pointer-events-none absolute inset-0 z-[1] h-full w-full" aria-hidden="true"></canvas>
		<canvas id="hero-sparks" class="pointer-events-none absolute inset-0 z-[2] h-full w-full" aria-hidden="true"></canvas>
	</div>

	<div class="hero-layout relative z-10">
		<div class="hero-screen">
			<div class="hero-cluster">
				<div
					class="hero-role hero-reveal-desc text-[0.78rem] font-medium uppercase tracking-[0.1em] text-white/70 md:text-[0.88rem] md:tracking-[0.16em]"
					data-text-streak
				>
					<div class="hero-role__base">
						<span data-i18n="hero.roleTitle">{t('hero.roleTitle', 'en')}</span>
					</div>
					<div class="hero-role__streak" data-text-streak-glow aria-hidden="true">
						<span data-i18n="hero.roleTitle">{t('hero.roleTitle', 'en')}</span>
					</div>
				</div>

				<div class="hero-copy">
					<div class="hero-copy-top flex min-w-0 flex-col">
						<h1 id="hero-headline" class="hero-headline uppercase text-setin-fg">
							<div class="hero-headline-desktop" data-hero-headline-desk>
								<div class="hero-reveal-mask hero-line1-mask">
									<span class="hero-reveal-line" data-i18n="hero.line1">{t('hero.line1', 'en')}</span>
								</div>
								<div class="hero-reveal-mask">
									<span class="hero-reveal-line">
										<span data-i18n="hero.line2Before">{t('hero.line2Before', 'en')}</span><span class="hero-glitch"><span class="hero-glitch__text" data-i18n="hero.line2Glitch">{t('hero.line2Glitch', 'en')}</span><canvas class="hero-glitch__canvas" aria-hidden="true"></canvas></span><span class="hero-line2-after" data-i18n="hero.line2After">{t('hero.line2After', 'en')}</span>
									</span>
								</div>
								<div class="hero-reveal-mask hero-line2-lead-mask">
									<span class="hero-reveal-line hero-line2-lead" data-i18n="hero.line2Lead">{t('hero.line2Lead', 'en')}</span>
								</div>
							</div>

							<div class="hero-headline-mobile" data-hero-headline-mob aria-hidden="true">
								<div class="hero-reveal-mask">
									<span class="hero-reveal-line" data-i18n="hero.mLine1">{t('hero.mLine1', 'en')}</span>
								</div>
								<div class="hero-reveal-mask">
									<span class="hero-reveal-line">
										<span data-i18n="hero.mLine2Before">{t('hero.mLine2Before', 'en')}</span><span class="hero-glitch"><span class="hero-glitch__text" data-i18n="hero.mLine2Glitch">{t('hero.mLine2Glitch', 'en')}</span><canvas class="hero-glitch__canvas" aria-hidden="true"></canvas></span><span data-i18n="hero.mLine2After">{t('hero.mLine2After', 'en')}</span>
									</span>
								</div>
								<div class="hero-reveal-mask">
									<span class="hero-reveal-line">
										<span data-i18n="hero.mLine3Before">{t('hero.mLine3Before', 'en')}</span><span class="hero-glitch"><span class="hero-glitch__text" data-i18n="hero.mLine3Glitch">{t('hero.mLine3Glitch', 'en')}</span><canvas class="hero-glitch__canvas" aria-hidden="true"></canvas></span><span data-i18n="hero.mLine3After">{t('hero.mLine3After', 'en')}</span>
									</span>
								</div>
							</div>
						</h1>
					</div>

					<div class="hero-copy-bottom flex min-w-0 flex-col">
						<div class="hero-description" data-text-streak>
							<div class="hero-description__base" data-hero-description>
								<span class="hero-description__desktop" data-i18n="hero.description">
									{t('hero.description', 'en')}
								</span>
								<span class="hero-description__mobile" aria-hidden="true">
									<span data-i18n="hero.descriptionLine1">{t('hero.descriptionLine1', 'en')}</span>
									<br />
									<span data-i18n="hero.descriptionLine2">{t('hero.descriptionLine2', 'en')}</span>
									<br />
									<span data-i18n="hero.descriptionLine3">{t('hero.descriptionLine3', 'en')}</span>
								</span>
							</div>
							<div class="hero-description__streak" data-text-streak-glow aria-hidden="true"></div>
						</div>

						<div class="hero-actions">
							<div class="hero-reveal-mask hero-cta-mask">
								<div class="hero-reveal-desc">
									<a href="/projects" class="hero-cta hero-cta--primary">
										<span data-i18n="hero.viewWork">{t('hero.viewWork', 'en')}</span>
										<img src="/icons/arrow.svg" alt="" width="18" height="15" class="hero-cta__arrow" aria-hidden="true" />
									</a>
								</div>
							</div>
							<div class="hero-reveal-mask hero-cta-mask">
								<div class="hero-reveal-desc">
									<a href="/about" class="hero-cta hero-cta--secondary">
										<span data-i18n="hero.aboutMe">{t('hero.aboutMe', 'en')}</span>
										<img src="/icons/arrow.svg" alt="" width="18" height="15" class="hero-cta__arrow" aria-hidden="true" />
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div
				class="hero-badge hero-reveal-desc text-[0.78rem] font-medium uppercase tracking-[0.16em] text-white/70 md:text-[0.88rem]"
				data-text-streak
			>
				<div class="hero-badge__base flex items-center gap-x-3">
					<span class="hero-badge__place inline-flex items-center gap-x-1">
						<span data-i18n="hero.badgeLocation">{t('hero.badgeLocation', 'en')}</span>
						<span data-hero-time>{panamaTime}</span>
					</span>
					<span class="text-white/35" aria-hidden="true">/</span>
					<span data-i18n="hero.badgeAvailability">{t('hero.badgeAvailability', 'en')}</span>
				</div>
				<div
					class="hero-badge__streak flex items-center gap-x-3"
					data-text-streak-glow
					aria-hidden="true"
				>
					<span class="hero-badge__place inline-flex items-center gap-x-1">
						<span data-i18n="hero.badgeLocation">{t('hero.badgeLocation', 'en')}</span>
						<span data-hero-time>{panamaTime}</span>
					</span>
					<span aria-hidden="true">/</span>
					<span data-i18n="hero.badgeAvailability">{t('hero.badgeAvailability', 'en')}</span>
				</div>
			</div>
		</div>

		<div class="hero-skills-col">
			<ul class="hero-pillars flex flex-col" role="list">
				{
					pillars.map((pillar) => (
						<li>
							<div class="hero-reveal-mask hero-pillar-mask">
								<div class="hero-reveal-desc">
									<a href={pillar.href} class="hero-pillar group w-full text-left">
										<span class="hero-pillar__label" data-i18n={pillar.key}>{pillar.label}</span>
										<img
											src="/icons/arrow.svg"
											alt=""
											width="18"
											height="15"
											class="hero-pillar__arrow"
											aria-hidden="true"
										/>
									</a>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style is:global>
	.hero-section {
		background-color: #131415;
		min-height: 90vh;
		min-height: 90svh;
		overflow-anchor: none;
	}

	.hero-bg {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 0;
		width: 100%;
		/* 100lvh covers the tallest mobile viewport so collapsing chrome
		   doesn't briefly expose the bottom edge of the particle field. */
		height: 100%;
		height: 100lvh;
		min-height: 100%;
		pointer-events: none;
		overflow: hidden;
		clip-path: inset(0);
	}

	.hero-layout {
		display: grid;
		position: relative;
		z-index: 1;
		min-height: 90vh;
		min-height: 90svh;
		box-sizing: border-box;
		grid-template-columns: 1fr;
		grid-template-areas:
			'screen'
			'skills';
		padding: calc(1.25rem + 72px) var(--page-gutter) var(--page-gutter);
		row-gap: 1.75rem;
		column-gap: 1.75rem;
		align-content: center;
	}

	.hero-screen {
		grid-area: screen;
		display: flex;
		flex-direction: column;
		min-width: 0;
		row-gap: inherit;
	}

	.hero-cluster {
		display: flex;
		min-width: 0;
		flex-direction: column;
		row-gap: inherit;
	}

	.hero-role {
		min-width: 0;
		text-align: left;
	}

	.hero-badge {
		min-width: 0;
		text-align: left;
		white-space: nowrap;
	}

	.hero-badge__base,
	.hero-badge__streak {
		flex-wrap: nowrap;
		justify-content: flex-start;
		white-space: nowrap;
	}

	.hero-badge__place {
		white-space: nowrap;
	}

	.hero-copy {
		display: flex;
		min-width: 0;
		width: 100%;
		flex-direction: column;
	}

	.hero-copy-top {
		min-width: 0;
		width: 100%;
		max-width: 100%;
	}

	.hero-badge,
	.hero-role {
		position: relative;
		isolation: isolate;
	}

	.hero-badge__streak,
	.hero-role__streak,
	.hero-description__streak {
		position: absolute;
		inset: 0;
		color: #ffffff;
		pointer-events: none;
		opacity: 0;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
	}

	.hero-role__base {
		position: relative;
	}

	.hero-copy-bottom {
		min-width: 0;
		width: 100%;
		gap: 1.25rem;
	}

	.hero-skills-col {
		grid-area: skills;
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-end;
		gap: 1.5rem;
	}

	.hero-headline {
		position: relative;
		width: 100%;
		font-size: 2.8rem;
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.03em;
		max-width: 100%;
		isolation: isolate;
		contain: layout style;
	}

	.hero-headline-mobile {
		display: none;
	}

	.hero-headline__hover-glitch {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 3;
		overflow: hidden;
		contain: strict;
		transform: translateZ(0);
	}

	.hero-reveal-mask {
		display: block;
		overflow: visible;
		padding-top: 0.08em;
		padding-right: 0.2em;
	}

	.hero-reveal-line {
		display: block;
		white-space: nowrap;
	}

	.hero-glitch:has(.hero-glitch__text:empty) {
		display: none;
	}

	.hero-headline-mobile .hero-reveal-mask:has([data-i18n='hero.mLine3Before']:empty):has(
			[data-i18n='hero.mLine3Glitch']:empty
		):has([data-i18n='hero.mLine3After']:empty) {
		display: none;
	}

	.hero-reveal-mask:has(.hero-line2-lead:empty),
	.hero-line1-mask:has([data-i18n='hero.line1']:empty) {
		display: none;
	}

	.hero-glitch {
		position: relative;
		display: inline;
		vertical-align: baseline;
		padding-right: 0.12em;
		margin-right: -0.04em;
	}

	.hero-glitch.is-glitching .hero-glitch__text {
		color: transparent;
	}

	.hero-glitch__canvas {
		position: absolute;
		left: 0;
		top: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-glitch.is-glitching .hero-glitch__text {
			color: inherit;
		}

		.hero-glitch__canvas {
			display: none;
		}

		.hero-cta,
		.hero-cta:hover,
		.hero-cta:focus-visible,
		.hero-cta.is-tilting {
			transform: none;
		}
	}

	.hero-description {
		position: relative;
		isolation: isolate;
		width: 100%;
		max-width: 28rem;
		font-size: 1.1rem;
		font-weight: 500;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.68);
	}

	.hero-description__base {
		position: relative;
		width: 100%;
	}

	.hero-description__mobile {
		display: none;
	}

	.hero-description__streak {
		font-size: inherit;
		font-weight: inherit;
		line-height: inherit;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 1.35rem;
		margin-top: 0;
		perspective: 760px;
	}

	.hero-cta-mask .hero-cta {
		width: 100%;
	}

	.hero-cta {
		--rx: 0deg;
		--ry: 0deg;
		--rz: 0deg;
		--mx: 50%;
		--my: 50%;
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		padding: 0.95rem 1.35rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		transform-style: preserve-3d;
		transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz)) translateZ(0);
		transition:
			transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			background-color 0.3s ease,
			box-shadow 0.3s ease;
		will-change: transform;
	}

	.hero-cta::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.25s ease;
		background: radial-gradient(
			140px circle at var(--mx) var(--my),
			rgba(255, 255, 255, 0.28),
			transparent 58%
		);
	}

	.hero-cta > * {
		position: relative;
		z-index: 1;
	}

	.hero-cta--primary {
		background-color: #f54100;
		color: #ffffff;
	}

	.hero-cta--secondary {
		background-color: #ffffff;
		color: #111111;
	}

	.hero-cta--secondary::before {
		background: radial-gradient(
			140px circle at var(--mx) var(--my),
			rgba(0, 0, 0, 0.06),
			rgba(0, 0, 0, 0.14) 62%
		);
	}

	.hero-cta__arrow {
		display: block;
		width: 14px;
		height: auto;
		flex-shrink: 0;
		transform: rotate(-45deg);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-cta--secondary .hero-cta__arrow {
		filter: brightness(0);
	}

	.hero-cta:hover,
	.hero-cta:focus-visible,
	.hero-cta.is-tilting {
		transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz)) translateZ(14px) scale(1.03);
	}

	.hero-cta.is-tilting {
		z-index: 2;
		transition:
			transform 0.08s ease-out,
			background-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.hero-cta--primary:hover,
	.hero-cta--primary:focus-visible {
		background-color: #c73400;
		box-shadow: 0 16px 28px rgba(197, 52, 0, 0.32);
	}

	.hero-cta--secondary:hover,
	.hero-cta--secondary:focus-visible {
		background-color: #d8d8d8;
		box-shadow: 0 16px 28px rgba(0, 0, 0, 0.22);
	}

	.hero-cta:hover::before,
	.hero-cta:focus-visible::before,
	.hero-cta.is-tilting::before {
		opacity: 1;
	}

	.hero-cta:hover .hero-cta__arrow,
	.hero-cta:focus-visible .hero-cta__arrow {
		transform: rotate(0deg);
	}

	.hero-pillars {
		width: 100%;
	}

	.hero-pillars li .hero-pillar {
		border-bottom: 1px solid rgba(255, 255, 255, 0.68);
	}

	.hero-pillars li:first-child .hero-pillar {
		border-top: 1px solid rgba(255, 255, 255, 0.68);
	}

	.hero-pillar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: 1.4rem 0;
		color: rgba(255, 255, 255, 0.68);
		text-decoration: none;
		background-color: transparent;
		transition:
			color 0.16s ease,
			background-color 0.16s ease;
	}

	.hero-pillar__arrow {
		display: block;
		width: 16px;
		height: auto;
		flex-shrink: 0;
		opacity: 0.68;
		transition:
			opacity 0.3s ease,
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-pillar__label {
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-pillar:hover,
	.hero-pillar:focus-visible {
		color: #ffffff;
		background-color: rgba(255, 255, 255, 0.1);
	}

	.hero-pillar:hover .hero-pillar__label,
	.hero-pillar:focus-visible .hero-pillar__label {
		transform: translateX(10px);
	}

	.hero-pillar:hover .hero-pillar__arrow,
	.hero-pillar:focus-visible .hero-pillar__arrow {
		opacity: 1;
		transform: translateX(-10px);
	}

	@media (max-width: 767px) {
		.hero-section {
			min-height: auto;
		}

		.hero-layout {
			min-height: auto;
			padding-top: 80px;
			padding-bottom: 60px;
			row-gap: 0rem;
			column-gap: 1.25rem;
			align-content: start;
		}

		.hero-screen {
			box-sizing: border-box;
			min-height: calc(100svh - 80px);
			justify-content: flex-start;
			padding-bottom: 1.25rem;
			row-gap: 0;
		}

		.hero-cluster {
			margin-top: auto;
			margin-bottom: auto;
			align-items: center;
			row-gap: 1.25rem;
			width: 100%;
			max-width: 100%;
			min-width: 0;
		}

		.hero-role,
		.hero-badge,
		.hero-copy-top,
		.hero-copy-bottom,
		.hero-description {
			text-align: center;
		}

		.hero-role {
			margin-bottom: 0;
		}

		.hero-role__base,
		.hero-role__streak {
			text-wrap: balance;
		}

		.hero-badge {
			flex-shrink: 0;
			width: 100%;
			margin-top: 0;
			padding-top: 0.5rem;
			padding-bottom: 2em;
		}

		.hero-badge__base,
		.hero-badge__streak {
			justify-content: center;
			flex-wrap: nowrap;
			white-space: nowrap;
		}

		.hero-copy {
			align-items: center;
			width: 100%;
			gap: 1.25rem;
		}

		.hero-copy-bottom {
			gap: 1.25rem;
		}

		.hero-copy-top,
		.hero-copy-bottom {
			align-items: center;
			width: 100%;
		}

		.hero-headline {
			font-size: 2rem;
			width: 100%;
			text-align: center;
		}

		.hero-headline-desktop {
			display: none;
		}

		.hero-headline-mobile {
			display: block;
		}

		.hero-description {
			width: 100%;
			max-width: 100%;
			margin-inline: auto;
			font-size: 1rem;
			line-height: 1.5;
		}

		.hero-description__base {
			width: 100%;
		}

		.hero-description__desktop {
			display: none;
		}

		.hero-description__mobile {
			display: inline;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			max-width: 22rem;
			margin-inline: auto;
			gap: 0.8rem;
			margin-top: 0;
		}

		.hero-cta-mask {
			width: 100%;
		}

		.hero-cta {
			width: 100%;
			padding: 1.15rem 1.4rem;
			font-size: 0.78rem;
			gap: 0.85rem;
		}

		.hero-cta__arrow {
			width: 16px;
		}

		.hero-skills-col {
			margin-top: 0.75rem;
			padding-bottom: 0;
		}

		.hero-pillar,
		.hero-pillar:hover,
		.hero-pillar:focus,
		.hero-pillar:focus-visible,
		.hero-pillar:active {
			padding: 1.05rem 0;
			gap: 0.85rem;
			color: #ffffff;
			background-color: transparent;
			-webkit-tap-highlight-color: transparent;
		}

		.hero-pillars li .hero-pillar,
		.hero-pillars li:first-child .hero-pillar {
