---
import { t } from '../utils/i18n.ts';
import { formatPanamaTimeLabel } from '../scripts/initHeroTime.ts';

const pillars = [
	{ key: 'hero.pillar1', label: t('hero.pillar1', 'en'), href: '/skills#product-ux-ui' },
	{ key: 'hero.pillar2', label: t('hero.pillar2', 'en'), href: '/skills#interactive-motion' },
	{ key: 'hero.pillar3', label: t('hero.pillar3', 'en'), href: '/skills#no-code-handoff' },
	{ key: 'hero.pillar4', label: t('hero.pillar4', 'en'), href: '/skills#generative-ai' },
];

const panamaTime = formatPanamaTimeLabel();
---

<section
	id="hero-section"
	class="hero-section"
>
	<div class="hero-bg" aria-hidden="true">
		<canvas id="hero-sparks" class="pointer-events-none absolute inset-0 z-[1] h-full w-full" aria-hidden="true"
		></canvas>
	</div>

	<div class="hero-layout relative z-10">
		<div class="hero-stage" data-hero-stage>
			<div class="hero-main">
				<div class="hero-badge text-[0.78rem] font-medium uppercase tracking-[0.16em] text-black/45 md:text-[0.88rem]" data-hero-follow-item>
					<span class="inline-flex items-center gap-x-3">
						<span class="inline-flex items-center gap-x-1">
							<span data-i18n="hero.badgeLocation">{t('hero.badgeLocation', 'en')}</span>
							<span data-hero-time>{panamaTime}</span>
						</span>
						<span aria-hidden="true">/</span>
						<span data-i18n="hero.badgeAvailability">{t('hero.badgeAvailability', 'en')}</span>
					</span>
				</div>

				<div class="hero-headline-wrap" data-hero-headline-wrap>
					<div class="hero-headline-slot" data-hero-headline-slot>
						<h1 id="hero-headline" class="hero-headline uppercase text-black">
							<span class="hero-line hero-line--intro" data-hero-line-intro>
								<span class="hero-intro-line hero-intro-line--greeting" data-hero-intro-group="greeting">
									<span class="hero-greeting-group" data-hero-greeting-group>
										<span class="hero-greeting" data-i18n="hero.greeting">{t('hero.greeting', 'en')}</span>
										<span class="hero-hand" data-hero-hand aria-hidden="true">
											<img src="/chris-hand-logo.svg" alt="" width="52" height="55" />
										</span>
										<span class="hero-comma">,</span>
									</span>
								</span>
								<span class="hero-intro-line hero-intro-line--name" data-hero-intro-group="name">
									<span class="hero-name-group" data-hero-name-group>
										<span class="hero-role-word hero-intro-before" data-i18n="hero.introBefore">{t('hero.introBefore', 'en')}</span>
										<span class="hero-photo" data-hero-photo>
											<span class="hero-photo__tilt" data-hero-photo-tilt>
												<img src="/hedline_photo.webp" alt="" width="72" height="72" loading="eager" decoding="async" />
											</span>
										</span>
										<span class="hero-role-word hero-intro-after" data-i18n="hero.introAfter">{t('hero.introAfter', 'en')}</span>
									</span>
								</span>
							</span>

							<span class="hero-line hero-line--role" data-hero-line-role>
								<span class="hero-intro-line hero-intro-line--role-a" data-hero-intro-group="role-a">
									<span class="hero-role-word hero-glitch">
										<span class="hero-glitch__text" data-i18n="hero.roleWord1">{t('hero.roleWord1', 'en')}</span>
									</span>
									<span class="hero-role-word" data-i18n="hero.roleWord2">{t('hero.roleWord2', 'en')}</span>
								</span>
								<span class="hero-intro-line hero-intro-line--role-b" data-hero-intro-group="role-b">
									<span class="hero-role-word" data-i18n="hero.roleWord3">{t('hero.roleWord3', 'en')}</span>
								</span>
							</span>
						</h1>
					</div>
				</div>
			</div>

			<div class="hero-bottom">
				<div class="hero-actions-wrap">
					<p class="hero-specialization" data-hero-follow-item data-i18n="hero.specialization">
						{t('hero.specialization', 'en')}
					</p>
					<div class="hero-actions">
					<a href="/about" class="hero-cta hero-cta--primary" data-hero-follow-item>
						<span class="hero-cta__label-wrap">
							<span class="hero-cta__roll-inner">
								<span class="hero-cta__label-line">
									<span data-i18n="hero.aboutMe">{t('hero.aboutMe', 'en')}</span>
								</span>
								<span class="hero-cta__label-line" aria-hidden="true">
									<span data-i18n="hero.aboutMe">{t('hero.aboutMe', 'en')}</span>
								</span>
							</span>
						</span>
						<img src="/icons/arrow.svg" alt="" width="18" height="15" class="hero-cta__arrow" aria-hidden="true" />
					</a>
					<a href="/projects" class="hero-cta hero-cta--secondary" data-hero-follow-item>
						<span class="hero-cta__label-wrap">
							<span class="hero-cta__roll-inner">
								<span class="hero-cta__label-line">
									<span data-i18n="hero.viewWork">{t('hero.viewWork', 'en')}</span>
								</span>
								<span class="hero-cta__label-line" aria-hidden="true">
									<span data-i18n="hero.viewWork">{t('hero.viewWork', 'en')}</span>
								</span>
							</span>
						</span>
						<img src="/icons/arrow.svg" alt="" width="18" height="15" class="hero-cta__arrow" aria-hidden="true" />
					</a>
				</div>
				</div>

				<ul class="hero-pillars flex flex-col" role="list">
					{
						pillars.map((pillar) => (
							<li>
								<a href={pillar.href} class="hero-pillar group w-full text-left" data-hero-follow-item>
									<span class="hero-pillar__label-wrap">
										<span class="hero-pillar__roll-inner">
											<span class="hero-pillar__label-line">
												<span data-i18n={pillar.key}>{pillar.label}</span>
											</span>
											<span class="hero-pillar__label-line" aria-hidden="true">
												<span data-i18n={pillar.key}>{pillar.label}</span>
											</span>
										</span>
									</span>
									<img
										src="/icons/arrow.svg"
										alt=""
										width="18"
										height="15"
										class="hero-pillar__arrow"
										aria-hidden="true"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style is:global>
	.hero-section {
		position: relative;
		background-color: #ffffff;
		color: #000000;
		--hero-height: 120vh;
		--hero-pin-height: 100vh;
		min-height: var(--hero-height);
		--hero-duration: 600ms;
		--hero-ease: cubic-bezier(0.22, 1, 0.36, 1);
		--hero-stagger: 180ms;
		--hero-photo-duration: 600ms;
		--hero-hand-size: 0.85em;
		--hero-photo-size: 1.15em;
		--hero-photo-height: 1.28em;
		--hero-headline-gap: 0.15em;
		--hero-stage-gap: 4.25rem;
		--hero-badge-headline-gap: 3rem;
		--hero-headline-bottom-gap: 2.5rem;
		--hero-layout-padding-top: 120px;
		--hero-inline-icon-offset: -0.1em;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.hero-layout {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		height: var(--hero-pin-height);
		min-height: var(--hero-pin-height);
		box-sizing: border-box;
		padding: var(--hero-layout-padding-top) var(--page-gutter) 2.5rem;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	[data-hero-follow-item] {
		opacity: 0;
		transform: translateY(110%);
		visibility: hidden;
		pointer-events: none;
		transition:
			transform var(--hero-duration) var(--hero-ease),
			opacity var(--hero-duration) var(--hero-ease),
			visibility 0s linear var(--hero-duration);
	}

	[data-hero-follow-item].is-visible,
	.hero-section.is-hero-follow-complete [data-hero-follow-item] {
		opacity: 1;
		transform: translateY(0);
		visibility: visible;
		pointer-events: auto;
		transition:
			transform var(--hero-duration) var(--hero-ease),
			opacity var(--hero-duration) var(--hero-ease),
			visibility 0s;
	}

	.hero-stage {
		position: relative;
		display: flex;
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		flex-direction: column;
		align-items: center;
		gap: var(--hero-stage-gap);
	}

	.hero-headline-slot {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		flex-shrink: 0;
		font-size: clamp(2.25rem, 6.5vw, 5.25rem);
		line-height: 1.05;
	}

	.hero-headline-slot .hero-headline {
		line-height: 1.05;
	}

	.hero-main {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: var(--hero-badge-headline-gap);
	}

	.hero-badge {
		width: 100%;
		text-align: center;
	}

	.hero-headline-wrap {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	.hero-bottom {
		--hero-col-width: 22rem;
		--hero-bottom-gap: 3rem;
		--hero-row-padding-y: 1.2rem;
		--hero-row-font-size: 0.95rem;
		--hero-row-letter-spacing: 0.08em;
		--hero-row-font-weight: 600;
		--hero-row-arrow-size: 16px;
		display: grid;
		width: 100%;
		max-width: var(--hero-col-width);
		margin-inline: auto;
		margin-top: calc(var(--hero-headline-bottom-gap) - var(--hero-stage-gap));
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.hero-headline {
		position: relative;
		margin: 0;
		width: 100%;
		max-width: 100%;
		font-size: inherit;
		font-weight: 700;
		line-height: inherit;
		letter-spacing: -0.03em;
		text-align: center;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}

	.hero-section.is-hero-intro-resetting [data-hero-intro-group],
	.hero-section.is-hero-intro-resetting [data-hero-follow-item],
	.hero-section.is-hero-intro-resetting .hero-photo,
	.hero-section.is-hero-intro-resetting .hero-photo__tilt {
		transition: none !important;
	}

	.hero-line {
		display: block;
	}

	.hero-line--intro {
		display: flex;
		width: 100%;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: center;
		gap: var(--hero-headline-gap);
	}

	.hero-intro-line {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--hero-headline-gap);
	}

	.hero-greeting-group {
		display: inline-flex;
		align-items: center;
		gap: var(--hero-headline-gap);
	}

	.hero-hand {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		top: var(--hero-inline-icon-offset);
		width: var(--hero-hand-size);
		height: var(--hero-hand-size);
		transform-origin: 50% 100%;
	}

	.hero-hand img {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero-name-group {
		display: inline-flex;
		align-items: center;
		gap: var(--hero-headline-gap);
		white-space: nowrap;
	}

	.hero-photo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		top: var(--hero-inline-icon-offset);
		width: var(--hero-photo-size);
		max-width: 0;
		height: var(--hero-photo-height);
		overflow: hidden;
		flex: 0 0 auto;
		opacity: 0;
		transition:
			max-width var(--hero-photo-duration) var(--hero-ease),
			opacity calc(var(--hero-photo-duration) * 0.6) var(--hero-ease);
	}

	.hero-photo.is-photo-visible,
	.hero-section.is-hero-intro-complete .hero-photo {
		max-width: var(--hero-photo-size);
		opacity: 1;
		overflow: visible;
		padding-block: 0.2em;
		margin-block: -0.2em;
	}

	.hero-photo__tilt {
		display: inline-flex;
		transform: scaleX(0);
		transform-origin: center center;
		transform-style: preserve-3d;
		perspective: 700px;
		transition: transform var(--hero-photo-duration) var(--hero-ease);
	}

	.hero-photo.is-photo-visible .hero-photo__tilt,
	.hero-section.is-hero-intro-complete .hero-photo .hero-photo__tilt {
		transform: scaleX(1);
	}

	.hero-photo img {
		display: block;
		width: var(--hero-photo-size);
		min-width: var(--hero-photo-size);
		height: var(--hero-photo-height);
		object-fit: contain;
		object-position: center center;
		filter: grayscale(1);
		will-change: transform;
		transform-style: preserve-3d;
	}

	.hero-glitch {
		position: relative;
		display: inline-block;
	}

	.hero-glitch__text {
		position: relative;
		z-index: 0;
	}

	.hero-glitch__canvas {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		pointer-events: none;
	}

	.hero-line--role {
		margin-top: 0.2em;
		display: flex;
		width: 100%;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: center;
		gap: var(--hero-headline-gap);
		min-height: 1.05em;
	}

	[data-hero-intro-group] {
		opacity: 0;
		transform: translateY(110%);
		transition:
			transform var(--hero-duration) var(--hero-ease),
			opacity var(--hero-duration) var(--hero-ease);
	}

	[data-hero-intro-group].is-visible,
	.hero-section.is-hero-intro-complete [data-hero-intro-group] {
		opacity: 1;
		transform: translateY(0);
	}

	.hero-hand.is-waving {
		animation: hero-hand-wave 0.95s cubic-bezier(0.45, 0, 0.2, 1) 0.12s 1;
	}

	@keyframes hero-hand-wave {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}
		18% {
			transform: translateY(0) rotate(18deg);
		}
		38% {
			transform: translateY(0) rotate(-10deg);
		}
		58% {
			transform: translateY(0) rotate(14deg);
		}
		78% {
			transform: translateY(0) rotate(-6deg);
		}
	}

	.hero-actions-wrap {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
		min-width: 0;
	}

	.hero-specialization {
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: 400;
		line-height: var(--body-text-lh);
		color: rgba(0, 0, 0, 0.5);
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.8rem;
		width: 100%;
		min-width: 0;
	}

	.hero-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		box-sizing: border-box;
		width: 100%;
		padding: var(--hero-row-padding-y) 1.35rem;
		font-size: var(--hero-row-font-size);
		font-weight: var(--hero-row-font-weight);
		letter-spacing: var(--hero-row-letter-spacing);
		line-height: 1.3;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.25s ease,
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-cta--primary {
		background-color: #f54100;
		color: #ffffff;
	}

	.hero-cta--secondary {
		background-color: #000000;
		color: #ffffff;
	}

	.hero-cta__label-wrap {
		display: block;
		min-width: 0;
		height: 1.3em;
		overflow: hidden;
		font-size: inherit;
		line-height: 1.3;
	}

	.hero-cta__roll-inner {
		display: flex;
		flex-direction: column;
		transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.hero-cta__label-line {
		display: flex;
		align-items: center;
		height: 1.3em;
		line-height: 1.3;
		white-space: nowrap;
	}

	.hero-cta__arrow {
		display: block;
		width: var(--hero-row-arrow-size);
		height: auto;
		flex-shrink: 0;
		margin-left: 1.5rem;
		transform: rotate(-45deg);
		filter: brightness(0) invert(1);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-cta:hover,
		.hero-cta:focus-visible {
			transform: scale(1.03);
		}

		.hero-cta--primary:hover,
		.hero-cta--primary:focus-visible {
			background-color: #c73400;
		}

		.hero-cta--secondary:hover,
		.hero-cta--secondary:focus-visible {
			background-color: #222222;
		}

		.hero-cta:hover .hero-cta__roll-inner,
		.hero-cta:focus-visible .hero-cta__roll-inner {
			transform: translateY(-50%);
		}

		.hero-cta:hover .hero-cta__arrow,
		.hero-cta:focus-visible .hero-cta__arrow {
			transform: translateX(-10px) rotate(0deg);
		}

		.hero-pillar:hover .hero-pillar__roll-inner,
		.hero-pillar:focus-visible .hero-pillar__roll-inner {
			transform: translateY(-50%);
		}

		.hero-pillar:hover,
		.hero-pillar:focus-visible {
			color: #000000;
			background-color: rgba(0, 0, 0, 0.04);
		}

		.hero-pillar:hover .hero-pillar__arrow,
		.hero-pillar:focus-visible .hero-pillar__arrow {
			opacity: 1;
			transform: translateX(-10px);
		}
	}

	.hero-pillars {
		width: 100%;
		min-width: 0;
	}

	.hero-pillars li .hero-pillar {
		border-bottom: 1px solid rgba(0, 0, 0, 0.18);
	}

	.hero-pillars li:first-child .hero-pillar {
		border-top: 1px solid rgba(0, 0, 0, 0.18);
	}

	.hero-pillar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: var(--hero-row-padding-y) 0;
		color: rgba(0, 0, 0, 0.68);
		font-size: var(--hero-row-font-size);
		line-height: 1.3;
		text-decoration: none;
		transition:
			color 0.16s ease,
			background-color 0.16s ease;
	}

	.hero-pillar__arrow {
		display: block;
		width: var(--hero-row-arrow-size);
		height: auto;
		flex-shrink: 0;
		opacity: 0.68;
		filter: brightness(0);
		transition:
			opacity 0.3s ease,
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-pillar__label-wrap {
		display: block;
		min-width: 0;
		flex: 1 1 auto;
		height: 1.3em;
		overflow: hidden;
		font-size: inherit;
		line-height: 1.3;
	}

	.hero-pillar__roll-inner {
		display: flex;
		flex-direction: column;
		transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.hero-pillar__label-line {
		display: flex;
		align-items: center;
		height: 1.3em;
		font-size: var(--hero-row-font-size);
		font-weight: var(--hero-row-font-weight);
		letter-spacing: var(--hero-row-letter-spacing);
		line-height: 1.3;
		text-transform: uppercase;
		white-space: nowrap;
	}

	@media (min-width: 1024px) {
		.hero-bottom {
			--hero-col-width: calc(22rem + 60px);
			--hero-bottom-gap: 3rem;
			grid-template-columns: var(--hero-col-width) var(--hero-col-width);
			width: calc(var(--hero-col-width) * 2 + var(--hero-bottom-gap));
			max-width: min(100%, calc(var(--hero-col-width) * 2 + var(--hero-bottom-gap)));
			margin-inline: auto;
			justify-content: center;
			column-gap: var(--hero-bottom-gap);
			row-gap: 1.25rem;
		}

		.hero-actions-wrap,
		.hero-actions,
		.hero-pillars {
			width: 100%;
			max-width: none;
		}
	}

	@media (max-width: 767px) {
		.hero-section {
			--hero-height: 100svh;
			--hero-pin-height: 100svh;
			--hero-headline-bottom-gap: 1.25rem;
			--hero-layout-padding-top: 90px;
			--hero-headline-line-height: 1.08;
			--hero-headline-line-gap: 0.03em;
			--hero-photo-size: 1.22em;
			--hero-photo-height: 1.32em;
			min-height: 100svh;
			overflow: hidden;
		}

		.hero-headline-slot,
		.hero-headline-slot .hero-headline {
			line-height: var(--hero-headline-line-height);
		}

		.hero-headline-slot {
			font-size: clamp(1.5rem, 8vw, 2.75rem);
		}

		.hero-headline {
			display: flex;
