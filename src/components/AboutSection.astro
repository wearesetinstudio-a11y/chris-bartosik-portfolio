---
import WorkWithUsButton from './WorkWithUsButton.astro';
import { t } from '../utils/i18n.ts';
---

<section id="about" class="about-section relative z-20 bg-[#131415]">
	<div class="about-layout">
		<div class="about-sticky">
			<p id="about-kicker" class="about-kicker">
				<span data-i18n="about.kickerBefore">{t('about.kickerBefore', 'en')}</span>
				<span class="about-kicker__photo" aria-hidden="true">
					<img
						src="/chris.webp"
						alt=""
						width="160"
						height="160"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span data-i18n="about.kickerAfter">{t('about.kickerAfter', 'en')}</span>
			</p>
		</div>

		<div class="about-copy">
			<h2 id="about-heading" class="about-content__heading uppercase">
				<span data-reveal-line data-i18n="about.heading">{t('about.heading', 'en')}</span>
			</h2>

			<div class="about-content__body">
				<p data-i18n="about.body1">{t('about.body1', 'en')}</p>
				<p data-i18n="about.body2">{t('about.body2', 'en')}</p>
			</div>

			<div class="about-copy__cta">
				<WorkWithUsButton href="/about" label={t('about.readMore', 'en')} i18nKey="about.readMore" />
			</div>
		</div>
	</div>
</section>

<style is:global>
	.about-section {
		padding: var(--section-padding-y) var(--page-gutter);
	}

	.about-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}

	.about-sticky {
		align-self: start;
	}

	.about-kicker {
		--about-photo: 0;
		display: flex;
		align-items: center;
		margin: 0;
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #ffffff;
		white-space: nowrap;
	}

	.about-kicker__photo {
		display: block;
		width: calc(var(--about-photo) * 6rem);
		height: 6rem;
		margin-inline: calc(var(--about-photo) * 0.85rem);
		overflow: hidden;
		opacity: var(--about-photo);
		flex-shrink: 0;
		will-change: width, margin, opacity;
	}

	.about-kicker__photo img {
		display: block;
		width: 6rem;
		height: 6rem;
		object-fit: cover;
		object-position: center 18%;
		filter: grayscale(1);
	}

	.about-copy {
		display: flex;
		flex-direction: column;
		min-width: 0;
		max-width: 38rem;
	}

	.about-content__heading {
		font-size: 1.4rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: var(--letter-spacing-ui);
		color: #ffffff;
	}

	#about-heading .reveal-char {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	#about-heading .reveal-char.active {
		color: rgba(255, 255, 255, 1);
	}

	.about-content__body {
		display: flex;
		flex-direction: column;
		gap: 1.35rem;
		margin-top: 2rem;
		color: rgba(255, 255, 255, 0.78);
	}

	.about-content__body,
	.about-content__body p {
		font-size: var(--body-text-size);
		font-weight: 400;
		line-height: var(--body-text-lh);
		letter-spacing: 0;
	}

	.about-copy__cta {
		margin-top: 2.75rem;
	}

	@media (min-width: 768px) {
		.about-layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			gap: 4rem;
		}

		.about-sticky {
			position: sticky;
			top: calc(100px + 1.5rem);
		}

		.about-content__heading {
			font-size: 2rem;
		}

		.about-content__body,
		.about-content__body p {
			font-size: 1.05rem;
			font-weight: 400;
			line-height: 1.8;
		}
	}

	@media (max-width: 767px) {
		.about-kicker {
			font-size: 1.15rem;
			letter-spacing: 0.06em;
			white-space: nowrap;
			flex-wrap: nowrap;
			max-width: 100%;
			overflow: hidden;
		}

		.about-kicker__photo,
		.about-kicker__photo img {
			height: 4.5rem;
		}

		.about-kicker__photo {
			width: calc(var(--about-photo) * 4.5rem);
		}

		.about-kicker__photo img {
			width: 4.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-kicker {
			--about-photo: 1;
		}

		.about-kicker__photo {
			transition: none;
		}
	}
</style>

<script>
	import { wrapRevealLetters } from '../scripts/initScrollLetterReveal.ts';

	function easePhoto(value: number) {
		return value * value * (3 - 2 * value);
	}

	function updateAboutKicker() {
		const section = document.getElementById('about');
		const kicker = document.getElementById('about-kicker');
		if (!section || !kicker) return;

		const photo = kicker.querySelector<HTMLElement>('.about-kicker__photo');
		const before = kicker.querySelector<HTMLElement>('[data-i18n="about.kickerBefore"]');
		const after = kicker.querySelector<HTMLElement>('[data-i18n="about.kickerAfter"]');

		let progress = 1;

		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const rect = section.getBoundingClientRect();
			const start = window.innerHeight * 0.78;
			const end = window.innerHeight * 0.32;
			const raw = (start - rect.top) / Math.max(start - end, 1);
			progress = easePhoto(Math.min(1, Math.max(0, raw)));
		}

		if (photo && before && after) {
			const photoMax = photo.getBoundingClientRect().height || parseFloat(getComputedStyle(photo).height);
			const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
			const extraPerUnit = photoMax + 0.85 * rem * 2;
			const textWidth = before.getBoundingClientRect().width + after.getBoundingClientRect().width;
			const available = kicker.clientWidth - textWidth - 2;
			const maxProgress = extraPerUnit > 0 ? Math.max(0, available / extraPerUnit) : 1;
			progress = Math.min(progress, maxProgress);
		}

		kicker.style.setProperty('--about-photo', progress.toFixed(4));
	}

	function updateAboutHeadingReveal() {
		const heading = document.getElementById('about-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	function wrapAboutHeadingLetters() {
		const heading = document.getElementById('about-heading');
		if (!heading) return;

		heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
			wrapRevealLetters(line as HTMLElement);
		});

		updateAboutHeadingReveal();
	}

	function initAboutSection() {
		const section = document.getElementById('about');
		if (!section) return;

		wrapAboutHeadingLetters();
		updateAboutKicker();

		if (section.dataset.aboutInit === 'true') return;
		section.dataset.aboutInit = 'true';

		let ticking = false;

		function onScroll() {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(() => {
				updateAboutKicker();
				updateAboutHeadingReveal();
				ticking = false;
			});
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAboutSection, { once: true });
	} else {
		initAboutSection();
	}

	document.addEventListener('astro:page-load', initAboutSection);
	document.addEventListener('i18n-applied', () => {
		wrapAboutHeadingLetters();
		updateAboutKicker();
	});
</script>
