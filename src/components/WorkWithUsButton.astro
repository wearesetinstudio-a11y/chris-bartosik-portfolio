---
import { t } from '../utils/i18n.ts';

interface Props {
	href?: string;
	label?: string;
	variant?: 'light' | 'dark';
	size?: 'default' | 'large';
	i18nKey?: string;
	count?: number;
}

const {
	href = '/#contact',
	label = t('cta.workWithMe', 'en'),
	variant = 'light',
	size = 'default',
	i18nKey,
	count,
} = Astro.props;

const isDark = variant === 'dark';
const textColor = isDark ? 'text-black' : 'text-setin-fg';
const underlineColor = isDark ? 'bg-black' : 'bg-white';
const textSize = size === 'large' ? 'text-[2rem]' : 'text-[1.2rem]';
const lineClass = `flex h-[1.5em] items-center leading-[1.15] ${textSize} font-semibold uppercase ${textColor}`;
const isStatic = size === 'large';
const displayLabel = count !== undefined ? `${label} [${count}]` : label;
---

<div class="work-with-us-button group relative inline-block">
	<a href={href} class={`relative -mx-1 -my-2 block px-1 py-2 ${textColor}`}>
		{
			isStatic ? (
				<span class={lineClass} data-i18n={i18nKey} data-i18n-count={count}>
					{displayLabel}
				</span>
			) : (
				<div class="flex h-[1.5em] flex-col overflow-hidden">
					<div
						class="flex flex-col transition-transform duration-300 ease-in group-hover:-translate-y-1/2 group-hover:duration-[450ms] group-hover:ease-out"
					>
						<span class={lineClass} data-i18n={i18nKey} data-i18n-count={count}>
							{displayLabel}
						</span>
						<span class={lineClass} data-i18n={i18nKey} data-i18n-count={count}>
							{displayLabel}
						</span>
					</div>
				</div>
			)
		}
	</a>

	<div
		class={`work-with-us-button__underline absolute -bottom-1 left-0 h-[1.5px] w-full origin-left scale-x-100 transition-transform duration-300 ease-out group-hover:origin-right group-hover:scale-x-0 ${underlineColor}`}
		aria-hidden="true"
	></div>
</div>
