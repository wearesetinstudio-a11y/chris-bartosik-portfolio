---
interface Props {
	name: string;
	role: string;
	bio: string;
	imageSrc: string;
	imageAlt: string;
	links: { label: string; href: string }[];
	align?: 'start' | 'end';
}

const { name, role, bio, imageSrc, imageAlt, links, align = 'start' } = Astro.props;
---

<article
	class:list={[
		'about-team-member flex flex-col gap-12 md:flex-row md:items-start md:gap-x-20 lg:gap-x-24',
		align === 'end' && 'about-team-member--end',
	]}
>
	{
		align === 'end' && (
			<div class="about-team-member__spacer hidden min-w-0 md:block md:flex-1" aria-hidden="true" />
		)
	}

	<img
		src={imageSrc}
		alt={imageAlt}
		width="320"
		height="400"
		class="about-team-member__photo h-[400px] w-[320px] shrink-0 object-cover grayscale"
		loading="lazy"
		decoding="async"
	/>

	<div class="about-team-member__content shrink-0 md:max-w-[540px] md:pt-1">
		<h2 class="about-team-member__heading uppercase text-setin-fg">
			<span class="font-semibold">{name}</span>
			<span class="ml-4 font-normal text-setin-fg/80">{role}</span>
		</h2>

		<p class="about-team-member__bio mt-8 leading-relaxed text-setin-fg">{bio}</p>

		<div class="mt-10 flex flex-wrap gap-x-10 gap-y-3">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="about-team-member__link text-[1rem] font-semibold uppercase text-setin-muted transition-opacity hover:opacity-70"
						target="_blank"
						rel="noopener noreferrer"
					>
						{link.label}
					</a>
				))
			}
		</div>
	</div>

	{
		align === 'start' && (
			<div class="about-team-member__spacer hidden min-w-0 md:block md:flex-1" aria-hidden="true" />
		)
	}
</article>

<style is:global>
	.about-team-member__heading {
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.about-team-member__bio {
		font-size: 1.2rem;
	}
</style>
