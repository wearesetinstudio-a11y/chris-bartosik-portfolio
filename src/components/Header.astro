---
import RollingLink from './RollingLink.astro';
import WorkWithUsButton from './WorkWithUsButton.astro';

interface Props {
	projectCount?: number;
	articleCount?: number;
	waitForIntro?: boolean;
	theme?: 'default' | 'light-bg';
}

const {
	projectCount = 0,
	articleCount = 0,
	waitForIntro = false,
	theme = 'default',
} = Astro.props;

const hasLocalContact =
	Astro.url.pathname === '/' ||
	Astro.url.pathname === '/about' ||
	Astro.url.pathname === '/projects' ||
	Astro.url.pathname === '/articles' ||
	Astro.url.pathname.startsWith('/articles/') ||
	/^\/projects\/[^/]+$/.test(Astro.url.pathname);

const workWithUsHref = hasLocalContact ? '#contact' : '/#contact';
const isLightBg = theme === 'light-bg';

const nav = [
	{ href: '/projects', label: 'Projects', count: projectCount },
	{ href: '/about', label: 'About us' },
	{ href: '/articles', label: 'Articles', count: articleCount },
];

const headerClass = waitForIntro
	? 'opacity-0 -translate-y-2 pointer-events-none'
	: 'opacity-100 translate-y-0';
---

<header
	id="site-header"
	data-wait-intro={waitForIntro ? 'true' : 'false'}
	data-theme={theme}
	class:list={[
		'site-header fixed inset-x-0 top-0 z-50 bg-transparent transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]',
		isLightBg && 'site-header--light-bg',
		headerClass,
	]}
>
	<div class="grid h-[72px] w-full grid-cols-[1fr_auto] items-center px-[var(--page-gutter)] md:h-[100px] md:grid-cols-[1fr_auto_1fr]">
		<a
			href="/"
			class="site-header__logo-link block w-fit transition-opacity hover:opacity-70"
			aria-label="Setin Studio — home"
		>
			<div class="site-header__logo-mark flex items-center" aria-hidden="true">
				<img
					src="/logo-setin.svg"
					alt=""
					width="111"
					height="42"
					class="site-header__logo-setin h-[28px] w-auto shrink-0"
				/>
				<div class="site-header__logo-sygnet-wrap flex shrink-0 items-center justify-center">
					<img
						src="/logo-sygnet.svg"
						alt=""
						width="51"
						height="48"
						class="site-header__logo-sygnet h-[30px] w-auto"
					/>
				</div>
				<img
					src="/logo-studio.svg"
					alt=""
					width="143"
					height="42"
					class="site-header__logo-studio h-[28px] w-auto shrink-0"
				/>
			</div>
		</a>

		<nav class="hidden items-center justify-center gap-8 md:flex lg:gap-10" aria-label="Main">
			{
				nav.map((item) => (
					<RollingLink href={item.href} label={item.label} count={item.count} inverted={isLightBg} />
				))
			}
		</nav>

		<div class="hidden justify-end md:flex">
			<WorkWithUsButton href={workWithUsHref} variant={isLightBg ? 'dark' : 'light'} />
		</div>

		<button
			type="button"
			id="mobile-nav-toggle"
			class="mobile-nav-toggle relative -mr-1 flex h-10 w-10 flex-col items-end justify-center gap-[5px] md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav-panel"
			aria-label="Open menu"
		>
			<span class="mobile-nav-toggle__line" aria-hidden="true"></span>
			<span class="mobile-nav-toggle__line" aria-hidden="true"></span>
		</button>
	</div>
</header>

<div
	id="mobile-nav-panel"
	class="mobile-nav-panel fixed inset-x-0 top-0 z-[45] flex h-[100dvh] flex-col justify-center bg-[#131415] px-[var(--page-gutter)] md:hidden"
	aria-hidden="true"
>
	<div class="mobile-nav-panel__content flex w-full flex-col gap-10">
		<nav class="flex flex-col gap-8" aria-label="Mobile">
			{
				nav.map((item) => {
					const text =
						item.count !== undefined ? `${item.label} [${item.count}]` : item.label;

					return (
						<a
							href={item.href}
							class="mobile-nav-link text-[2rem] font-semibold uppercase leading-none text-setin-fg"
							data-mobile-nav-link
						>
							{text}
						</a>
					);
				})
			}
		</nav>

		<div class="mobile-nav-panel__cta" data-mobile-nav-link>
			<WorkWithUsButton href={workWithUsHref} size="large" />
		</div>
	</div>
</div>

<style is:global>
	.site-header.header-solid {
		background-color: #131415;
	}

	.site-header__logo-mark {
		gap: 0.5rem;
		transition: gap 0.5s cubic-bezier(0.76, 0, 0.24, 1);
	}

	.site-header__logo-setin,
	.site-header__logo-studio {
		max-width: 9rem;
		opacity: 1;
		overflow: hidden;
		transition:
			max-width 0.5s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.35s ease,
			margin 0.5s cubic-bezier(0.76, 0, 0.24, 1);
	}

	.site-header__logo-sygnet-wrap {
		transition: transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
	}

	.site-header.header-logo-compact .site-header__logo-mark {
		gap: 0;
	}

	.site-header.header-logo-compact .site-header__logo-setin,
	.site-header.header-logo-compact .site-header__logo-studio {
		max-width: 0;
		opacity: 0;
		margin-inline: 0;
	}

	.site-header--light-bg:not(.header-solid) .site-header__logo-mark img {
		filter: brightness(0);
	}

	.site-header--light-bg.header-solid .site-header__logo-mark img {
		filter: none;
	}

	.site-header--light-bg:not(.header-solid) .rolling-link,
	.site-header--light-bg:not(.header-solid) .rolling-link span {
		color: #000000 !important;
	}

	.site-header--light-bg.header-solid .rolling-link,
	.site-header--light-bg.header-solid .rolling-link span {
		color: #f5f5f5 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button,
	.site-header--light-bg:not(.header-solid) .work-with-us-button span {
		color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button__underline {
		background-color: #000000 !important;
	}

	.site-header--light-bg.header-solid .work-with-us-button,
	.site-header--light-bg.header-solid .work-with-us-button span {
		color: #f5f5f5 !important;
	}

	.site-header--light-bg.header-solid .work-with-us-button__underline {
		background-color: #ffffff !important;
	}

	.mobile-nav-toggle {
		position: relative;
		z-index: 50;
		color: #f5f5f5;
		transition: gap 0.6s cubic-bezier(0.76, 0, 0.24, 1);
	}

	.mobile-nav-toggle__line {
		display: block;
		width: 48px;
		height: 2px;
		background-color: currentColor;
		transition:
			transform 0.6s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.5s cubic-bezier(0.76, 0, 0.24, 1);
		will-change: transform, opacity;
	}

	.site-header--light-bg:not(.header-solid) .mobile-nav-toggle {
		color: #000000;
	}

	.site-header--light-bg.header-solid .mobile-nav-toggle,
	.site-header:not(.site-header--light-bg) .mobile-nav-toggle {
		color: #f5f5f5;
	}

	.mobile-nav-toggle.is-open {
		gap: 0;
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__line:first-child {
		transform: translateY(3.5px);
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__line:last-child {
		transform: translateY(-3.5px);
		opacity: 0;
	}

	.mobile-nav-panel__cta .work-with-us-button span {
		font-size: 2rem;
		line-height: 1.15;
	}

	.mobile-nav-panel {
		pointer-events: none;
		transform: translateY(-100%);
		opacity: 0;
		visibility: hidden;
		transition:
			transform 0.55s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.35s ease,
			visibility 0s linear 0.55s;
		will-change: transform;
	}

	.mobile-nav-panel.is-open {
		pointer-events: auto;
		transform: translateY(0);
		opacity: 1;
		visibility: visible;
		transition:
			transform 0.55s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.35s ease,
			visibility 0s linear 0s;
	}

	body.mobile-nav-open {
		overflow: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__logo-mark,
		.site-header__logo-setin,
		.site-header__logo-studio,
		.site-header__logo-sygnet-wrap,
		.mobile-nav-toggle,
		.mobile-nav-toggle__line,
		.mobile-nav-panel {
			transition: none !important;
		}
	}
</style>

<script>
	import { hasCompletedIntro } from '../scripts/introState.ts';

	let headerScrollCleanup: (() => void) | null = null;
	let mobileNavCleanup: (() => void) | null = null;

	function initHeaderSolidBackground() {
		headerScrollCleanup?.();
		headerScrollCleanup = null;

		const header = document.getElementById('site-header');
		if (!header) return;

		const isLightBg = header.dataset.theme === 'light-bg';
		const headline = document.getElementById('hero-headline');

		function updateHeaderSolid() {
			const isLogoCompact = window.scrollY > 40;
			header.classList.toggle('header-logo-compact', isLogoCompact);

			if (isLightBg) {
				header.classList.toggle('header-solid', isLogoCompact);
				return;
			}

			if (!headline) {
				header.classList.toggle('header-solid', isLogoCompact);
				return;
			}

			const headlineTop = headline.getBoundingClientRect().top;
			const headerHeight = header.offsetHeight;
			header.classList.toggle('header-solid', headlineTop <= headerHeight);
		}

		let ticking = false;

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				updateHeaderSolid();
				ticking = false;
			});
		}

		updateHeaderSolid();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', updateHeaderSolid, { passive: true });

		headerScrollCleanup = () => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', updateHeaderSolid);
		};
	}

	function closeMobileNav() {
		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');

		if (!toggle || !panel) return;

		toggle.classList.remove('is-open');
		toggle.setAttribute('aria-expanded', 'false');
		toggle.setAttribute('aria-label', 'Open menu');
		panel.classList.remove('is-open');
		panel.setAttribute('aria-hidden', 'true');
		document.body.classList.remove('mobile-nav-open');
	}

	function initMobileNav() {
		mobileNavCleanup?.();
		mobileNavCleanup = null;

		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');

		if (!toggle || !panel) {
			closeMobileNav();
			return;
		}

		const onToggleClick = () => {
			const isOpen = toggle.classList.toggle('is-open');
			panel.classList.toggle('is-open', isOpen);
			panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
			toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
			toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
			document.body.classList.toggle('mobile-nav-open', isOpen);
		};

		const onPanelClick = (event: Event) => {
			const target = event.target as HTMLElement | null;
			if (target?.closest('[data-mobile-nav-link]')) closeMobileNav();
		};

		const onKeyDown = (event: KeyboardEvent) => {
			if (event.key === 'Escape') closeMobileNav();
		};

		toggle.addEventListener('click', onToggleClick);
		panel.addEventListener('click', onPanelClick);
		window.addEventListener('keydown', onKeyDown);

		mobileNavCleanup = () => {
			toggle.removeEventListener('click', onToggleClick);
			panel.removeEventListener('click', onPanelClick);
			window.removeEventListener('keydown', onKeyDown);
			closeMobileNav();
		};
	}

	function initHeaderIntroReveal() {
		const header = document.getElementById('site-header');
		if (!header || header.dataset.waitIntro !== 'true') return;

		if (hasCompletedIntro()) {
			header.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
			return;
		}

		window.addEventListener(
			'intro-complete',
			() => {
				header.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
			},
			{ once: true },
		);
	}

	function initHeader() {
		initHeaderSolidBackground();
		initMobileNav();
		initHeaderIntroReveal();
	}

	initHeader();
	document.addEventListener('astro:page-load', () => {
		closeMobileNav();
		initHeader();
	});
</script>
