---
import RollingLink from './RollingLink.astro';
import WorkWithUsButton from './WorkWithUsButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ChrisLogo from './ChrisLogo.astro';
import { t } from '../utils/i18n.ts';

interface Props {
	projectCount?: number;
	waitForIntro?: boolean;
	theme?: 'default' | 'light-bg';
}

const {
	projectCount = 0,
	waitForIntro = false,
	theme = 'default',
} = Astro.props;

const workWithUsHref = '#contact';
const isLightBg = theme === 'light-bg';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isNavCurrent(href: string) {
	const target = href.replace(/\/$/, '') || '/';
	if (target === '/projects') return currentPath === '/projects' || currentPath.startsWith('/projects/');
	return currentPath === target;
}

const nav = [
	{ href: '/', label: t('nav.home', 'en'), i18nKey: 'nav.home' },
	{ href: '/skills', label: t('nav.skills', 'en'), i18nKey: 'nav.skills' },
	{ href: '/projects', label: t('nav.projects', 'en'), i18nKey: 'nav.projects' },
	{ href: '/about', label: t('nav.about', 'en'), i18nKey: 'nav.about' },
];

const headerClass = waitForIntro
	? 'opacity-0 -translate-y-2 pointer-events-none'
	: 'opacity-100 translate-y-0';
---

<header
	id="site-header"
	data-wait-intro={waitForIntro ? 'true' : 'false'}
	data-theme={theme}
	class:list={[
		'site-header fixed inset-x-0 top-0 z-50 bg-transparent transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]',
		isLightBg && 'site-header--light-bg',
		headerClass,
	]}
>
	<div class="grid h-[72px] w-full grid-cols-[1fr_auto] items-center px-[var(--page-gutter)] md:h-[100px]">
		<a
			href="/"
			class="site-header__logo-link block w-fit transition-opacity hover:opacity-70"
			aria-label={t('nav.homeAria', 'en')}
			data-i18n-aria="nav.homeAria"
		>
			<div class="site-header__logo-mark flex items-center" aria-hidden="true">
				<ChrisLogo size="nav" />
			</div>
		</a>

		<nav class="hidden items-center justify-end gap-8 md:flex lg:gap-10" aria-label={t('nav.main', 'en')} data-i18n-aria="nav.main">
			{
				nav.map((item) => (
					<RollingLink
						href={item.href}
						label={item.label}
						inverted={isLightBg}
						i18nKey={item.i18nKey}
						current={isNavCurrent(item.href)}
					/>
				))
			}
			<WorkWithUsButton href={workWithUsHref} variant={isLightBg ? 'dark' : 'light'} i18nKey="cta.workWithMe" />
			<LanguageSwitcher />
		</nav>

		<div class="header-mobile-tools relative z-[60] flex items-center gap-8 md:hidden">
			<LanguageSwitcher />
			<button
				type="button"
				id="mobile-nav-toggle"
				class="mobile-nav-toggle relative flex h-10 w-10 flex-col items-end justify-center gap-2"
				aria-expanded="false"
				aria-controls="mobile-nav-panel"
				aria-label={t('nav.openMenu', 'en')}
				data-i18n-aria="nav.openMenu"
			>
				<span class="mobile-nav-toggle__line" aria-hidden="true"></span>
				<span class="mobile-nav-toggle__line" aria-hidden="true"></span>
			</button>
		</div>
	</div>
</header>

<div
	id="mobile-nav-panel"
	class="mobile-nav-panel fixed inset-x-0 top-0 z-[45] flex h-[100dvh] flex-col justify-center bg-[#131415] px-[var(--page-gutter)] md:hidden"
	aria-hidden="true"
>
	<div class="mobile-nav-panel__content flex w-full flex-col gap-10">
		<nav class="flex flex-col gap-8" aria-label={t('nav.mobile', 'en')} data-i18n-aria="nav.mobile">
			{
				nav.map((item) => (
						<a
							href={item.href}
							class:list={[
								'mobile-nav-link text-[2rem] font-semibold uppercase leading-none text-setin-fg',
								isNavCurrent(item.href) && 'mobile-nav-link--current',
							]}
							aria-current={isNavCurrent(item.href) ? 'page' : undefined}
							data-mobile-nav-link
							data-i18n={item.i18nKey}
						>
							{item.label}
						</a>
					))
			}
		</nav>

		<div class="mobile-nav-panel__cta flex flex-col items-start" data-mobile-nav-link>
			<WorkWithUsButton href={workWithUsHref} size="large" i18nKey="cta.workWithMe" />
		</div>
	</div>
</div>

<style is:global>
	.site-header {
		pointer-events: none;
	}

	.site-header__logo-link,
	.site-header nav,
	.header-mobile-tools,
	.mobile-nav-toggle {
		pointer-events: auto;
	}

	.site-header.header-solid {
		background-color: #131415;
	}

	.rolling-link,
	.mobile-nav-link {
		transition: opacity 0.25s ease;
	}

	.rolling-link--current,
	.mobile-nav-link--current {
		opacity: 0.38;
	}

	.rolling-link--current:hover,
	.rolling-link--current:focus-visible,
	.mobile-nav-link--current:hover,
	.mobile-nav-link--current:focus-visible {
		opacity: 1;
	}

	.site-header__logo-text {
		white-space: nowrap;
	}

	.site-header__logo-mark .logo-mark img {
		transition: filter 0.35s ease;
	}

	.site-header--light-bg:not(.header-solid) .site-header__logo-text {
		color: #000000;
	}

	.site-header--light-bg:not(.header-solid) .site-header__logo-mark .logo-mark__name {
		filter: brightness(0);
	}

	.site-header--light-bg.header-solid .site-header__logo-text {
		color: #f5f5f5;
	}

	.site-header--light-bg.header-solid .site-header__logo-mark .logo-mark img {
		filter: none;
	}

	.site-header--light-bg:not(.header-solid) .lang-switcher {
		color: #000000;
	}

	.site-header--light-bg.header-solid .lang-switcher,
	.site-header:not(.site-header--light-bg) .lang-switcher {
		color: #f5f5f5;
	}

	.site-header--light-bg:not(.header-solid) .rolling-link,
	.site-header--light-bg:not(.header-solid) .rolling-link span {
		color: #000000 !important;
	}

	.site-header--light-bg.header-solid .rolling-link,
	.site-header--light-bg.header-solid .rolling-link span {
		color: #f5f5f5 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button,
	.site-header--light-bg:not(.header-solid) .work-with-us-button span {
		color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button__underline {
		background-color: #000000 !important;
	}

	.site-header--light-bg.header-solid .work-with-us-button,
	.site-header--light-bg.header-solid .work-with-us-button span {
		color: #f5f5f5 !important;
	}

	.site-header--light-bg.header-solid .work-with-us-button__underline {
		background-color: #ffffff !important;
	}

	body.mobile-nav-open .site-header--light-bg .site-header__logo-text,
	body.mobile-nav-open .site-header--light-bg .lang-switcher {
		color: #f5f5f5;
	}

	body.mobile-nav-open .site-header--light-bg .site-header__logo-mark .logo-mark__name {
		filter: none;
	}

	body.mobile-nav-open .site-header--light-bg .mobile-nav-toggle {
		color: #f5f5f5;
	}

	.header-mobile-tools {
		pointer-events: auto;
	}

	.mobile-nav-toggle {
		position: relative;
		z-index: 60;
		pointer-events: auto;
		color: #f5f5f5;
		touch-action: manipulation;
		transition: gap 0.6s cubic-bezier(0.76, 0, 0.24, 1);
	}

	.mobile-nav-toggle__line {
		display: block;
		width: 48px;
		height: 2px;
		background-color: currentColor;
		transition:
			transform 0.6s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.5s cubic-bezier(0.76, 0, 0.24, 1);
		will-change: transform, opacity;
	}

	.site-header--light-bg:not(.header-solid) .mobile-nav-toggle {
		color: #000000;
	}

	.site-header--light-bg.header-solid .mobile-nav-toggle,
	.site-header:not(.site-header--light-bg) .mobile-nav-toggle {
		color: #f5f5f5;
	}

	.mobile-nav-toggle.is-open {
		gap: 0;
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__line:first-child {
		transform: translateY(5px);
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__line:last-child {
		transform: translateY(-5px);
		opacity: 0;
	}

	.mobile-nav-panel__cta .work-with-us-button span {
		font-size: 2rem;
		line-height: 1.15;
	}

	.mobile-nav-panel {
		pointer-events: none;
		transform: translateY(-100%);
		opacity: 0;
		visibility: hidden;
		overflow: hidden;
		overscroll-behavior: none;
		touch-action: none;
		transition:
			transform 0.55s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.35s ease,
			visibility 0s linear 0.55s;
		will-change: transform;
	}

	.mobile-nav-panel.is-open {
		pointer-events: auto;
		transform: translateY(0);
		opacity: 1;
		visibility: visible;
		transition:
			transform 0.55s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.35s ease,
			visibility 0s linear 0s;
	}

	.mobile-nav-panel .mobile-nav-link,
	.mobile-nav-panel .mobile-nav-panel__cta {
		opacity: 0;
		transform: translateX(-1.75rem);
	}

	.mobile-nav-panel.is-open .mobile-nav-link,
	.mobile-nav-panel.is-open .mobile-nav-panel__cta {
		transition:
			opacity 0.35s ease,
			transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* Enter: first → last */
	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link,
	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-panel__cta {
		opacity: 1;
		transform: translateX(0);
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(1) {
		transition-delay: 0ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(2) {
		transition-delay: 55ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(3) {
		transition-delay: 110ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(4) {
		transition-delay: 165ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-panel__cta {
		transition-delay: 220ms;
	}

	/* Exit: last → first */
	.mobile-nav-panel.is-open:not(.is-content-ready) .mobile-nav-panel__cta {
		transition-delay: 0ms;
	}

	.mobile-nav-panel.is-open:not(.is-content-ready) .mobile-nav-link:nth-child(4) {
		transition-delay: 55ms;
	}

	.mobile-nav-panel.is-open:not(.is-content-ready) .mobile-nav-link:nth-child(3) {
		transition-delay: 110ms;
	}

	.mobile-nav-panel.is-open:not(.is-content-ready) .mobile-nav-link:nth-child(2) {
		transition-delay: 165ms;
	}

	.mobile-nav-panel.is-open:not(.is-content-ready) .mobile-nav-link:nth-child(1) {
		transition-delay: 220ms;
	}

	body.mobile-nav-open {
		overflow: hidden;
		overscroll-behavior: none;
		touch-action: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-toggle,
		.mobile-nav-toggle__line,
		.mobile-nav-panel,
		.mobile-nav-panel .mobile-nav-link,
		.mobile-nav-panel .mobile-nav-panel__cta {
			transition: none !important;
			transition-delay: 0ms !important;
			transform: none !important;
			opacity: 1 !important;
		}
	}
</style>

<script>
	import { hasCompletedIntro } from '../scripts/introState.ts';
	import { initLogoWave } from '../scripts/preloaderWave.ts';
	import { t } from '../utils/i18n.ts';

	let headerScrollCleanup: (() => void) | null = null;
	let syncHeaderAppearance: (() => void) | null = null;
	let lockedScrollY = 0;
	let mobileNavContentTimer = 0;

	type MobileNavWindow = Window &
		typeof globalThis & {
			__mobileNavBound?: boolean;
		};

	function restoreScroll(scrollY: number) {
		const html = document.documentElement;
		const previousBehavior = html.style.scrollBehavior;
		html.style.scrollBehavior = 'auto';
		window.scrollTo(0, scrollY);
		html.style.scrollBehavior = previousBehavior;
	}

	function lockBodyScroll() {
		lockedScrollY = window.scrollY || document.documentElement.scrollTop || 0;
		document.body.classList.add('mobile-nav-open');
		document.body.style.position = 'fixed';
		document.body.style.top = `-${lockedScrollY}px`;
		document.body.style.left = '0';
		document.body.style.right = '0';
		document.body.style.width = '100%';
	}

	function unlockBodyScroll() {
		if (!document.body.classList.contains('mobile-nav-open')) return;

		const scrollY = lockedScrollY;
		document.body.classList.remove('mobile-nav-open');
		document.documentElement.classList.remove('mobile-nav-open');
		document.body.style.position = '';
		document.body.style.top = '';
		document.body.style.left = '';
		document.body.style.right = '';
		document.body.style.width = '';
		restoreScroll(scrollY);
	}

	function initHeaderSolidBackground() {
		headerScrollCleanup?.();
		headerScrollCleanup = null;

		const header = document.getElementById('site-header');
		if (!header) return;

		const isLightBg = header.dataset.theme === 'light-bg';
		const headline =
			document.getElementById('hero-headline') ??
			document.getElementById('project-hero-headline');

		function updateHeaderSolid() {
			const menuOpen = document.body.classList.contains('mobile-nav-open');

			if (menuOpen) {
				header.classList.add('header-solid');
				return;
			}

			if (isLightBg) {
				header.classList.toggle('header-solid', window.scrollY > 40);
				return;
			}

			if (!headline) {
				header.classList.toggle('header-solid', window.scrollY > 40);
				return;
			}

			const headlineTop = headline.getBoundingClientRect().top;
			const headerHeight = header.offsetHeight;
			header.classList.toggle('header-solid', headlineTop <= headerHeight);
		}

		let ticking = false;

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				updateHeaderSolid();
				ticking = false;
			});
		}

		updateHeaderSolid();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', updateHeaderSolid, { passive: true });

		headerScrollCleanup = () => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', updateHeaderSolid);
		};

		syncHeaderAppearance = updateHeaderSolid;
	}

	function setMobileNavOpen(isOpen: boolean) {
		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');

		if (!toggle || !panel) return;

		window.clearTimeout(mobileNavContentTimer);

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		toggle.setAttribute('aria-label', isOpen ? t('nav.closeMenu') : t('nav.openMenu'));
		toggle.dataset.i18nAria = isOpen ? 'nav.closeMenu' : 'nav.openMenu';
		panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');

		if (isOpen) {
			toggle.classList.add('is-open');
			panel.classList.add('is-open');
			panel.classList.remove('is-content-ready');
			lockBodyScroll();

			mobileNavContentTimer = window.setTimeout(
				() => {
					if (panel.classList.contains('is-open')) {
						panel.classList.add('is-content-ready');
					}
				},
				reduceMotion ? 0 : 560,
			);
		} else {
			toggle.classList.remove('is-open');
			const hadContent = panel.classList.contains('is-content-ready');
			panel.classList.remove('is-content-ready');

			const finishClose = () => {
				panel.classList.remove('is-open');
				unlockBodyScroll();
				syncHeaderAppearance?.();
			};

			if (reduceMotion || !panel.classList.contains('is-open') || !hadContent) {
				finishClose();
			} else {
				// Wait for reverse item stagger, then slide panel up
				mobileNavContentTimer = window.setTimeout(finishClose, 650);
			}
		}

		syncHeaderAppearance?.();
	}

	function closeMobileNav() {
		setMobileNavOpen(false);
	}

	function initMobileNav() {
		const navWindow = window as MobileNavWindow;
		if (navWindow.__mobileNavBound) return;
		navWindow.__mobileNavBound = true;

		document.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null;
			if (!target) return;

			if (target.closest('#mobile-nav-toggle')) {
				const toggle = document.getElementById('mobile-nav-toggle');
				const isOpen = toggle?.classList.contains('is-open') === true;
				setMobileNavOpen(!isOpen);
				return;
			}

			if (target.closest('#mobile-nav-panel [data-mobile-nav-link]')) {
				closeMobileNav();
			}
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMobileNav();
		});
	}

	function revealHeader() {
		const header = document.getElementById('site-header');
		if (!header) return;
		header.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
	}

	function initHeaderIntroReveal() {
		const header = document.getElementById('site-header');
		if (!header || header.dataset.waitIntro !== 'true') return;

		if (hasCompletedIntro()) {
			revealHeader();
			return;
		}

		window.addEventListener('intro-complete', revealHeader, { once: true });
		window.setTimeout(revealHeader, 3500);
	}

	function initHeader() {
		initHeaderSolidBackground();
		initMobileNav();
		initHeaderIntroReveal();
		initLogoWave();
	}

	initHeader();
	document.addEventListener('astro:page-load', () => {
		closeMobileNav();
		initHeader();
	});
</script>
