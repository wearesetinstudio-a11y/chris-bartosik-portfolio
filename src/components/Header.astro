---
import RollingLink from './RollingLink.astro';
import WorkWithUsButton from './WorkWithUsButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ChrisLogo from './ChrisLogo.astro';
import { t } from '../utils/i18n.ts';

interface Props {
	projectCount?: number;
	waitForIntro?: boolean;
	theme?: 'default' | 'light-bg';
}

const {
	projectCount = 0,
	waitForIntro = false,
	theme = 'default',
} = Astro.props;

const workWithUsHref = '#contact';
const isLightBg = theme === 'light-bg';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isNavCurrent(href: string) {
	const target = href.replace(/\/$/, '') || '/';
	if (target === '/projects') return currentPath === '/projects' || currentPath.startsWith('/projects/');
	return currentPath === target;
}

const nav = [
	{ href: '/', label: t('nav.home', 'en'), i18nKey: 'nav.home' },
	{ href: '/skills', label: t('nav.skills', 'en'), i18nKey: 'nav.skills' },
	{ href: '/projects', label: t('nav.projects', 'en'), i18nKey: 'nav.projects' },
	{ href: '/about', label: t('nav.about', 'en'), i18nKey: 'nav.about' },
];

const headerClass = waitForIntro
	? 'opacity-0 -translate-y-2 pointer-events-none'
	: 'opacity-100 translate-y-0';
---

<header
	id="site-header"
	data-wait-intro={waitForIntro ? 'true' : 'false'}
	data-theme={theme}
	class:list={[
		'site-header fixed inset-x-0 top-0 z-50 bg-transparent transition-[background-color] duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]',
		isLightBg && 'site-header--light-bg',
		headerClass,
	]}
>
	<div class="site-header__inner grid h-[72px] w-full grid-cols-[1fr_auto] items-center md:h-[100px]">
		<a
			href="/"
			class="site-header__logo-link block w-fit transition-opacity hover:opacity-70"
			aria-label={t('nav.homeAria', 'en')}
			data-i18n-aria="nav.homeAria"
		>
			<div class="site-header__logo-mark flex items-center" aria-hidden="true">
				<ChrisLogo size="nav" />
			</div>
		</a>

		<nav class="hidden items-center justify-end gap-8 md:flex lg:gap-10" aria-label={t('nav.main', 'en')} data-i18n-aria="nav.main">
			{
				nav.map((item) => (
					<RollingLink
						href={item.href}
						label={item.label}
						inverted={isLightBg}
						i18nKey={item.i18nKey}
						current={isNavCurrent(item.href)}
					/>
				))
			}
			<WorkWithUsButton href={workWithUsHref} variant={isLightBg ? 'dark' : 'light'} i18nKey="cta.workWithMe" />
			<LanguageSwitcher />
		</nav>

		<div class="header-mobile-tools relative z-[60] flex items-center gap-8 md:hidden">
			<LanguageSwitcher />
			<button
				type="button"
				id="mobile-nav-toggle"
				class="mobile-nav-toggle relative flex h-10 w-10 items-center justify-center"
				aria-expanded="false"
				aria-controls="mobile-nav-panel"
				aria-label={t('nav.openMenu', 'en')}
				data-i18n-aria="nav.openMenu"
			>
				<span class="mobile-nav-toggle__dots" aria-hidden="true">
					<span class="mobile-nav-toggle__dot"></span>
					<span class="mobile-nav-toggle__dot"></span>
					<span class="mobile-nav-toggle__dot"></span>
					<span class="mobile-nav-toggle__dot"></span>
				</span>
			</button>
		</div>
	</div>
</header>

<div
	id="mobile-nav-panel"
	class="mobile-nav-panel fixed inset-0 z-[45] md:hidden"
	transition:persist="mobile-nav"
	aria-hidden="true"
>
	<div class="mobile-nav-bars" aria-hidden="true">
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
		<div class="mobile-nav-bar"></div>
	</div>

	<div class="mobile-nav-panel__content flex w-full flex-col gap-10 px-[var(--page-gutter)]">
		<nav class="flex flex-col gap-8" aria-label={t('nav.mobile', 'en')} data-i18n-aria="nav.mobile">
			{
				nav.map((item) => (
						<a
							href={item.href}
							class:list={[
								'mobile-nav-link text-[2rem] font-semibold uppercase leading-none text-setin-fg',
								isNavCurrent(item.href) && 'mobile-nav-link--current',
							]}
							aria-current={isNavCurrent(item.href) ? 'page' : undefined}
							data-mobile-nav-link
							data-i18n={item.i18nKey}
						>
							{item.label}
						</a>
					))
			}
		</nav>

		<div class="mobile-nav-panel__cta flex flex-col items-start" data-mobile-nav-link>
			<WorkWithUsButton href={workWithUsHref} size="large" i18nKey="cta.workWithMe" />
		</div>
	</div>
</div>

<style is:global>
	.site-header {
		pointer-events: none;
	}

	.site-header__logo-link,
	.site-header nav,
	.header-mobile-tools,
	.mobile-nav-toggle {
		pointer-events: auto;
	}

	.site-header.header-solid {
		background-color: #131415;
	}

	.site-header--light-bg.header-solid,
	.site-header--light-bg.is-scrolled {
		background-color: #ffffff;
	}

	.site-header__inner {
		position: relative;
		padding-left: calc(var(--page-gutter) - 20px);
		padding-right: calc(var(--page-gutter) - 20px);
		transition: padding 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-header__inner::after {
		content: '';
		position: absolute;
		left: calc(var(--page-gutter) - 20px);
		right: calc(var(--page-gutter) - 20px);
		bottom: 0;
		height: 1px;
		background-color: var(--color-setin-border, rgba(255, 255, 255, 0.12));
		opacity: 0;
		pointer-events: none;
		transition:
			left 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			right 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.site-header.is-scrolled .site-header__inner,
	.site-header.header-solid .site-header__inner {
		padding-left: var(--page-gutter);
		padding-right: var(--page-gutter);
	}

	.site-header.is-scrolled .site-header__inner::after,
	.site-header.header-solid .site-header__inner::after {
		left: var(--page-gutter);
		right: var(--page-gutter);
		opacity: 1;
	}

	@media (max-width: 767px) {
		.site-header__inner {
			padding-left: calc(var(--page-gutter) - 6px);
			padding-right: calc(var(--page-gutter) - 6px);
		}

		.site-header__inner::after {
			left: calc(var(--page-gutter) - 6px);
			right: calc(var(--page-gutter) - 6px);
		}

		.site-header.is-scrolled .site-header__inner,
		.site-header.header-solid .site-header__inner {
			padding-left: var(--page-gutter);
			padding-right: var(--page-gutter);
		}

		.site-header.is-scrolled .site-header__inner::after,
		.site-header.header-solid .site-header__inner::after {
			left: var(--page-gutter);
			right: var(--page-gutter);
		}
	}

	.rolling-link,
	.mobile-nav-link {
		transition: opacity 0.25s ease;
	}

	.rolling-link--current,
	.mobile-nav-link--current {
		opacity: 0.38;
	}

	@media (hover: hover) and (pointer: fine) {
		.rolling-link--current:hover,
		.rolling-link--current:focus-visible,
		.mobile-nav-link--current:hover,
		.mobile-nav-link--current:focus-visible {
			opacity: 1;
		}
	}

	.site-header__logo-text {
		white-space: nowrap;
	}

	.site-header__logo-mark .logo-mark img {
		transition: filter 0.35s ease;
	}

	.site-header--light-bg:not(.header-solid) .site-header__logo-text,
	.site-header--light-bg.header-solid .site-header__logo-text {
		color: #000000;
	}

	.site-header--light-bg:not(.header-solid) .site-header__logo-mark .logo-mark__name,
	.site-header--light-bg.header-solid .site-header__logo-mark .logo-mark__name {
		filter: brightness(0);
	}

	.site-header--light-bg:not(.header-solid) .lang-switcher,
	.site-header--light-bg.header-solid .lang-switcher {
		color: #000000;
	}

	.site-header--light-bg:not(.header-solid) .rolling-link,
	.site-header--light-bg:not(.header-solid) .rolling-link span,
	.site-header--light-bg.header-solid .rolling-link,
	.site-header--light-bg.header-solid .rolling-link span {
		color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button,
	.site-header--light-bg:not(.header-solid) .work-with-us-button span,
	.site-header--light-bg.header-solid .work-with-us-button,
	.site-header--light-bg.header-solid .work-with-us-button span {
		color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .work-with-us-button__underline,
	.site-header--light-bg.header-solid .work-with-us-button__underline {
		background-color: #000000 !important;
	}

	.site-header--light-bg:not(.header-solid) .mobile-nav-toggle,
	.site-header--light-bg.header-solid .mobile-nav-toggle {
		color: #000000;
	}

	.site-header--light-bg.header-solid .site-header__inner::after {
		background-color: rgba(0, 0, 0, 0.12);
	}

	body.mobile-nav-open .site-header--light-bg .site-header__logo-text,
	body.mobile-nav-open .site-header--light-bg .lang-switcher {
		color: #f5f5f5;
	}

	body.mobile-nav-open .site-header--light-bg .site-header__logo-mark .logo-mark__name {
		filter: none;
	}

	body.mobile-nav-open .site-header--light-bg .mobile-nav-toggle {
		color: #f5f5f5;
	}

	body.mobile-nav-open #site-header {
		background-color: transparent;
		transition-property: transform, opacity;
	}

	body.mobile-nav-open #site-header .site-header__logo-link,
	body.mobile-nav-open #site-header .site-header__logo-mark .logo-mark img {
		transition: none;
	}

	.header-mobile-tools {
		pointer-events: auto;
	}

	.mobile-nav-toggle {
		position: relative;
		z-index: 60;
		pointer-events: auto;
		color: #f5f5f5;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		appearance: none;
		background: transparent;
		border: 0;
		padding: 0;
		outline: none;
	}

	.mobile-nav-toggle:focus-visible {
		outline: none;
	}

	.mobile-nav-toggle__dots {
		position: relative;
		display: block;
		width: 16px;
		height: 16px;
	}

	.mobile-nav-toggle__dot {
		position: absolute;
		width: 4.5px;
		height: 4.5px;
		border-radius: 0px;
		background-color: currentColor;
		transform: translate3d(0, 0, 0) scale(1);
		opacity: 1;
		transition:
			transform 0.45s cubic-bezier(0.76, 0, 0.24, 1),
			opacity 0.35s cubic-bezier(0.76, 0, 0.24, 1);
		will-change: transform;
	}

	.mobile-nav-toggle__dot:nth-child(1) {
		top: 1px;
		left: 1px;
	}

	.mobile-nav-toggle__dot:nth-child(2) {
		top: 1px;
		right: 1px;
	}

	.mobile-nav-toggle__dot:nth-child(3) {
		bottom: 1px;
		left: 1px;
	}

	.mobile-nav-toggle__dot:nth-child(4) {
		bottom: 1px;
		right: 1px;
	}

	.site-header:not(.site-header--light-bg) .lang-switcher {
		color: #f5f5f5;
	}

	.site-header:not(.site-header--light-bg) .mobile-nav-toggle {
		color: #f5f5f5;
	}

	/* Morphing 4 squares into one solid square (12x12px) centered */
	.mobile-nav-toggle.is-open .mobile-nav-toggle__dot:nth-child(1) {
		transform: translate3d(2.25px, 2.25px, 0) scale(1.35);
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__dot:nth-child(2) {
		transform: translate3d(-2.25px, 2.25px, 0) scale(1.35);
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__dot:nth-child(3) {
		transform: translate3d(2.25px, -2.25px, 0) scale(1.35);
	}

	.mobile-nav-toggle.is-open .mobile-nav-toggle__dot:nth-child(4) {
		transform: translate3d(-2.25px, -2.25px, 0) scale(1.35);
	}

	.mobile-nav-panel__cta .work-with-us-button span {
		font-size: 2rem;
		line-height: 1.15;
	}

	@keyframes mobile-nav-bar-cover {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes mobile-nav-bar-reveal {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-100%);
		}
	}

	.mobile-nav-panel {
		pointer-events: none;
		visibility: hidden;
		overflow: hidden;
		overscroll-behavior: none;
		touch-action: none;
	}

	.mobile-nav-panel.is-open {
		pointer-events: auto;
		visibility: visible;
	}

	.mobile-nav-bars {
		display: flex;
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
	}

	.mobile-nav-bar {
		flex: 1 1 20%;
		height: 100%;
		background-color: #1f1f1f;
		transform: translateY(-100%);
		will-change: transform;
	}

	.mobile-nav-bar:nth-child(1) {
		--bar-delay: 0ms;
		--bar-reveal-delay: 300ms;
	}

	.mobile-nav-bar:nth-child(2) {
		--bar-delay: 75ms;
		--bar-reveal-delay: 225ms;
	}

	.mobile-nav-bar:nth-child(3) {
		--bar-delay: 150ms;
		--bar-reveal-delay: 150ms;
	}

	.mobile-nav-bar:nth-child(4) {
		--bar-delay: 225ms;
		--bar-reveal-delay: 75ms;
	}

	.mobile-nav-bar:nth-child(5) {
		--bar-delay: 300ms;
		--bar-reveal-delay: 0ms;
	}

	.mobile-nav-panel.is-covered .mobile-nav-bar {
		transform: translateY(0);
	}

	.mobile-nav-panel.is-covering .mobile-nav-bar {
		animation: mobile-nav-bar-cover 900ms cubic-bezier(0.85, 0, 0.15, 1) both;
		animation-delay: var(--bar-delay);
	}

	.mobile-nav-panel.is-revealing .mobile-nav-bar {
		animation: mobile-nav-bar-reveal 900ms cubic-bezier(0.85, 0, 0.15, 1) both;
		animation-delay: var(--bar-reveal-delay);
	}

	.mobile-nav-panel.is-revealing .mobile-nav-panel__content,
	.mobile-nav-panel.is-content-hidden .mobile-nav-panel__content {
		visibility: hidden;
		pointer-events: none;
	}

	.mobile-nav-panel__content {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		height: 100%;
		flex-direction: column;
		justify-content: center;
		pointer-events: none;
	}

	.mobile-nav-panel.is-content-ready .mobile-nav-panel__content {
		pointer-events: auto;
	}

	.mobile-nav-panel .mobile-nav-link,
	.mobile-nav-panel .mobile-nav-panel__cta {
		opacity: 0;
		transform: translateX(-1.75rem);
	}

	.mobile-nav-panel.is-open.is-covered .mobile-nav-link,
	.mobile-nav-panel.is-open.is-covered .mobile-nav-panel__cta {
		transition:
			opacity 0.35s ease,
			transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link,
	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-panel__cta {
		opacity: 1;
		transform: translateX(0);
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(1) {
		transition-delay: 0ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(2) {
		transition-delay: 55ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(3) {
		transition-delay: 110ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-link:nth-child(4) {
		transition-delay: 165ms;
	}

	.mobile-nav-panel.is-open.is-content-ready .mobile-nav-panel__cta {
		transition-delay: 220ms;
	}

	.mobile-nav-panel.is-content-exiting .mobile-nav-link,
	.mobile-nav-panel.is-content-exiting .mobile-nav-panel__cta {
		opacity: 0;
		transform: translateX(-1.75rem);
	}

	.mobile-nav-panel.is-content-exiting .mobile-nav-panel__cta {
		transition-delay: 0ms;
	}

	.mobile-nav-panel.is-content-exiting .mobile-nav-link:nth-child(4) {
		transition-delay: 55ms;
	}

	.mobile-nav-panel.is-content-exiting .mobile-nav-link:nth-child(3) {
		transition-delay: 110ms;
	}

	.mobile-nav-panel.is-content-exiting .mobile-nav-link:nth-child(2) {
		transition-delay: 165ms;
	}

	.mobile-nav-panel.is-content-exiting .mobile-nav-link:nth-child(1) {
		transition-delay: 220ms;
	}

	body.mobile-nav-open {
		overflow: hidden;
		overscroll-behavior: none;
		touch-action: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav-toggle,
		.mobile-nav-toggle__dot,
		.mobile-nav-toggle__ring,
		.mobile-nav-panel.is-covering .mobile-nav-bar,
		.mobile-nav-panel.is-revealing .mobile-nav-bar,
		.mobile-nav-panel .mobile-nav-link,
		.mobile-nav-panel .mobile-nav-panel__cta {
			transition: none !important;
			animation: none !important;
			transition-delay: 0ms !important;
		}

		.mobile-nav-panel.is-covered .mobile-nav-bar {
			transform: translateY(0);
		}

		.mobile-nav-panel:not(.is-covered):not(.is-open) .mobile-nav-bar {
			transform: translateY(-100%);
		}

		.mobile-nav-panel .mobile-nav-link,
		.mobile-nav-panel .mobile-nav-panel__cta {
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>

<script>
	import { hasCompletedIntro } from '../scripts/introState.ts';
	import { initLogoWave } from '../scripts/preloaderWave.ts';
	import {
		forceCloseMobileNav,
		getMobileNavHashLink,
		isMobileNavNavigationActive,
		navigateMobileNavToHash,
		registerMobileNavStateListener,
		setMobileNavOpen,
	} from '../scripts/mobileNavPanel.ts';
	import { onScrollFrame } from '../scripts/scrollFrame.ts';
	import { t } from '../utils/i18n.ts';

	let headerScrollCleanup: (() => void) | null = null;
	let syncHeaderAppearance: (() => void) | null = null;

	type MobileNavWindow = Window &
		typeof globalThis & {
			__mobileNavBound?: boolean;
		};

	const navLabels = () => ({
		open: t('nav.openMenu'),
		close: t('nav.closeMenu'),
	});

	function initHeaderSolidBackground() {
		headerScrollCleanup?.();
		headerScrollCleanup = null;

		const header = document.getElementById('site-header');
		if (!header) return;

		const isLightBg = header.dataset.theme === 'light-bg';
		const headline =
			document.getElementById('hero-headline') ??
			document.getElementById('project-hero-headline');

		function updateHeaderSolid() {
			const menuOpen = document.body.classList.contains('mobile-nav-open');

			if (menuOpen) {
				header.classList.remove('header-solid', 'is-scrolled');
				return;
			}

			const isScrolled = window.scrollY > 20;
			header.classList.toggle('is-scrolled', isScrolled);

			if (isLightBg) {
				header.classList.toggle('header-solid', isScrolled);
				return;
			}

			if (!headline) {
				header.classList.toggle('header-solid', window.scrollY > 40);
				return;
			}

			const headlineTop = headline.getBoundingClientRect().top;
			const headerHeight = header.offsetHeight;
			header.classList.toggle('header-solid', headlineTop <= headerHeight);
		}

		updateHeaderSolid();
		const unsubscribeScroll = onScrollFrame(updateHeaderSolid);
		window.addEventListener('resize', updateHeaderSolid, { passive: true });

		headerScrollCleanup = () => {
			unsubscribeScroll();
			window.removeEventListener('resize', updateHeaderSolid);
		};

		syncHeaderAppearance = updateHeaderSolid;
	}

	function initMobileNav() {
		const navWindow = window as MobileNavWindow;
		if (navWindow.__mobileNavBound) return;
		navWindow.__mobileNavBound = true;

		document.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null;
			if (!target) return;

			const hashLink = getMobileNavHashLink(event.target);
			if (hashLink) {
				event.preventDefault();
				event.stopPropagation();
				void navigateMobileNavToHash(hashLink.hash);
				return;
			}

			if (target.closest('#mobile-nav-toggle')) {
				const toggle = document.getElementById('mobile-nav-toggle');
				const isOpen = toggle?.classList.contains('is-open') === true;
				setMobileNavOpen(!isOpen, navLabels());
				return;
			}
		}, true);

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setMobileNavOpen(false, navLabels());
		});
	}

	function revealHeader() {
		const header = document.getElementById('site-header');
		if (!header) return;
		header.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
	}

	function initHeaderIntroReveal() {
		const header = document.getElementById('site-header');
		if (!header || header.dataset.waitIntro !== 'true') return;

		if (hasCompletedIntro()) {
			revealHeader();
			return;
		}

		window.addEventListener('intro-complete', revealHeader, { once: true });
		window.setTimeout(revealHeader, 3500);
	}

	function initHeader() {
		registerMobileNavStateListener(() => syncHeaderAppearance?.());
		initHeaderSolidBackground();
		initMobileNav();
		initHeaderIntroReveal();
		initLogoWave();
	}

	initHeader();
	document.addEventListener('astro:page-load', () => {
		if (!isMobileNavNavigationActive()) {
			forceCloseMobileNav();
		}
		initHeader();
	});
</script>
