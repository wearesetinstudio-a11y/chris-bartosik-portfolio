---
import CaseMediaStack from './CaseMediaStack.astro';
import { getCaseMediaGroups } from '../../utils/getCaseGallery';
import '../../styles/case-study.css';

const projectUrl = '/projects/arte-dance';
const liveUrl = 'https://www.arte-viktoriaoskaldowicz.pl/';
const caseFolder =
	'How to Design a Dance Studio Identity That Doesn’t Shout, But Stands Out';

const mediaGroups = getCaseMediaGroups(caseFolder);
const mediaByGroup = new Map(mediaGroups.map((group) => [group.group, group]));
const heroMedia = mediaByGroup.get(1);
const stepMedia = [mediaByGroup.get(2), mediaByGroup.get(3), mediaByGroup.get(4)];
const resultMedia = mediaByGroup.get(5);

const challenges = [
	{
		title: 'The Mass vs. Boutique Trap',
		body: 'The client needed to escape the polarized perception of the local market. They were neither a faceless mass-volume academy nor a solo independent instructor. They required an identity that projected high-end specialization.',
	},
	{
		title: 'Rejecting Industry Tropes',
		body: 'The immediate challenge was neutralizing predictable visual clichés (literal motion graphics, overdone script fonts, and colorful clutter) in favor of a mature, technique-driven aesthetic.',
	},
	{
		title: 'Functional Longevity',
		body: 'The brand framework had to be bold enough to capture attention, yet stripped-down enough to remain pristine, scalable, and easy to maintain across physical and digital touchpoints.',
	},
];

const steps = [
	{
		label: 'Step 01',
		title: 'Typographic Logotype & Fluid Motion',
		paragraphs: [
			'We designed a custom, minimalist wordmark rather than relying on stock symbols. To reflect the fluid, dynamic nature of modern dance styles (like Broadway jazz and high heels), we subtly animated the letter A.',
			'This introduced a restrained, artistic signature into the mark without adding unnecessary cognitive load or sacrificing legibility at small sizes (as mobile viewports or social media avatars).',
		],
	},
	{
		label: 'Step 02',
		title: 'Monochromatic Baseline',
		paragraphs: [
			'We committed to an uncompromising, high-contrast palette of pure black and white.',
			'While black and white can feel standard on paper, in the regional dance scene every competitor relies on high-saturation color palettes to grab attention. By anchoring the brand in strict monochrome, we turned a simple palette into an aggressive, editorial differentiator.',
		],
	},
	{
		label: 'Step 03',
		title: 'Modular Badges & Information Architecture',
		paragraphs: [
			'We integrated a system of clean, structured information labels (badges) across the branding and digital layout to parse critical class and schedule details.',
			'This established a rigorous visual hierarchy, removing user friction and ensuring that the brand’s communication remained structured and digestible from the first interaction.',
		],
	},
];

const results = [
	{
		title: 'Effortless Distinction',
		body: 'By leaning into a simplicity so stark that mainstream competitors avoid it out of fear of looking “too plain,” the brand achieves immediate, striking distinction.',
	},
	{
		title: 'Ecosystem Cohesion',
		body: 'A completely unified pipeline spanning the core logotype, the visual identity guidelines, and a high-performance web platform built for conversion.',
	},
	{
		title: 'Operational Simplicity',
		body: 'A low-friction, high-impact framework that is effortless to maintain, scale, and manage over time without degrading aesthetic integrity.',
	},
];
---

<article class="case-study">
	<header
		class:list={[
			'case-study__hero',
			(heroMedia?.items.length ?? 0) > 1 ? 'case-study__hero--multi' : 'case-study__hero--single',
		]}
	>
		<div class="case-study__hero-copy">
			<p class="case-study__meta">
				<span class="case-study__meta-item">Arte de Baile</span>
				<span class="case-study__meta-sep" aria-hidden="true">|</span>
				<time class="case-study__meta-item" datetime="2026-11-19">Nov 19, 2026</time>
			</p>

			<h1 class="case-study__title">
				How to design a dance studio identity that doesn’t shout, but stands out?
			</h1>

			<div class="case-study__chips">
				<a class="case-study__chip" href={projectUrl}>
					<span class="case-study__chip-label">Arte de Baile</span>
					<svg
						class="case-study__chip-arrow"
						viewBox="0 0 18 15"
						width="18"
						height="15"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M1 7.5H17M10.6552 14L17 7.5L10.6552 1"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="bevel"
						></path>
					</svg>
				</a>
				<a class="case-study__chip case-study__chip--live" href={liveUrl} target="_blank" rel="noreferrer">
					<span class="case-study__chip-label">Live</span>
					<span class="case-study__chip-dot" aria-hidden="true"></span>
					<svg
						class="case-study__chip-arrow"
						viewBox="0 0 18 15"
						width="18"
						height="15"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M1 7.5H17M10.6552 14L17 7.5L10.6552 1"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="bevel"
						></path>
					</svg>
				</a>
			</div>

			<div class="case-study__overview">
				<p class="case-study__label">
					[
					<span class="case-study__label-text">Overview</span>
					]
				</p>
				<p class="case-study__body">
					In a market crowded with generic, high-volume dance academies relying on cliché dancer
					silhouettes and visual noise, boutique studios face a distinct positioning bottleneck. This
					case study breaks down how we engineered a brand identity and web presence for Arte de Baile
					in Poznań. Instead of defaulting to visual loudness, we deployed a raw, editorial framework
					that treats simplicity as a strategic differentiator—proving that when an aesthetic is so
					foundational that competitors overlook it, it becomes entirely unique.
				</p>
			</div>
		</div>

		<CaseMediaStack
			group={heroMedia}
			label="Arte de Baile cover"
			priority
			class="case-study__media case-study__media--hero"
		/>
	</header>

	<section class="case-study__challenges" aria-labelledby="case-challenges-label">
		<p class="case-study__label" id="case-challenges-label">
			[
			<span class="case-study__label-text">Challenge Definition</span>
			]
		</p>
		<div class="case-study__challenge-list">
			{
				challenges.map((item) => (
					<div class="case-study__challenge">
						<h2 class="case-study__challenge-title">{item.title}</h2>
						<p class="case-study__body">{item.body}</p>
					</div>
				))
			}
		</div>
	</section>

	{
		steps.map((step, index) => {
			const mediaCount = stepMedia[index]?.items.length ?? 0;
			return (
				<section
					class:list={[
						'case-study__step',
						mediaCount > 1 ? 'case-study__step--multi' : 'case-study__step--single',
					]}
				>
					<CaseMediaStack
						group={stepMedia[index]}
						label={step.title}
						class="case-study__media case-study__media--step"
					/>
					<div class="case-study__step-copy">
						<p class="case-study__label">
							[
							<span class="case-study__label-text">{step.label}</span>
							]
						</p>
						<h2 class="case-study__step-title">{step.title}</h2>
						<div class="case-study__copy">
							{step.paragraphs.map((paragraph) => (
								<p class="case-study__body">{paragraph}</p>
							))}
						</div>
					</div>
				</section>
			);
		})
	}

	<section class="case-study__result">
		<CaseMediaStack
			group={resultMedia}
			label="The Result"
			class="case-study__media case-study__media--result"
		/>
		<div class="case-study__result-copy" aria-labelledby="case-result-label">
			<p class="case-study__label" id="case-result-label">
				[
				<span class="case-study__label-text">The Result</span>
				]
			</p>
			<div class="case-study__result-list">
				{
					results.map((item) => (
						<div class="case-study__result-item">
							<h2 class="case-study__result-title">{item.title}</h2>
							<p class="case-study__body">{item.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</article>

