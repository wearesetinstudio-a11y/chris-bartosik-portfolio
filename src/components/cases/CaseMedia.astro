---
import type { CaseMediaItem } from '../../utils/getCaseGallery';
import { encodePublicAssetPath } from '../../utils/getCaseGallery';
import { withPublicAssetVersion } from '../../utils/withPublicAssetVersion';

interface Props {
	item: CaseMediaItem;
	label?: string;
	priority?: boolean;
}

const { item, label = '', priority = false } = Astro.props;
const src = encodePublicAssetPath(withPublicAssetVersion(item.src));
---

{
	item.type === 'image' ? (
		<figure class="case-media case-media--image">
			<img
				src={src}
				alt={label}
				width="1600"
				height="1200"
				class="case-media__asset"
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={priority ? 'high' : undefined}
			/>
		</figure>
	) : (
		<figure class="case-media case-media--video">
			<video
				src={src}
				class="case-media__asset case-media__video"
				muted
				loop
				playsinline
				preload={priority ? 'auto' : 'metadata'}
				aria-label={label || undefined}
			/>
		</figure>
	)
}

<style is:global>
	.case-media {
		margin: 0;
		width: 100%;
		min-width: 0;
		background-color: transparent;
	}

	.case-media__asset {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		object-position: center;
	}

	/* Clip GPU decode artifact lines that show on video edges. */
	@media (min-width: 1024px) {
		.case-media--video {
			position: relative;
			overflow: hidden;
		}

		.case-media--video .case-media__video {
			margin-top: -10px;
			margin-bottom: -10px;
			width: 100%;
			height: auto;
		}
	}
</style>
