---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SeeAllProjectsCard from './SeeAllProjectsCard.astro';
import { t } from '../utils/i18n.ts';

interface Props {
	projects: CollectionEntry<'projects'>[];
	standalone?: boolean;
}

const { projects, standalone = false } = Astro.props;
const displayedProjects = standalone ? projects : projects.slice(0, 5);

const projectFilters = [
	{ id: 'all', labelKey: 'work.filterAll' as const },
	{ id: 'ux-ui', labelKey: 'work.filterUxUi' as const },
	{ id: 'motion', labelKey: 'work.filterMotion' as const },
	{ id: 'ai-engineering', labelKey: 'work.filterAi' as const },
	{ id: 'development', labelKey: 'work.filterDev' as const },
	{ id: 'branding', labelKey: 'work.filterBranding' as const },
	{ id: 'photoaid', labelKey: 'work.filterPhotoaid' as const },
] as const;
---

<section
	id="work"
	class:list={[
		'relative z-20 px-[var(--page-gutter)]',
		standalone
			? 'bg-[#F5F5F5] pt-[calc(72px+60px)] pb-[var(--section-padding-y)] md:pt-[calc(100px+4.5rem)]'
			: 'bg-[#F5F5F5] py-[var(--section-padding-y)]',
	]}
>
	<div
		class:list={[
			'grid gap-6 md:grid-cols-2 md:gap-16',
			standalone ? 'mb-8 md:mb-12' : 'mb-10 md:mb-20',
		]}
	>
		<h2 id="projects-heading" class="projects-heading uppercase leading-[1.15]">
			<span data-reveal-line data-i18n="work.line1">{t('work.line1', 'en')}</span>
			<br />
			<span data-reveal-line data-i18n="work.line2">{t('work.line2', 'en')}</span>
		</h2>
		<p class="projects-description max-w-md md:ml-auto" data-i18n="work.description">
			{t('work.description', 'en')}
		</p>
	</div>

	{
		standalone && (
			<div class="projects-filters mb-10 md:mb-20" data-projects-filters role="group" aria-label={t('work.pageTitle', 'en')}>
				{projectFilters.map((filter, index) => (
					<button
						type="button"
						class:list={['projects-filters__btn', index === 0 && 'is-active']}
						data-project-filter={filter.id}
						data-i18n={filter.labelKey}
						aria-pressed={index === 0 ? 'true' : 'false'}
					>
						{t(filter.labelKey, 'en')}
					</button>
				))}
			</div>
		)
	}

	<div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-2" data-projects-grid>
		{displayedProjects.map((project) => <ProjectCard project={project} />)}
		{!standalone && <SeeAllProjectsCard count={projects.length} href="/projects" />}
	</div>

	<div id="project-cursor" class="project-cursor pointer-events-none fixed z-[200]" aria-hidden="true">
		<span class="project-cursor__label">
			<span class="project-cursor__text" data-i18n="project.view">{t('project.view', 'en')}</span>
			<span class="project-cursor__line"></span>
		</span>
	</div>
</section>

<style is:global>
	.projects-heading {
		font-size: 1.4rem;
		line-height: 1.15;
		color: #000000;
	}

	.projects-heading [data-reveal-line] {
		display: inline-block;
		white-space: nowrap;
	}

	.projects-description {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.5;
		color: rgba(0, 0, 0, 0.55);
	}

	.projects-filters {
		display: flex;
		flex-wrap: nowrap;
		align-items: flex-end;
		gap: 0.75rem 1rem;
		overflow-x: auto;
		padding-bottom: 0.15rem;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.projects-filters::-webkit-scrollbar {
		display: none;
	}

	.projects-filters__btn {
		flex: 0 0 auto;
		margin: 0;
		padding: 0 0 0.2rem;
		border: 0;
		border-bottom: 1.5px solid rgba(0, 0, 0, 0.18);
		border-radius: 0;
		background: transparent;
		cursor: pointer;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		line-height: 1.2;
		text-transform: uppercase;
		color: #000000;
		transition: color 0.2s ease, border-color 0.2s ease;
		white-space: nowrap;
	}

	.projects-filters__btn:hover {
		color: rgba(0, 0, 0, 0.7);
	}

	.projects-filters__btn.is-active {
		color: #f54100;
		border-bottom-color: #f54100;
	}

	.project-card.is-filter-hidden {
		display: none;
	}

	@media (min-width: 768px) {
		.projects-heading {
			font-size: 2rem;
		}

		.projects-description {
			font-size: 1.1rem;
			line-height: 1.55;
		}

		.projects-filters {
			gap: 1.5rem 2rem;
		}

		.projects-filters__btn {
			font-size: 0.85rem;
			padding-bottom: 0.25rem;
		}
	}

	#projects-heading .reveal-char {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	#projects-heading .reveal-char.active {
		color: rgba(0, 0, 0, 1);
	}

	.project-cursor {
		left: 0;
		top: 0;
		display: flex;
		width: 7.5rem;
		height: 7.5rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background-color: #ffffff;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(-9999px, -9999px, 0) translate(-50%, -50%) scale(0.92);
		transition: opacity 0.22s ease-out, visibility 0s linear 0.22s;
		backface-visibility: hidden;
	}

	.project-cursor.is-active {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.22s ease-out, visibility 0s linear 0s;
		will-change: transform;
	}

	.project-cursor__label {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.125rem;
		font-size: 1.2rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
		color: #18191b;
	}

	.project-cursor__text {
		text-align: center;
	}

	.project-cursor.is-coming-soon .project-cursor__text {
		max-width: 5.4rem;
		line-height: 1.05;
		white-space: normal;
	}

	.project-cursor.is-coming-soon .project-cursor__line {
		display: none;
	}

	.project-cursor__line {
		width: 100%;
		height: 1.5px;
		background-color: #18191b;
	}

	body[data-project-cursor-init='true'] .project-card__cursor-target {
		cursor: none;
	}

	@media (max-width: 767px) {
		.project-cursor {
			display: none !important;
		}

		body[data-project-cursor-init='true'] .project-card__cursor-target {
			cursor: auto;
		}
	}
</style>

<script>
	import { t } from '../utils/i18n.ts';
	import { initProjectCardVideos } from '../scripts/initProjectCardVideos.ts';
	import { initRivePlayers } from '../scripts/initRivePlayers.ts';
	import { initProjectsFilter } from '../scripts/initProjectsFilter.ts';

	function isComingSoonCard(card: Element) {
		return card.hasAttribute('data-coming-soon') || card.classList.contains('project-card--soon');
	}

	function applyCursorLabel(cursor: HTMLElement, comingSoon: boolean) {
		const text = cursor.querySelector<HTMLElement>('.project-cursor__text');
		cursor.classList.toggle('is-coming-soon', comingSoon);

		if (!text) return;

		text.textContent = comingSoon ? t('project.comingSoon') : t('project.view');
		text.dataset.i18n = comingSoon ? 'project.comingSoon' : 'project.view';
	}
	function initMobileComingSoonCursor(workSection: HTMLElement) {
		const soonCards = workSection.querySelectorAll<HTMLElement>('[data-coming-soon]');
		if (!soonCards.length) return;

		workSection.dataset.projectCursorReady = 'true';
		delete document.body.dataset.projectCursorInit;

		let activeCard: HTMLElement | null = null;
		let dismissBound = false;

		function hideSoon() {
			if (!activeCard) return;
			activeCard.classList.remove('is-soon-active');
			activeCard = null;
			unbindDismiss();
		}

		function onDismiss() {
			hideSoon();
		}

		function bindDismiss() {
			if (dismissBound) return;
			dismissBound = true;
			window.addEventListener('scroll', onDismiss, { passive: true });
			window.addEventListener('pointerdown', onPointerDown, { capture: true });
		}

		function unbindDismiss() {
			if (!dismissBound) return;
			dismissBound = false;
			window.removeEventListener('scroll', onDismiss);
			window.removeEventListener('pointerdown', onPointerDown, { capture: true });
		}

		function onPointerDown(event: Event) {
			const target = event.target;
			if (!(target instanceof Node) || !activeCard) return;
			if (activeCard.contains(target)) return;
			hideSoon();
		}

		soonCards.forEach((card) => {
			card.addEventListener('click', (event) => {
				event.preventDefault();
				event.stopPropagation();

				if (activeCard === card) {
					hideSoon();
					return;
				}

				if (activeCard) {
					activeCard.classList.remove('is-soon-active');
				}

				activeCard = card;
				card.classList.add('is-soon-active');
				bindDismiss();
			});
		});
	}

	function initProjectCursor() {
		const workSection = document.getElementById('work');
		if (!workSection) {
			delete document.body.dataset.projectCursorInit;
			return;
		}

		if (workSection.dataset.projectCursorReady === 'true') return;

		const cursor = document.getElementById('project-cursor');
		if (!cursor) return;

		if (window.matchMedia('(max-width: 767px)').matches) {
			initMobileComingSoonCursor(workSection);
			return;
		}

		const cards = workSection.querySelectorAll('.project-card__cursor-target');
		if (!cards.length) return;

		workSection.dataset.projectCursorReady = 'true';
		document.body.dataset.projectCursorInit = 'true';

		let hovering = false;
		let activeCard: Element | null = null;
		let rafId = 0;
		let targetX = window.innerWidth / 2;
		let targetY = window.innerHeight / 2;
		let currentX = targetX;
		let currentY = targetY;
		let currentScale = 0.92;
		const lag = 0.32;
		const scaleLag = 0.42;

		function animateCursor() {
			currentX += (targetX - currentX) * lag;
			currentY += (targetY - currentY) * lag;

			const targetScale = hovering ? 1 : 0.92;
			currentScale += (targetScale - currentScale) * scaleLag;

			cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%) scale(${currentScale})`;

			const positionSettled =
				Math.abs(targetX - currentX) < 0.4 && Math.abs(targetY - currentY) < 0.4;
			const scaleSettled = Math.abs(targetScale - currentScale) < 0.002;

			if (hovering || !positionSettled || !scaleSettled) {
				rafId = requestAnimationFrame(animateCursor);
			} else {
				rafId = 0;
				cursor.style.willChange = '';
			}
		}

		function startCursorAnimation() {
			if (!rafId) {
				cursor.style.willChange = 'transform';
				rafId = requestAnimationFrame(animateCursor);
			}
		}

		function showCursor(clientX: number, clientY: number) {
			targetX = clientX;
			targetY = clientY;
			if (!hovering) {
				currentX = clientX;
				currentY = clientY;
				currentScale = 0.97;
			}
			hovering = true;
			cursor.classList.add('is-active');
			startCursorAnimation();
		}

		function hideCursor() {
			hovering = false;
			cursor.classList.remove('is-active');
			startCursorAnimation();
		}

		cards.forEach((card) => {
			card.addEventListener(
				'mouseenter',
				(event) => {
					const mouseEvent = event as MouseEvent;
					activeCard = card;
					applyCursorLabel(cursor, isComingSoonCard(card));
					showCursor(mouseEvent.clientX, mouseEvent.clientY);
				},
				{ passive: true },
			);

			card.addEventListener(
				'mouseleave',
				() => {
					if (activeCard === card) {
						activeCard = null;
						hideCursor();
					}
				},
				{ passive: true },
			);
		});

		workSection.addEventListener(
			'mousemove',
			(event) => {
				if (!hovering || !activeCard) return;

				targetX = event.clientX;
				targetY = event.clientY;
				startCursorAnimation();
			},
			{ passive: true },
		);
	}

	import { wrapRevealLetters } from '../scripts/initScrollLetterReveal.ts';

	function wrapLetters(element: HTMLElement) {
		wrapRevealLetters(element);
	}

	function updateProjectsHeadingReveal() {
		const heading = document.getElementById('projects-heading');
		if (!heading) return;

		const chars = heading.querySelectorAll('.reveal-char');
		if (!chars.length) return;

		const rect = heading.getBoundingClientRect();
		const viewportHeight = window.innerHeight;
		const startLine = viewportHeight * 0.88;
		const endLine = viewportHeight * 0.45;
		const range = startLine - endLine;
		const progress = Math.min(1, Math.max(0, (startLine - rect.top) / range));
		const activeCount = Math.ceil(progress * chars.length);

		chars.forEach((char, index) => {
			char.classList.toggle('active', index < activeCount);
		});
	}

	let scrollTicking = false;

	function onProjectsScroll() {
		if (scrollTicking) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			updateProjectsHeadingReveal();
			scrollTicking = false;
		});
	}

	function initProjectsHeadingReveal() {
		const heading = document.getElementById('projects-heading');
		if (!heading) return;

		heading.querySelectorAll('[data-reveal-line]').forEach((line) => {
			wrapLetters(line as HTMLElement);
		});

		updateProjectsHeadingReveal();

		if (heading.dataset.revealInit === 'true') return;
		heading.dataset.revealInit = 'true';

		window.addEventListener('scroll', onProjectsScroll, { passive: true });
		window.addEventListener('resize', updateProjectsHeadingReveal, { passive: true });
	}

	function initProjectsSection() {
		initProjectsFilter();
		initProjectCursor();
		initProjectsHeadingReveal();
		initProjectCardVideos();
		initRivePlayers();
	}

	document.addEventListener('astro:page-load', initProjectsSection);
	document.addEventListener('i18n-applied', initProjectsHeadingReveal);

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectsSection, { once: true });
	} else {
		initProjectsSection();
	}
</script>
