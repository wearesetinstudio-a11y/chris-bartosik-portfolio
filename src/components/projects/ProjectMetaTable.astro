---
import ProjectInfoRow from './ProjectInfoRow.astro';

interface Props {
	rows: { label: string; value: string; isLink?: boolean }[];
}

const { rows } = Astro.props;
---

{
	rows.length > 0 ? (
		<section class="bg-[#ECECEC] px-[60px] py-16 text-[#131415] md:py-20">
			<div class="overflow-hidden border-y border-black/10">
				<dl>
					{rows.map((row, index) => (
						<ProjectInfoRow
							label={row.label}
							value={row.value}
							isLink={row.isLink}
							isLast={index === rows.length - 1}
							theme="light"
						/>
					))}
				</dl>
			</div>
		</section>
	) : null
}
