---
interface Props {
	label: string;
	labelKey?: string;
	value: string;
	href?: string;
	isLink?: boolean;
	underlined?: boolean;
	fieldKey?: string;
	isLast?: boolean;
	theme?: 'dark' | 'light';
}

const {
	label,
	labelKey,
	value,
	href = '',
	isLink = false,
	underlined = false,
	fieldKey,
	isLast = false,
	theme = 'dark',
} = Astro.props;

const linkHref = href || (isLink ? value : '');
const showLink = Boolean(linkHref);
const resolvedHref = linkHref.startsWith('http') ? linkHref : `https://${linkHref}`;

const labelClass =
	theme === 'dark'
		? 'project-info-row__label font-semibold text-white/40'
		: 'project-info-row__label font-semibold text-black/40';

const valueClass =
	theme === 'dark'
		? 'project-info-row__value text-right text-white'
		: 'project-info-row__value text-right text-[#131415]';

const linkClass =
	theme === 'dark'
		? 'underline decoration-white/50 underline-offset-4 transition-colors hover:decoration-white'
		: 'underline decoration-[#131415] underline-offset-4 transition-colors hover:opacity-70';
---

<div
	class:list={[
		'project-info-row grid grid-cols-[120px_1fr] items-baseline gap-6 py-5 md:grid-cols-[140px_1fr] md:gap-10 md:py-6',
		!isLast && (theme === 'dark' ? 'border-b border-white/10' : 'border-b border-black/10'),
	]}
>
	<dt class={labelClass} data-i18n={labelKey}>{label}</dt>
	<dd class={valueClass}>
		{
			showLink ? (
				<a href={resolvedHref} class={linkClass} target="_blank" rel="noreferrer" data-project-field={fieldKey}>
					{value}
				</a>
			) : underlined ? (
				<span class={linkClass} data-project-field={fieldKey}>{value}</span>
			) : (
				<span data-project-field={fieldKey}>{value}</span>
			)
		}
	</dd>
</div>

<style is:global>
	.project-info-row__label {
		font-family: "Fustat", ui-sans-serif, system-ui, sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: var(--label-text-tracking);
		line-height: 1.35;
		text-transform: uppercase;
	}

	.project-info-row__value {
		font-family: "Fustat", ui-sans-serif, system-ui, sans-serif;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.4;
		text-transform: uppercase;
		margin: 0;
	}

	@media (min-width: 768px) {
		.project-info-row__label {
			font-size: var(--label-text-size);
			line-height: var(--body-text-lh);
		}

		.project-info-row__value {
			font-size: var(--body-text-size);
			line-height: var(--body-text-lh);
		}
	}
</style>
