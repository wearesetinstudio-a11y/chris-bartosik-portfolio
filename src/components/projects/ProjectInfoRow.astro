---
interface Props {
	label: string;
	value: string;
	isLink?: boolean;
	isLast?: boolean;
	theme?: 'dark' | 'light';
}

const { label, value, isLink = false, isLast = false, theme = 'dark' } = Astro.props;

const labelClass =
	theme === 'dark'
		? 'text-sm uppercase tracking-[0.12em] text-white/40 md:text-base'
		: 'text-sm uppercase tracking-[0.12em] text-black/40 md:text-base';

const valueClass =
	theme === 'dark'
		? 'text-right text-base font-medium uppercase leading-snug tracking-[0.02em] text-white md:text-xl'
		: 'text-right text-base font-medium uppercase leading-snug tracking-[0.02em] text-[#131415] md:text-xl';
---

<div
	class:list={[
		'grid grid-cols-[120px_1fr] items-start gap-6 py-5 md:grid-cols-[140px_1fr] md:gap-10 md:py-6',
		!isLast && (theme === 'dark' ? 'border-b border-white/10' : 'border-b border-black/10'),
	]}
>
	<dt class={labelClass}>{label}</dt>
	<dd class={valueClass}>
		{
			isLink ? (
				<a href={value.startsWith('http') ? value : `https://${value}`} class="underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white" target="_blank" rel="noreferrer">
					{value.replace(/^https?:\/\//, '')}
				</a>
			) : (
				value
			)
		}
	</dd>
</div>
