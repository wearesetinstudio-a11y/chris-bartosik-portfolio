---
import { t } from '../../utils/i18n.ts';

interface Props {
	href: string;
}

const { href } = Astro.props;
const resolvedHref = href.startsWith('http') ? href : `https://${href}`;
const label = t('project.seeResult', 'en');
---

<a
	class="project-live-result"
	href={resolvedHref}
	target="_blank"
	rel="noreferrer"
>
	<span class="project-live-result__bracket" aria-hidden="true">[</span>
	<span class="project-live-result__label" data-i18n="project.seeResult">{label}</span>
	<span class="project-live-result__dot" aria-hidden="true"></span>
	<img
		src="/icons/arrow.svg"
		alt=""
		width="18"
		height="15"
		class="project-live-result__arrow"
		aria-hidden="true"
	/>
	<span class="project-live-result__bracket" aria-hidden="true">]</span>
</a>

<style is:global>
	a.project-live-result,
	a.project-live-result .project-live-result__label {
		font-weight: 500;
	}

	.project-live-result {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		width: fit-content;
		padding: 0.55rem;
		border-radius: 0;
		background-color: #131415;
		color: #ffffff;
		font-family: 'Fustat', ui-sans-serif, system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition:
			transform 0.25s ease,
			background-color 0.2s ease;
	}

	.project-live-result__bracket {
		display: inline-block;
		flex-shrink: 0;
		font-weight: 500;
	}

	.project-live-result__dot {
		display: inline-block;
		flex: 0 0 7px;
		width: 7px;
		height: 7px;
		min-width: 7px;
		min-height: 7px;
		border-radius: 999px;
		background: #ff2d2d;
		box-shadow: 0 0 0 0 rgba(255, 45, 45, 0.55);
		animation: project-live-dot-pulse 1.2s ease-in-out infinite;
	}

	.project-live-result img.project-live-result__arrow {
		display: block;
		width: 12px;
		height: auto;
		flex-shrink: 0;
		max-width: 12px;
		transform: rotate(-45deg);
		filter: brightness(0) invert(1);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes project-live-dot-pulse {
		0%,
		100% {
			opacity: 1;
			transform: scale(1);
			box-shadow: 0 0 0 0 rgba(255, 45, 45, 0.55);
		}
		50% {
			opacity: 0.35;
			transform: scale(0.85);
			box-shadow: 0 0 0 5px rgba(255, 45, 45, 0);
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.project-live-result:hover,
		.project-live-result:focus-visible {
			background-color: #000000;
			transform: translateY(-1px);
		}

		.project-live-result:hover img.project-live-result__arrow,
		.project-live-result:focus-visible img.project-live-result__arrow {
			transform: rotate(0deg);
		}
	}

	.project-live-result:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-live-result__dot {
			animation: none;
			opacity: 1;
			transform: none;
			box-shadow: none;
		}

		.project-live-result img.project-live-result__arrow,
		.project-live-result:hover img.project-live-result__arrow,
		.project-live-result:focus-visible img.project-live-result__arrow {
			transition: none;
			transform: rotate(-45deg);
		}
	}

	@media (min-width: 768px) {
		.project-live-result {
			padding: 0.6rem;
			font-size: 0.84rem;
			gap: 0.45rem;
		}

		.project-live-result__dot {
			flex-basis: 8px;
			width: 8px;
			height: 8px;
			min-width: 8px;
			min-height: 8px;
		}

		.project-live-result img.project-live-result__arrow {
			width: 14px;
			max-width: 14px;
		}
	}
</style>
