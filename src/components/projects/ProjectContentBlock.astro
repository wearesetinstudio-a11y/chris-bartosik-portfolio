---
import { parseProjectCopyBlocks } from '../../utils/parseProjectCopyBlocks.ts';

interface Props {
	id?: string;
	num?: string;
	index: number;
	label?: string;
	title?: string;
	titleField?: string;
	text?: string;
	textField?: string;
	theme?: 'dark' | 'light' | 'muted';
	headingId?: string;
	sectionIndex?: number;
}

const {
	id,
	num,
	index,
	label = '',
	title = '',
	titleField,
	text = '',
	textField,
	theme = 'light',
	headingId = '',
	sectionIndex,
} = Astro.props;

const titleChars = title.split('');
const contentBlocks = parseProjectCopyBlocks(text);
const resolvedHeadingId = headingId || (title ? `project-section-${index}-heading` : '');
const resolvedSectionId = id || (sectionIndex != null ? `project-section-${sectionIndex + 1}` : `project-section-${index}`);
const resolvedNum = num || String(sectionIndex != null ? sectionIndex + 2 : index).padStart(2, '0');
const hasLabel = Boolean(label.trim());
const hasTitle = Boolean(title.trim());
const hasText = contentBlocks.length > 0;
const hasBody = hasTitle || hasText;
---

{
	hasLabel || hasBody ? (
		<section
			id={resolvedSectionId}
			class="project-content-block w-full"
			data-project-section={sectionIndex ?? index}
		>
			<div class="project-content-block__stack flex w-full flex-col">
				{
					hasLabel ? (
						<p class="project-content-block__label mb-6 flex items-baseline gap-2.5">
							<span class="project-content-block__num font-semibold text-black/35">{resolvedNum}</span>
							<span class="project-content-block__label-bracket font-semibold uppercase tracking-[0.03em] text-black/40">
								[
								<span
									class="project-content-block__label-text"
									data-project-section-field="label"
								>
									{label}
								</span>
								]
							</span>
						</p>
					) : null
				}

				{
					hasTitle ? (
						<h2
							id={resolvedHeadingId}
							class="project-content-block__heading mb-6"
							data-project-section-field="title"
							data-project-field={titleField}
						>
							<span class="project-content-block__heading-line" data-reveal-line>
								{titleChars.map((char) => (
									<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
								))}
							</span>
						</h2>
					) : null
				}

				{
					hasText ? (
						<div
							class="project-content-block__copy flex flex-col gap-6"
							data-project-section-field="text"
							data-project-field={textField}
							data-project-paragraphs={textField || sectionIndex != null ? 'true' : undefined}
							data-paragraph-class="project-content-block__text"
						>
							{contentBlocks.map((block) =>
								block.type === 'list' ? (
									<ul class="project-content-block__list">
										{block.items.map((item) => (
											<li>
												{item.title ? (
													<>
														<strong>{item.title}:</strong>
														{item.body ? ` ${item.body}` : ''}
													</>
												) : (
													item.body
												)}
											</li>
										))}
									</ul>
								) : (
									<p class="project-content-block__text">{block.text}</p>
								),
							)}
						</div>
					) : null
				}
			</div>
		</section>
	) : null
}

<style>
	.project-content-block {
		scroll-margin-top: 160px;
		padding-block: 0;
		background: transparent;
		color: #131415;
	}

	@media (max-width: 767px) {
		.project-content-block {
			scroll-margin-top: 100px;
			padding-block: 0;
		}
	}

	.project-content-block__label {
		font-size: var(--label-text-size);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0;
		line-height: 1.2;
		color: rgba(0, 0, 0, 0.4);
		margin-top: 0;
		flex-wrap: nowrap;
		word-break: normal;
		overflow-wrap: normal;
	}

	.project-content-block__num {
		display: inline-block;
		flex: 0 0 auto;
		flex-shrink: 0;
		white-space: nowrap;
		word-break: keep-all;
		overflow-wrap: normal;
		font-variant-numeric: tabular-nums;
	}

	.project-content-block__label-bracket {
		flex: 1 1 auto;
		min-width: 0;
		word-break: break-word;
		overflow-wrap: break-word;
	}

	.project-content-block__label-text {
		letter-spacing: var(--label-text-tracking);
	}

	.project-content-block__heading {
		font-size: var(--heading-h2-size);
		font-weight: 600;
		text-transform: uppercase;
		line-height: var(--heading-h2-lh);
		letter-spacing: var(--letter-spacing-ui);
		color: #131415;
		margin-top: 0;
		width: 100%;
		max-width: 100%;
	}

	.project-content-block__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: break-word;
		word-break: normal;
	}

	.project-content-block__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-content-block__heading :global(.reveal-char.active) {
		color: #000000;
	}

	.project-content-block__copy {
		color: rgba(0, 0, 0, 0.7);
	}

	.project-content-block__copy :global(p),
	.project-content-block__text {
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: 400;
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		color: inherit;
	}

	.project-content-block__list {
		margin: 0;
		padding-left: 1.35em;
		list-style-type: disc;
		list-style-position: outside;
		font-size: var(--body-text-size);
		font-weight: 400;
		line-height: var(--body-text-lh);
		color: inherit;
	}

	.project-content-block__list li {
		display: list-item;
		margin: 0;
		padding-left: 0.35em;
	}

	.project-content-block__list li + li {
		margin-top: 1.35rem;
	}

	.project-content-block__list li::marker {
		color: currentColor;
	}

	.project-content-block__list :global(strong) {
		font-weight: 700;
		color: #131415;
	}

	:global(.project-page--dark) .project-content-block {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-content-block__label {
		color: rgba(255, 255, 255, 0.4);
	}

	:global(.project-page--dark) .project-content-block__label-bracket {
		color: rgba(255, 255, 255, 0.45) !important;
	}

	:global(.project-page--dark) .project-content-block__num {
		color: rgba(255, 255, 255, 0.4) !important;
	}

	:global(.project-page--dark) .project-content-block__heading {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-content-block__heading :global(.reveal-char) {
		color: rgba(255, 255, 255, 0.15);
	}

	:global(.project-page--dark) .project-content-block__heading :global(.reveal-char.active) {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-content-block__copy {
		color: rgba(255, 255, 255, 0.75);
	}

	:global(.project-page--dark) .project-content-block__list :global(strong) {
		color: #f5f5f5;
	}
</style>
