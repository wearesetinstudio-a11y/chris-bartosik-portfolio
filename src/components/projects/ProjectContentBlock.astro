---
import { parseProjectCopyBlocks } from '../../utils/parseProjectCopyBlocks.ts';

interface Props {
	index: number;
	label?: string;
	title?: string;
	titleField?: string;
	text?: string;
	textField?: string;
	theme?: 'dark' | 'light' | 'muted';
	headingId?: string;
	sectionIndex?: number;
}

const {
	index,
	label = '',
	title = '',
	titleField,
	text = '',
	textField,
	theme = 'light',
	headingId = '',
	sectionIndex,
} = Astro.props;

const titleChars = title.split('');
const contentBlocks = parseProjectCopyBlocks(text);
const resolvedHeadingId = headingId || (title ? `project-section-${index}-heading` : '');
const hasLabel = Boolean(label.trim());
const hasTitle = Boolean(title.trim());
const hasText = contentBlocks.length > 0;
const hasBody = hasTitle || hasText;
---

{
	hasLabel || hasBody ? (
		<section
			class:list={[
				'project-content-block px-[var(--page-gutter)] project-content-block--stacked',
				theme === 'dark'
					? 'project-content-block--dark'
					: theme === 'muted'
						? 'project-content-block--muted'
						: 'project-content-block--light',
			]}
			data-project-section={sectionIndex ?? index}
		>
			<div
				class:list={[
					'project-content-block__grid project-content-block__grid--stacked',
					!hasLabel && 'project-content-block__grid--no-label',
				]}
			>
				{
					hasLabel ? (
						<p class="project-content-block__label">
							[
							<span
								class="project-content-block__label-text"
								data-project-section-field="label"
							>
								{label}
							</span>
							]
						</p>
					) : null
				}

				{
					hasBody ? (
						<div class="project-content-block__body">
							{hasTitle ? (
								<h2
									id={resolvedHeadingId}
									class="project-content-block__heading"
									data-project-section-field="title"
									data-project-field={titleField}
								>
									<span class="project-content-block__heading-line" data-reveal-line>
										{titleChars.map((char) => (
											<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
										))}
									</span>
								</h2>
							) : null}

							{hasText ? (
								<div
									class:list={[
										'project-content-block__copy',
										hasTitle ? 'project-content-block__copy--with-title' : '',
									]}
									data-project-section-field="text"
									data-project-field={textField}
									data-project-paragraphs={textField || sectionIndex != null ? 'true' : undefined}
									data-paragraph-class="project-content-block__text"
								>
									{contentBlocks.map((block) =>
										block.type === 'list' ? (
											<ul class="project-content-block__list">
												{block.items.map((item) => (
													<li>
														{item.title ? (
															<>
																<strong>{item.title}:</strong>
																{item.body ? ` ${item.body}` : ''}
															</>
														) : (
															item.body
														)}
													</li>
												))}
											</ul>
										) : (
											<p class="project-content-block__text">{block.text}</p>
										),
									)}
								</div>
							) : null}
						</div>
					) : null
				}
			</div>
		</section>
	) : null
}

<style>
	.project-content-block--light {
		background: #ffffff;
		color: #131415;
	}

	.project-content-block--muted {
		background: #fafafa;
		color: #131415;
	}

	.project-content-block--dark {
		background: #1c1c1c;
		color: #ffffff;
	}

	.project-content-block--stacked {
		container-type: inline-size;
		padding-block: 7rem;
	}

	@media (min-width: 768px) {
		.project-content-block--stacked {
			padding-block: 10rem;
		}
	}

	.project-content-block__grid {
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 1024px) {
		.project-content-block--stacked .project-content-block__grid,
		.project-content-block__grid--stacked {
			grid-template-columns: minmax(0, 1fr) minmax(0, 65%);
			column-gap: 5rem;
			row-gap: 0;
			align-items: start;
		}

		.project-content-block--stacked .project-content-block__grid--no-label {
			grid-template-columns: minmax(0, 65%);
			justify-content: end;
		}

		.project-content-block--stacked .project-content-block__body {
			width: 100%;
			max-width: none;
			min-width: 0;
			justify-self: stretch;
		}
	}

	@media (min-width: 1280px) {
		.project-content-block--stacked .project-content-block__grid,
		.project-content-block__grid--stacked {
			column-gap: 6rem;
		}
	}

	.project-content-block__label {
		margin: 0;
		font-size: var(--label-text-size);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0;
		line-height: 1.2;
		white-space: nowrap;
	}

	.project-content-block__label-text {
		letter-spacing: var(--label-text-tracking);
	}

	.project-content-block--light .project-content-block__label,
	.project-content-block--muted .project-content-block__label {
		color: rgba(0, 0, 0, 0.4);
	}

	.project-content-block--dark .project-content-block__label {
		color: rgba(255, 255, 255, 0.4);
	}

	.project-content-block__heading {
		margin: 0;
		font-size: var(--heading-h2-size);
		font-weight: 600;
		text-transform: uppercase;
		line-height: var(--heading-h2-lh);
		letter-spacing: var(--letter-spacing-ui);
		color: transparent;
	}

	.project-content-block__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: break-word;
		word-break: normal;
	}

	.project-content-block--light .project-content-block__heading :global(.reveal-char),
	.project-content-block--muted .project-content-block__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-content-block--light .project-content-block__heading :global(.reveal-char.active),
	.project-content-block--muted .project-content-block__heading :global(.reveal-char.active) {
		color: #000000;
	}

	.project-content-block--dark .project-content-block__heading :global(.reveal-char) {
		color: rgba(255, 255, 255, 0.18);
		transition: color 0.35s ease-out;
	}

	.project-content-block--dark .project-content-block__heading :global(.reveal-char.active) {
		color: #ffffff;
	}

	.project-content-block__copy {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.project-content-block__copy--with-title {
		margin-top: 1.5rem;
	}

	.project-content-block--light .project-content-block__copy,
	.project-content-block--muted .project-content-block__copy {
		color: rgba(0, 0, 0, 0.7);
	}

	.project-content-block--dark .project-content-block__copy {
		color: rgba(255, 255, 255, 0.72);
	}

	.project-content-block__copy :global(p),
	.project-content-block__text {
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: 500;
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		color: inherit;
	}

	.project-content-block__list {
		margin: 0;
		padding-left: 1.35em;
		list-style-type: disc;
		list-style-position: outside;
		font-size: var(--body-text-size);
		font-weight: 500;
		line-height: var(--body-text-lh);
		color: inherit;
	}

	.project-content-block__list li {
		display: list-item;
		margin: 0;
		padding-left: 0.35em;
	}

	.project-content-block__list li + li {
		margin-top: 1.35rem;
	}

	.project-content-block__list li::marker {
		color: currentColor;
	}

	.project-content-block__list :global(strong) {
		font-weight: 700;
		color: #131415;
	}

	.project-content-block--dark .project-content-block__list :global(strong) {
		color: #ffffff;
	}
</style>
