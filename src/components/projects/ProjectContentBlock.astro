---
interface Props {
	index: number;
	label: string;
	title?: string;
	text: string;
	theme?: 'dark' | 'light';
	headingId?: string;
}

const { index, label, title = '', text, theme = 'light', headingId = '' } = Astro.props;

const titleChars = title.split('');
const paragraphs = text.split('\n\n').map((part) => part.trim()).filter(Boolean);
const resolvedHeadingId = headingId || (title ? `project-section-${index}-heading` : '');
---

<section
	class:list={[
		'project-content-block px-[var(--page-gutter)] py-20 md:py-28',
		theme === 'dark' ? 'project-content-block--dark' : 'project-content-block--light',
	]}
>
	<div class="project-content-block__grid">
		<p class="project-content-block__label">[{index}] {label}</p>

		<div class="project-content-block__body min-w-0">
			{
				title ? (
					<h2 id={resolvedHeadingId} class="project-content-block__heading">
						<span class="project-content-block__heading-line" data-reveal-line>
							{titleChars.map((char) => (
								<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
							))}
						</span>
					</h2>
				) : null
			}

			<div class:list={['project-content-block__paragraphs', title ? 'project-content-block__paragraphs--with-title' : '']}>
				{
					paragraphs.map((paragraph) => (
						<p class="project-content-block__text">{paragraph}</p>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.project-content-block--light {
		background: #ffffff;
		color: #131415;
	}

	.project-content-block--dark {
		background: #131415;
		color: #ffffff;
	}

	.project-content-block__grid {
		display: grid;
		gap: 2rem;
	}

	@media (min-width: 1024px) {
		.project-content-block__grid {
			grid-template-columns: minmax(140px, 200px) minmax(0, 1fr);
			column-gap: 5rem;
			row-gap: 0;
			align-items: start;
		}
	}

	@media (min-width: 1280px) {
		.project-content-block__grid {
			column-gap: 6rem;
		}
	}

	.project-content-block__label {
		font-size: 1.2rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		line-height: 1.2;
	}

	.project-content-block--light .project-content-block__label {
		color: #000000;
	}

	.project-content-block--dark .project-content-block__label {
		color: #ffffff;
	}

	.project-content-block__heading {
		font-size: 2rem;
		font-weight: 600;
		text-transform: uppercase;
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: transparent;
	}

	@media (min-width: 768px) {
		.project-content-block__heading {
			font-size: 2.25rem;
		}
	}

	.project-content-block__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.project-content-block--light .project-content-block__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-content-block--light .project-content-block__heading :global(.reveal-char.active) {
		color: #000000;
	}

	.project-content-block--dark .project-content-block__heading :global(.reveal-char) {
		color: rgba(255, 255, 255, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-content-block--dark .project-content-block__heading :global(.reveal-char.active) {
		color: #ffffff;
	}

	.project-content-block__paragraphs {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.project-content-block__paragraphs--with-title {
		margin-top: 2rem;
	}

	.project-content-block__text {
		font-size: 1.125rem;
		line-height: 1.625;
	}

	.project-content-block--light .project-content-block__text {
		color: rgba(0, 0, 0, 0.7);
	}

	.project-content-block--dark .project-content-block__text {
		color: rgba(255, 255, 255, 0.75);
	}
</style>
