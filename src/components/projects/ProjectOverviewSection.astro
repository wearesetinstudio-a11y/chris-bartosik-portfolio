---
import ProjectInfoRow from './ProjectInfoRow.astro';
import RivePlayer from '../RivePlayer.astro';
import { t } from '../../utils/i18n.ts';

interface Props {
	id?: string;
	num?: string;
	label?: string;
	labelKey?: string;
	title: string;
	text: string;
	graphicSrc?: string;
	graphicType?: 'image' | 'video' | 'rive' | 'svg' | 'youtube';
	graphicAlt?: string;
	rows: { label: string; labelKey?: string; value: string; href?: string; isLink?: boolean; underlined?: boolean; fieldKey?: string }[];
	caseUrl?: string;
	caseLabel?: string;
	caseLinks?: { label: string; url: string }[];
}

const {
	id = 'project-section-0',
	num = '01',
	label = t('project.overview', 'en'),
	labelKey = 'project.overview',
	title,
	text,
	graphicSrc,
	graphicType = 'image',
	graphicAlt = '',
	rows,
	caseUrl = '',
	caseLabel = '',
	caseLinks = [],
} = Astro.props;

const resolvedCaseLinks = (
	caseLinks.length > 0
		? caseLinks
		: caseUrl.trim() && caseLabel.trim()
			? [{ label: caseLabel.trim(), url: caseUrl.trim() }]
			: []
).filter((link) => link.label.trim() && link.url.trim());
const hasCaseLinks = resolvedCaseLinks.length > 0;

const titleChars = title.split('');
const overviewParagraphs = text.split('\n\n').map((part) => part.trim()).filter(Boolean);
const hasGraphic = Boolean(graphicSrc);
---

<section id={id} class="project-overview relative z-10 bg-white">
	<div class="project-overview__content w-full min-w-0">
		<p class="project-overview__label flex items-baseline gap-2.5">
			<span class="project-overview__num font-semibold text-black/35">{num}</span>
			<span class="project-overview__label-bracket font-semibold uppercase tracking-[0.03em] text-black/40">
				[
				<span
					class="project-overview__label-text"
					data-project-field="overviewLabel"
					data-i18n={labelKey}
				>
					{label}
				</span>
				]
			</span>
		</p>

		{
			title ? (
				<h2 id="project-overview-heading" class="project-overview__heading" data-project-field="overviewTitle">
					<span class="project-overview__heading-line" data-reveal-line>
						{
							titleChars.map((char) => (
								<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
							))
						}
					</span>
				</h2>
			) : null
		}

		{
			overviewParagraphs.length > 0 ? (
				<div
					class="project-overview__text-wrap"
					data-project-field="overviewText"
					data-project-paragraphs="true"
					data-paragraph-class="project-overview__text"
				>
					{
						overviewParagraphs.map((paragraph) => (
							<p class="project-overview__text">{paragraph}</p>
						))
					}
				</div>
			) : null
		}

		{
			rows.length > 0 ? (
				<div class="mt-12 overflow-hidden border-y border-black/10 md:mt-16">
					<dl class="m-0">
						{rows.map((row, index) => (
							<ProjectInfoRow
								label={row.label}
								labelKey={row.labelKey}
								value={row.value}
								href={row.href}
								isLink={row.isLink}
								underlined={row.underlined}
								fieldKey={row.fieldKey}
								isLast={index === rows.length - 1}
								theme="light"
							/>
						))}
					</dl>
				</div>
			) : null
		}

		{
			hasCaseLinks ? (
				<div class="project-overview__case-links">
					{resolvedCaseLinks.map((link) => (
						<a class="project-overview__case-link" href={link.url}>
							<span class="project-overview__case-link-label">{link.label}</span>
							<svg
								class="project-overview__case-link-arrow"
								viewBox="0 0 18 15"
								width="18"
								height="15"
								fill="none"
								aria-hidden="true"
							>
								<path
									d="M1 7.5H17M10.6552 14L17 7.5L10.6552 1"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linejoin="bevel"
								></path>
							</svg>
						</a>
					))}
				</div>
			) : null
		}

		{
			hasGraphic && graphicSrc ? (
				<div class="project-overview__visual mt-12 w-full md:mt-16">
					<div class="project-overview__frame w-full overflow-hidden">
						{
							graphicType === 'youtube' ? (
								<div class="project-overview__youtube relative aspect-video w-full">
									<iframe
										src={graphicSrc}
										title={graphicAlt || label}
										class="absolute inset-0 h-full w-full border-0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										referrerpolicy="strict-origin-when-cross-origin"
										allowfullscreen
										loading="lazy"
									/>
								</div>
							) : graphicType === 'rive' ? (
								<RivePlayer src={graphicSrc} fit="contain" label={graphicAlt} />
							) : graphicType === 'svg' ? (
								<object
									data={graphicSrc}
									type="image/svg+xml"
									class="project-overview__svg block h-auto w-full"
									aria-label={graphicAlt}
								>
									<img
										src={graphicSrc}
										alt={graphicAlt}
										width="1400"
										height="900"
										class="block h-auto w-full"
										loading="eager"
										decoding="auto"
									/>
								</object>
							) : graphicType === 'video' ? (
								<div class="project-overview__video-wrap">
									<video
										src={graphicSrc}
										class="project-overview__video block h-auto w-full"
										muted
										loop
										playsinline
										preload="metadata"
										aria-label={graphicAlt}
									/>
								</div>
							) : (
								<img
									src={graphicSrc}
									alt={graphicAlt}
									width="1400"
									height="900"
									class="block h-auto w-full"
									loading="eager"
									decoding="auto"
								/>
							)
						}
					</div>
				</div>
			) : null
		}
	</div>
</section>

<style>
	.project-overview {
		scroll-margin-top: 160px;
		padding-bottom: 0;
	}

	@media (max-width: 767px) {
		.project-overview {
			scroll-margin-top: 100px;
			padding-bottom: 0;
		}
	}

	.project-overview__content {
		width: 100%;
		max-width: 100%;
	}

	.project-overview__label {
		font-size: 1rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0;
		line-height: 1.2;
		color: rgba(0, 0, 0, 0.4);
		margin: 0;
		flex-wrap: nowrap;
		word-break: normal;
		overflow-wrap: normal;
	}

	.project-overview__num {
		display: inline-block;
		flex: 0 0 auto;
		flex-shrink: 0;
		white-space: nowrap;
		word-break: keep-all;
		overflow-wrap: normal;
		font-variant-numeric: tabular-nums;
	}

	.project-overview__label-bracket {
		flex: 1 1 auto;
		min-width: 0;
		word-break: break-word;
		overflow-wrap: break-word;
	}

	.project-overview__label-text {
		letter-spacing: var(--label-text-tracking);
	}

	.project-overview__heading {
		margin-top: 1.35rem;
		margin-bottom: 0;
		width: 100%;
		max-width: 100%;
		font-size: var(--heading-h2-size);
		font-weight: 500;
		text-transform: none;
		line-height: var(--heading-h2-lh);
		letter-spacing: var(--letter-spacing-ui);
		color: #131415;
	}

	.project-overview__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.project-overview__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-overview__heading :global(.reveal-char.active) {
		color: #000000;
	}

	:global(.project-page--dark) .project-overview__label {
		color: rgba(255, 255, 255, 0.4);
	}

	:global(.project-page--dark) .project-overview__heading {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-overview__heading :global(.reveal-char) {
		color: rgba(255, 255, 255, 0.15);
	}

	:global(.project-page--dark) .project-overview__heading :global(.reveal-char.active) {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-overview__text-wrap {
		color: rgba(255, 255, 255, 0.75);
	}

	:global(.project-page--dark) .project-overview .border-black\/10 {
		border-color: rgba(255, 255, 255, 0.12) !important;
	}

	:global(.project-page--dark) .project-overview :global(.project-info-row__label) {
		color: rgba(255, 255, 255, 0.4) !important;
	}

	:global(.project-page--dark) .project-overview :global(.project-info-row__value) {
		color: #f5f5f5 !important;
	}

	:global(.project-page--dark) .project-overview :global(.project-info-row .border-black\/10) {
		border-color: rgba(255, 255, 255, 0.12) !important;
	}

	:global(.project-page--dark) .project-overview :global(.project-info-row a),
	:global(.project-page--dark) .project-overview :global(.project-info-row span.underline) {
		text-decoration-color: rgba(255, 255, 255, 0.5) !important;
	}

	.project-overview__text-wrap {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		color: rgba(0, 0, 0, 0.7);
	}

	@media (min-width: 768px) {
		.project-overview__heading {
			margin-top: 1.35rem;
		}

		.project-overview__text-wrap {
			margin-top: 1.5rem;
			gap: 1rem;
		}
	}

	.project-overview__text-wrap :global(p),
	.project-overview__text {
		width: 100%;
		max-width: 100%;
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: 400;
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		color: inherit;
	}

	.project-overview__case-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.65rem;
		margin-top: 1.5rem;
	}

	.project-overview__case-link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		width: fit-content;
		max-width: 100%;
		margin-top: 0;
		padding: 0.7rem 0.85rem;
		border: 0;
		border-radius: 0;
		background-color: #f2f2f2;
		color: #131415;
		font-family: 'Fustat', ui-sans-serif, system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.25;
		text-decoration: none;
		text-transform: none;
		transition: background-color 0.2s ease;
	}

	.project-overview__case-link-label {
		min-width: 0;
	}

	.project-overview__case-link-arrow {
		display: block;
		flex-shrink: 0;
		width: auto;
		height: 0.85em;
		transform: rotate(-45deg) translateZ(0);
		transform-origin: center;
		backface-visibility: hidden;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-overview__case-link:hover,
		.project-overview__case-link:focus-visible {
			background-color: #e8e8e8;
		}

		.project-overview__case-link:hover .project-overview__case-link-arrow,
		.project-overview__case-link:focus-visible .project-overview__case-link-arrow {
			transform: rotate(0deg) translateZ(0);
		}
	}

	.project-overview__case-link:focus-visible {
		outline: 2px solid #131415;
		outline-offset: 3px;
	}

	@media (min-width: 768px) {
		.project-overview__case-links {
			margin-top: 1.85rem;
			gap: 0.75rem;
		}

		.project-overview__case-link {
			padding: 0.8rem 1rem;
			font-size: 1.05rem;
			gap: 0.65rem;
		}

		.project-overview__case-link-arrow {
			height: 0.95em;
		}
	}

	.project-overview__visual,
	.project-overview__frame {
		min-width: 0;
		max-width: 100%;
	}

	.project-overview__visual {
		border-radius: 0;
	}

	.project-overview__video-wrap {
		width: 100%;
	}

	/* Desktop-only: clip GPU decode artifact lines at video edges. */
	@media (min-width: 1024px) {
		.project-overview__video-wrap {
			position: relative;
			overflow: hidden;
		}

		.project-overview__video-wrap .project-overview__video {
			margin-top: -10px;
			margin-bottom: -10px;
			width: 100%;
			height: auto;
			object-fit: cover;
		}
	}
</style>
