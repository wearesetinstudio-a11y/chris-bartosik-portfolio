---
import ProjectInfoRow from './ProjectInfoRow.astro';
import { t } from '../../utils/i18n.ts';

interface Props {
	label?: string;
	labelKey?: string;
	title: string;
	text: string;
	graphicSrc: string;
	graphicType?: 'image' | 'video';
	graphicAlt: string;
	rows: { label: string; labelKey?: string; value: string; href?: string; isLink?: boolean; underlined?: boolean; fieldKey?: string }[];
}

const {
	label = t('project.overview', 'en'),
	labelKey = 'project.overview',
	title,
	text,
	graphicSrc,
	graphicType = 'image',
	graphicAlt,
	rows,
} = Astro.props;

const titleChars = title.split('');
const overviewParagraphs = text.split('\n\n').map((part) => part.trim()).filter(Boolean);
---

<section id="project-overview" class="project-overview relative z-10 bg-white px-[var(--page-gutter)] py-20 md:py-28">
	<div class="project-overview__grid grid gap-12 lg:grid-cols-2 lg:gap-20 xl:gap-24">
		<div class="project-overview__content min-w-0">
			<p class="project-overview__label">
				[<span class="project-overview__label-text" data-i18n={labelKey}>{label}</span>]
			</p>

			<h2 id="project-overview-heading" class="project-overview__heading" data-project-field="overviewTitle">
				<span class="project-overview__heading-line" data-reveal-line>
					{
						titleChars.map((char) => (
							<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
						))
					}
				</span>
			</h2>

			<div
				class="project-overview__text-wrap"
				data-project-field="overviewText"
				data-project-paragraphs="true"
				data-paragraph-class="project-overview__text"
			>
				{
					overviewParagraphs.map((paragraph) => (
						<p class="project-overview__text">{paragraph}</p>
					))
				}
			</div>

			{
				rows.length > 0 ? (
					<div class="mt-12 overflow-hidden border-y border-black/10 md:mt-16">
						<dl class="m-0">
							{rows.map((row, index) => (
								<ProjectInfoRow
									label={row.label}
									labelKey={row.labelKey}
									value={row.value}
									href={row.href}
									isLink={row.isLink}
									underlined={row.underlined}
									fieldKey={row.fieldKey}
									isLast={index === rows.length - 1}
									theme="light"
								/>
							))}
						</dl>
					</div>
				) : null
			}
		</div>

		<div class="project-overview__visual min-w-0">
			<div class="project-overview__sticky lg:sticky lg:top-[100px] lg:w-full">
				<div class="project-overview__frame w-full overflow-hidden bg-[#ECECEC]">
					{
						graphicType === 'video' ? (
							<video
								src={graphicSrc}
								class="block h-auto w-full"
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								aria-label={graphicAlt}
							/>
						) : (
							<img
								src={graphicSrc}
								alt={graphicAlt}
								width="720"
								height="900"
								class="block h-auto w-full"
								loading="lazy"
								decoding="async"
							/>
						)
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.project-overview__content {
		width: 100%;
		max-width: 100%;
	}

	.project-overview__label {
		font-size: var(--label-text-size);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0;
		line-height: 1.2;
		color: rgba(0, 0, 0, 0.4);
	}

	.project-overview__label-text {
		letter-spacing: var(--label-text-tracking);
	}

	.project-overview__heading {
		margin-top: 2rem;
		width: 100%;
		max-width: 100%;
		font-size: var(--heading-h2-size);
		font-weight: 600;
		text-transform: uppercase;
		line-height: var(--heading-h2-lh);
		letter-spacing: var(--letter-spacing-ui);
		color: #131415;
	}

	.project-overview__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.project-overview__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-overview__heading :global(.reveal-char.active) {
		color: #000000;
	}

	.project-overview__text-wrap {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		color: rgba(0, 0, 0, 0.7);
	}

	.project-overview__text-wrap :global(p),
	.project-overview__text {
		width: 100%;
		max-width: 100%;
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: 500;
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		color: inherit;
	}

	@media (min-width: 1024px) {
		.project-overview__visual {
			align-self: stretch;
		}

		.project-overview__sticky {
			height: fit-content;
		}
	}

	@media (max-width: 767px) {
		.project-overview {
			padding-bottom: 2rem;
		}
	}
</style>
