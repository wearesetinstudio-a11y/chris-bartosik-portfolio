---
import RivePlayer from '../RivePlayer.astro';
import { t } from '../../utils/i18n.ts';

interface Props {
	id?: string;
	num?: string;
	label?: string;
	labelKey?: string;
	title: string;
	text: string;
	graphicSrc?: string;
	graphicType?: 'image' | 'video' | 'rive' | 'svg' | 'youtube';
	graphicAlt?: string;
	rows: { label: string; labelKey?: string; value: string; href?: string; isLink?: boolean; underlined?: boolean; fieldKey?: string }[];
	caseUrl?: string;
	caseLabel?: string;
	caseLinks?: { label: string; url: string }[];
}

const {
	id = 'project-section-0',
	num = '01',
	label = t('project.overview', 'en'),
	labelKey = 'project.overview',
	title,
	text,
	graphicSrc,
	graphicType = 'image',
	graphicAlt = '',
	rows,
	caseUrl = '',
	caseLabel = '',
	caseLinks = [],
} = Astro.props;

const resolvedCaseLinks = (
	caseLinks.length > 0
		? caseLinks
		: caseUrl.trim() && caseLabel.trim()
			? [{ label: caseLabel.trim(), url: caseUrl.trim() }]
			: []
).filter((link) => link.label.trim() && link.url.trim());
const hasCaseLinks = resolvedCaseLinks.length > 0;

const titleChars = title.split('');
const overviewParagraphs = text.split('\n\n').map((part) => part.trim()).filter(Boolean);
const hasGraphic = Boolean(graphicSrc);
---

<section id={id} class="project-overview relative z-10 bg-[#fafafa]">
	<div class="project-overview__content w-full min-w-0">
		{
			rows.length > 0 ? (
				<dl class="project-overview__meta">
					{rows.map((row) => {
						const linkHref = row.href || (row.isLink ? row.value : '');
						const showLink = Boolean(linkHref);
						const resolvedHref = linkHref
							? linkHref.startsWith('http')
								? linkHref
								: `https://${linkHref}`
							: '';

						return (
							<div class="project-overview__meta-item">
								<dt class="project-overview__meta-label" data-i18n={row.labelKey}>
									[{row.label}]
								</dt>
								<dd class="project-overview__meta-value">
									{showLink ? (
										<a
											class="project-overview__meta-link"
											href={resolvedHref}
											target="_blank"
											rel="noreferrer"
										>
											<span data-project-field={row.fieldKey}>{row.value}</span>
											<svg
												class="project-overview__meta-link-icon"
												width="14"
												height="14"
												viewBox="0 0 14 14"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
												aria-hidden="true"
											>
												<path
													d="M5.5 2.5H2.5C1.94772 2.5 1.5 2.94772 1.5 3.5V11.5C1.5 12.0523 1.94772 12.5 2.5 12.5H10.5C11.0523 12.5 11.5 12.0523 11.5 11.5V8.5"
													stroke="currentColor"
													stroke-width="1.4"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
												<path
													d="M8.5 1.5H12.5V5.5"
													stroke="currentColor"
													stroke-width="1.4"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
												<path
													d="M12.5 1.5L6.5 7.5"
													stroke="currentColor"
													stroke-width="1.4"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</a>
									) : row.underlined ? (
										<span class="project-overview__meta-link" data-project-field={row.fieldKey}>
											{row.value}
										</span>
									) : (
										<span data-project-field={row.fieldKey}>{row.value}</span>
									)}
								</dd>
							</div>
						);
					})}
				</dl>
			) : null
		}

		<p class="project-overview__label flex items-baseline gap-2">
			<span class="project-overview__num">{num}</span>
			<span class="project-overview__sep" aria-hidden="true">/</span>
			<span class="project-overview__label-bracket">
				[
				<span
					class="project-overview__label-text"
					data-project-field="overviewLabel"
					data-i18n={labelKey}
				>
					{label}
				</span>
				]
			</span>
		</p>

		{
			title ? (
				<h2 id="project-overview-heading" class="project-overview__heading" data-project-field="overviewTitle">
					<span class="project-overview__heading-line" data-reveal-line>
						{
							titleChars.map((char) => (
								<span class="reveal-char">{char === ' ' ? ' ' : char}</span>
							))
						}
					</span>
				</h2>
			) : null
		}

		{
			overviewParagraphs.length > 0 ? (
				<div
					class="project-overview__text-wrap"
					data-project-field="overviewText"
					data-project-paragraphs="true"
					data-paragraph-class="project-overview__text"
				>
					{
						overviewParagraphs.map((paragraph) => (
							<p class="project-overview__text">{paragraph}</p>
						))
					}
				</div>
			) : null
		}

		{
			hasCaseLinks ? (
				<div class="project-overview__case-links">
					{resolvedCaseLinks.map((link) => (
						<a class="project-overview__case-link" href={link.url}>
							<span class="project-overview__case-link-label">{link.label}</span>
							<svg
								class="project-overview__case-link-arrow"
								viewBox="0 0 18 15"
								width="18"
								height="15"
								fill="none"
								aria-hidden="true"
							>
								<path
									d="M1 7.5H17M10.6552 14L17 7.5L10.6552 1"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linejoin="bevel"
								></path>
							</svg>
						</a>
					))}
				</div>
			) : null
		}

		{
			hasGraphic && graphicSrc ? (
				<div class="project-overview__visual mt-12 w-full md:mt-16">
					<div class="project-overview__frame w-full overflow-hidden">
						{
							graphicType === 'youtube' ? (
								<div class="project-overview__youtube relative aspect-video w-full">
									<iframe
										src={graphicSrc}
										title={graphicAlt || label}
										class="absolute inset-0 h-full w-full border-0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										referrerpolicy="strict-origin-when-cross-origin"
										allowfullscreen
										loading="lazy"
									/>
								</div>
							) : graphicType === 'rive' ? (
								<RivePlayer src={graphicSrc} fit="contain" label={graphicAlt} />
							) : graphicType === 'svg' ? (
								<object
									data={graphicSrc}
									type="image/svg+xml"
									class="project-overview__svg block h-auto w-full"
									aria-label={graphicAlt}
								>
									<img
										src={graphicSrc}
										alt={graphicAlt}
										width="1400"
										height="900"
										class="block h-auto w-full"
										loading="eager"
										decoding="auto"
									/>
								</object>
							) : graphicType === 'video' ? (
								<div class="project-overview__video-wrap">
									<video
										src={graphicSrc}
										class="project-overview__video block h-auto w-full"
										muted
										loop
										playsinline
										preload="metadata"
										aria-label={graphicAlt}
									/>
								</div>
							) : (
								<img
									src={graphicSrc}
									alt={graphicAlt}
									width="1400"
									height="900"
									class="block h-auto w-full"
									loading="eager"
									decoding="auto"
								/>
							)
						}
					</div>
				</div>
			) : null
		}
	</div>
</section>

<style>
	.project-overview {
		scroll-margin-top: 160px;
		padding-bottom: 0;
		color: #131415;
	}

	@media (max-width: 767px) {
		.project-overview {
			scroll-margin-top: 100px;
			padding-bottom: 0;
		}
	}

	.project-overview__content {
		width: 100%;
		max-width: 100%;
	}

	.project-overview__label {
		font-size: var(--body-text-size);
		font-weight: var(--body-text-weight);
		text-transform: lowercase;
		letter-spacing: 0;
		line-height: var(--body-text-lh);
		color: inherit;
		margin: 0;
		flex-wrap: nowrap;
		word-break: normal;
		overflow-wrap: normal;
	}

	.project-overview__num,
	.project-overview__sep {
		display: inline-block;
		flex: 0 0 auto;
		flex-shrink: 0;
		white-space: nowrap;
		word-break: keep-all;
		overflow-wrap: normal;
		font-variant-numeric: tabular-nums;
	}

	.project-overview__label-bracket {
		flex: 1 1 auto;
		min-width: 0;
		word-break: break-word;
		overflow-wrap: break-word;
	}

	.project-overview__label-text {
		letter-spacing: 0;
		text-transform: lowercase;
	}

	.project-overview__heading {
		margin-top: 1.35rem;
		margin-bottom: 0;
		width: 100%;
		max-width: 100%;
		font-size: var(--heading-h2-size);
		font-weight: 500;
		text-transform: none;
		line-height: var(--heading-h2-lh);
		letter-spacing: var(--letter-spacing-ui);
		color: #131415;
	}

	.project-overview__heading-line {
		display: inline;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.project-overview__heading :global(.reveal-char) {
		color: rgba(0, 0, 0, 0.15);
		transition: color 0.35s ease-out;
	}

	.project-overview__heading :global(.reveal-char.active) {
		color: #000000;
	}

	:global(.project-page--dark) .project-overview__heading {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-overview__heading :global(.reveal-char) {
		color: rgba(255, 255, 255, 0.15);
	}

	:global(.project-page--dark) .project-overview__heading :global(.reveal-char.active) {
		color: #f5f5f5;
	}

	:global(.project-page--dark) .project-overview__text-wrap {
		color: rgba(255, 255, 255, 0.75);
	}

	:global(.project-page--dark) .project-overview .border-black\/10 {
		border-color: rgba(255, 255, 255, 0.12) !important;
	}

	:global(.project-page--dark) .project-overview__meta {
		border-bottom-color: rgba(255, 255, 255, 0.12);
	}

	:global(.project-page--dark) .project-overview__meta-item:not(:last-child) {
		border-right-color: rgba(255, 255, 255, 0.12);
	}

	:global(.project-page--dark) .project-overview__meta-label {
		color: rgba(255, 255, 255, 0.45);
	}

	:global(.project-page--dark) .project-overview__meta-value,
	:global(.project-page--dark) .project-overview__meta-link {
		color: #f5f5f5;
	}

	.project-overview__meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		column-gap: 0;
		row-gap: 1.5rem;
		margin: 0 0 2.5rem;
		padding: 0 0 2.5rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
	}

	@media (min-width: 768px) {
		.project-overview__meta {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			row-gap: 0;
		}
	}

	.project-overview__meta + .project-overview__label {
		margin-top: 0;
	}

	.project-overview__meta-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
		margin: 0;
		min-width: 0;
		padding-right: 1.5rem;
	}

	.project-overview__meta-item:not(:last-child) {
		border-right: none;
	}

	@media (max-width: 767px) {
		.project-overview__meta-item {
			padding-right: 0;
		}
	}

	@media (min-width: 768px) {
		.project-overview__meta-item {
			padding-inline: 1.75rem;
		}

		.project-overview__meta-item:not(:last-child) {
			border-right: 1px solid rgba(0, 0, 0, 0.1);
		}

		.project-overview__meta-item:first-child {
			padding-left: 0;
		}

		.project-overview__meta-item:last-child {
			padding-right: 0;
		}
	}

	.project-overview__meta-label {
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: var(--body-text-weight);
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		text-transform: lowercase;
		color: rgba(0, 0, 0, 0.4);
	}

	.project-overview__meta-value {
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: var(--body-text-weight);
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		color: inherit;
	}

	.project-overview__meta-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: inherit;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.project-overview__meta-link:hover {
		opacity: 0.7;
	}

	.project-overview__meta-link-icon {
		flex-shrink: 0;
		width: 0.85em;
		height: 0.85em;
		display: block;
	}

	.project-overview__text-wrap {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		color: rgba(0, 0, 0, 0.7);
	}

	@media (min-width: 768px) {
		.project-overview__heading {
			margin-top: 1.35rem;
		}

		.project-overview__text-wrap {
			margin-top: 1.5rem;
			gap: 2rem;
		}
	}

	.project-overview__text-wrap :global(p),
	.project-overview__text {
		width: 100%;
		max-width: 100%;
		margin: 0;
		font-size: var(--body-text-size);
		font-weight: var(--body-text-weight);
		line-height: var(--body-text-lh);
		letter-spacing: 0;
		color: inherit;
	}

	.project-overview__case-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.65rem;
		margin-top: 1.5rem;
	}

	.project-overview__case-link {
		display: inline-flex;
		align-items: flex-end;
		gap: 0.55rem;
		width: fit-content;
		max-width: 100%;
		margin-top: 0;
		padding: 0.7rem 0.85rem;
		border: 0;
		border-radius: 0;
		background-color: #f2f2f2;
		color: #131415;
		font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.25;
		text-decoration: none;
		text-transform: none;
		transition: background-color 0.2s ease;
	}

	.project-overview__case-link-label {
		min-width: 0;
	}

	.project-overview__case-link-arrow {
		display: block;
		flex-shrink: 0;
		width: auto;
		height: 0.85em;
		transform: rotate(-45deg) translateZ(0);
		transform-origin: center;
		backface-visibility: hidden;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-overview__case-link:hover,
		.project-overview__case-link:focus-visible {
			background-color: #e8e8e8;
		}

		.project-overview__case-link:hover .project-overview__case-link-arrow,
		.project-overview__case-link:focus-visible .project-overview__case-link-arrow {
			transform: rotate(0deg) translateZ(0);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.project-overview__case-link.is-pressed,
		.project-overview__case-link:active {
			background-color: #e8e8e8;
		}

		.project-overview__case-link.is-pressed .project-overview__case-link-arrow,
		.project-overview__case-link:active .project-overview__case-link-arrow {
			transform: rotate(0deg) translateZ(0);
		}
	}

	.project-overview__case-link:focus-visible {
		outline: 2px solid #131415;
		outline-offset: 3px;
	}

	@media (min-width: 768px) {
		.project-overview__case-links {
			margin-top: 1.85rem;
			gap: 0.75rem;
		}

		.project-overview__case-link {
			padding: 0.8rem 1rem;
			font-size: 1.05rem;
			gap: 0.65rem;
		}

		.project-overview__case-link-arrow {
			height: 0.95em;
		}
	}

	.project-overview__visual,
	.project-overview__frame {
		min-width: 0;
		max-width: 100%;
	}

	.project-overview__visual {
		border-radius: 0;
	}

	.project-overview__video-wrap {
		width: 100%;
	}

	/* Desktop-only: clip GPU decode artifact lines at video edges. */
	@media (min-width: 1024px) {
		.project-overview__video-wrap {
			position: relative;
			overflow: hidden;
		}

		.project-overview__video-wrap .project-overview__video {
			margin-top: -10px;
			margin-bottom: -10px;
			width: 100%;
			height: auto;
			object-fit: cover;
		}
	}
</style>
