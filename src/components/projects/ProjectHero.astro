---
import { t } from '../../utils/i18n.ts';

interface Props {
	heroImage?: string;
	heroSubtitle?: string;
	client?: string;
	/** Override for the [Client] label. Empty = hide label. Undefined = use i18n default when client exists. */
	clientLabel?: string;
}

const {
	heroImage = '',
	heroSubtitle = '',
	client = '',
	clientLabel: clientLabelProp,
} = Astro.props;

const heroLines = heroSubtitle
	.split('\n')
	.map((line) => line.trim())
	.filter(Boolean);

const hasTagline = heroLines.length > 0;
const hasClientName = Boolean(client.trim());
const defaultClientLabel = t('project.client', 'en');
const customClientLabel = clientLabelProp?.trim() ?? '';
const resolvedClientLabel = customClientLabel || (hasClientName ? defaultClientLabel : '');
const hasClientLabel = Boolean(resolvedClientLabel);
const hasMeta = hasClientLabel || hasClientName;
const hasHeroContent = hasTagline || hasMeta;
const usesI18nClientLabel = !customClientLabel && hasClientLabel;
---

<section id="project-hero" class="project-hero relative h-[100svh] overflow-hidden md:h-[85vh]">
	{
		heroImage ? (
			<div
				id="project-hero-visual"
				class="project-hero-visual pointer-events-none fixed inset-x-0 top-0 isolate z-0 h-[100svh] w-full overflow-hidden bg-[#131415] md:h-[85vh]"
				aria-hidden="true"
			>
				<div id="project-hero-parallax" class="project-hero-parallax pointer-events-none absolute inset-x-0">
					<img
						src={heroImage}
						alt=""
						width="1920"
						height="1080"
						class="project-hero-background pointer-events-none absolute inset-0 h-full w-full object-cover object-center md:object-[center_42%]"
						loading="eager"
						decoding="async"
					/>
				</div>

				<div class="pointer-events-none absolute inset-0 z-[1] bg-black/10"></div>
			</div>
		) : (
			<div id="project-hero-visual" class="pointer-events-none absolute inset-0 bg-[#131415]" aria-hidden="true"></div>
		)
	}

	{
		hasHeroContent ? (
			<div class="relative z-10 flex h-full items-end px-[var(--page-gutter)] pb-[60px] pt-28">
				<div
					class:list={[
						'grid w-full items-end gap-[40px] lg:gap-16',
						hasTagline && hasMeta
							? 'grid-cols-1 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,0.3fr)]'
							: 'grid-cols-1',
					]}
				>
					{
						hasTagline ? (
							<div class="min-w-0 w-full" data-hero-part="tagline">
								<h1 id="project-hero-headline" class="project-hero__title w-full uppercase text-white">
									{heroLines.map((line) => (
										<span class="block">{line}</span>
									))}
								</h1>
							</div>
						) : null
					}

					{
						hasMeta ? (
							<div
								class:list={[
									'project-hero__meta',
									hasTagline && 'lg:ml-auto lg:max-w-md lg:text-right',
								]}
								data-hero-part="meta"
							>
								{
									hasClientLabel ? (
										<p class="project-hero__client-label uppercase text-white">
											[
											<span
												class="project-hero__client-label-text"
												data-project-field="clientLabel"
												data-i18n={usesI18nClientLabel ? 'project.client' : undefined}
											>
												{resolvedClientLabel}
											</span>
											]
										</p>
									) : null
								}
								{
									hasClientName ? (
										<p
											class:list={[
												'project-hero__client-name uppercase text-white',
												hasClientLabel && 'mt-3',
											]}
											data-project-field="client"
										>
											{client.toUpperCase()}
										</p>
									) : null
								}
							</div>
						) : null
					}
				</div>
			</div>
		) : null
	}
</section>

<style is:global>
	.project-hero-visual.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	/* Mobile: fill viewport, no parallax overscan/zoom so ~full graphic height stays readable */
	.project-hero-parallax {
		top: 0;
		height: 100%;
		will-change: transform;
	}

	.project-hero-background {
		transform: scale(1);
		transform-origin: center center;
	}

	.project-hero__title {
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: var(--letter-spacing-ui);
	}

	.project-hero__client-label {
		margin: 0;
		font-size: var(--label-text-size);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.2;
	}

	.project-hero__client-label-text {
		letter-spacing: var(--label-text-tracking);
	}

	.project-hero__client-name {
		font-size: 1.6rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: var(--letter-spacing-ui);
	}

	@media (min-width: 768px) {
		.project-hero-parallax {
			top: -12%;
			height: 124%;
		}

		.project-hero-background {
			transform: scale(1.08);
			transform-origin: center 42%;
		}

		.project-hero__title {
			font-size: 2.35rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-hero-parallax {
			top: 0;
			height: 100%;
			transform: none !important;
		}

		.project-hero-background {
			transform: scale(1);
		}

		@media (min-width: 768px) {
			.project-hero-background {
				transform: scale(1.12);
			}
		}
	}
</style>

<script>
	let cleanupProjectHero: (() => void) | null = null;

	function initProjectHero() {
		const hero = document.getElementById('project-hero');
		const visual = document.getElementById('project-hero-visual');
		if (!hero || !visual) return;
		if (visual.dataset.heroSyncInit === 'true' && visual.isConnected) return;

		cleanupProjectHero?.();

		const parallax = document.getElementById('project-hero-parallax');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const mobileMq = window.matchMedia('(max-width: 767px)');
		/** Total shift across the full time the hero stays in view — keep it subtle/slow */
		const MAX_SHIFT_RATIO = 0.05;

		let ticking = false;

		const syncHeroVisual = () => {
			const rect = hero.getBoundingClientRect();
			const inViewport = rect.bottom > 0 && rect.top < window.innerHeight;
			visual.classList.toggle('is-hidden', !inViewport);

			// No parallax on mobile: layer is exactly viewport-sized (max graphic height visible)
			if (!parallax || reduceMotion || mobileMq.matches) {
				if (parallax && (reduceMotion || mobileMq.matches)) parallax.style.transform = '';
				return;
			}

			// 0 at top of page → 1 when hero has fully scrolled past the top edge
			const scrolled = Math.max(0, -rect.top);
			const progress = Math.min(1, scrolled / Math.max(1, rect.height));
			// Scroll down → background moves down (opposite to page content), slowly
			const offset = progress * visual.offsetHeight * MAX_SHIFT_RATIO;
			parallax.style.transform = `translate3d(0, ${offset}px, 0)`;
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				syncHeroVisual();
				ticking = false;
			});
		};

		visual.dataset.heroSyncInit = 'true';
		syncHeroVisual();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', syncHeroVisual, { passive: true });

		cleanupProjectHero = () => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', syncHeroVisual);
			delete visual.dataset.heroSyncInit;
			if (parallax) parallax.style.transform = '';
		};
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectHero, { once: true });
	} else {
		initProjectHero();
	}

	document.addEventListener('astro:page-load', initProjectHero);
</script>
