---
import { t } from '../../utils/i18n.ts';

interface Props {
	heroImage?: string;
	heroSubtitle?: string;
	client?: string;
	/** Override for the [Client] label. Empty = hide label. Undefined = use i18n default when client exists. */
	clientLabel?: string;
}

const {
	heroImage = '',
	heroSubtitle = '',
	client = '',
	clientLabel: clientLabelProp,
} = Astro.props;

const heroLines = heroSubtitle
	.split('\n')
	.map((line) => line.trim())
	.filter(Boolean);

const hasTagline = heroLines.length > 0;
const hasClientName = Boolean(client.trim());
const defaultClientLabel = t('project.client', 'en');
const customClientLabel = clientLabelProp?.trim() ?? '';
const resolvedClientLabel = customClientLabel || (hasClientName ? defaultClientLabel : '');
const hasClientLabel = Boolean(resolvedClientLabel);
const hasMeta = hasClientLabel || hasClientName;
const hasHeroContent = hasTagline || hasMeta;
const usesI18nClientLabel = !customClientLabel && hasClientLabel;
---

<section id="project-hero" class="project-hero relative h-[140svh]">
	{
		heroImage ? (
			<div
				id="project-hero-visual"
				class="project-hero-visual pointer-events-none fixed inset-x-0 top-0 isolate z-0 h-[100svh] w-full overflow-hidden bg-[#131415]"
				aria-hidden="true"
			>
				<div
					id="project-hero-bg"
					class="project-hero-bg pointer-events-none absolute inset-0 bg-cover bg-center"
					style={`background-image: url('${heroImage}');`}
				>
					<img
						src={heroImage}
						alt=""
						width="1920"
						height="1080"
						class="project-hero-background pointer-events-none absolute inset-0 h-full w-full object-cover object-center md:object-[center_42%]"
						loading="eager"
						decoding="auto"
						fetchpriority="high"
					/>
				</div>

				<div class="pointer-events-none absolute inset-0 z-[1] bg-black/10"></div>
			</div>
		) : (
			<div id="project-hero-visual" class="pointer-events-none absolute inset-0 bg-[#131415]" aria-hidden="true"></div>
		)
	}

	{
		hasHeroContent ? (
			<div class="project-hero__sticky relative z-10 flex h-[100svh] items-end px-[var(--page-gutter)] pb-[128px] pt-28 md:pb-[104px]">
				<div
					class:list={[
						'project-hero__grid grid w-full items-end gap-[40px] lg:gap-16',
						hasTagline && hasMeta
							? 'grid-cols-1 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,0.3fr)]'
							: 'grid-cols-1',
					]}
				>
					{
						hasTagline ? (
							<div class="min-w-0 w-full" data-hero-part="tagline">
								<h1 id="project-hero-headline" class="project-hero__title w-full uppercase text-white">
									{heroLines.map((line) => (
										<span class="block">{line}</span>
									))}
								</h1>
							</div>
						) : null
					}

					{
						hasMeta ? (
							<div
								class:list={[
									'project-hero__meta',
									hasTagline && 'lg:ml-auto lg:max-w-md lg:text-right',
								]}
								data-hero-part="meta"
							>
								{
									hasClientLabel ? (
										<p class="project-hero__client-label uppercase text-white">
											[
											<span
												class="project-hero__client-label-text"
												data-project-field="clientLabel"
												data-i18n={usesI18nClientLabel ? 'project.client' : undefined}
											>
												{resolvedClientLabel}
											</span>
											]
										</p>
									) : null
								}
								{
									hasClientName ? (
										<p
											class:list={[
												'project-hero__client-name uppercase text-white',
												hasClientLabel && 'mt-3',
											]}
											data-project-field="client"
										>
											{client.toUpperCase()}
										</p>
									) : null
								}
							</div>
						) : null
					}
				</div>
			</div>
		) : null
	}
</section>

<style is:global>
	.project-hero {
		--project-hero-height: 140svh;
		--project-hero-content-height: 100svh;
	}

	.project-hero__sticky {
		position: sticky;
		top: 0;
		height: var(--project-hero-content-height);
	}

	.project-hero-visual.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	.project-hero-bg {
		inset: 0;
	}

	.project-hero__title {
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: var(--letter-spacing-ui);
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}

	.project-hero__client-label {
		margin: 0;
		font-size: var(--label-text-size);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.2;
	}

	.project-hero__client-label-text {
		letter-spacing: var(--label-text-tracking);
	}

	.project-hero__client-name {
		font-size: 1.6rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: var(--letter-spacing-ui);
	}

	@media (min-width: 768px) {
		.project-hero__title {
			font-size: 2.35rem;
		}
	}
</style>

<script>
	let cleanupProjectHero: (() => void) | null = null;

	function initProjectHero() {
		const hero = document.getElementById('project-hero');
		const visual = document.getElementById('project-hero-visual');
		if (!hero || !visual) return;
		if (visual.dataset.heroSyncInit === 'true' && visual.isConnected) return;

		cleanupProjectHero?.();

		let ticking = false;

		const syncHeroVisual = () => {
			const rect = hero.getBoundingClientRect();
			const inViewport = rect.bottom > 0 && rect.top < window.innerHeight;
			visual.classList.toggle('is-hidden', !inViewport);
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				syncHeroVisual();
				ticking = false;
			});
		};

		visual.dataset.heroSyncInit = 'true';
		syncHeroVisual();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', syncHeroVisual, { passive: true });

		cleanupProjectHero = () => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', syncHeroVisual);
			delete visual.dataset.heroSyncInit;
		};
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectHero, { once: true });
	} else {
		initProjectHero();
	}

	document.addEventListener('astro:page-load', initProjectHero);
</script>
