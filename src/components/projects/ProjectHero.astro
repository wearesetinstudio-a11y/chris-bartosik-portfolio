---
interface Props {
	heroImage?: string;
	heroLines: string[];
	client: string;
}

const { heroImage = '', heroLines, client } = Astro.props;
const clientLabel = client.toUpperCase();
---

<section id="project-hero" class="project-hero relative h-[85vh] overflow-hidden">
	{
		heroImage ? (
			<div
				id="project-hero-visual"
				class="project-hero-visual pointer-events-none fixed inset-x-0 top-0 isolate z-0 h-[85vh] w-full overflow-hidden bg-[#131415]"
				aria-hidden="true"
			>
				<img
					src={heroImage}
					alt=""
					width="1920"
					height="1080"
					class="project-hero-background pointer-events-none absolute inset-0 h-full w-full object-cover object-[center_42%]"
					loading="eager"
					decoding="async"
				/>

				<div class="pointer-events-none absolute inset-0 z-[1] bg-black/10"></div>

				<canvas
					id="project-hero-noise-filter"
					class="pointer-events-none absolute inset-0 z-[2] block h-full w-full bg-transparent"
					aria-hidden="true"
				></canvas>
			</div>
		) : (
			<div id="project-hero-visual" class="pointer-events-none absolute inset-0 bg-[#131415]" aria-hidden="true"></div>
		)
	}

	<div class="relative z-10 flex h-full items-end px-[60px] pb-[60px] pt-28">
		<div class="grid w-full grid-cols-1 items-end gap-10 lg:grid-cols-2 lg:gap-16">
			<div class="w-[75vw] max-w-[75vw]">
				<h1 id="hero-headline" class="project-hero__title uppercase text-white">
					{
						heroLines.map((line) => (
							<span class="block">{line}</span>
						))
					}
				</h1>
			</div>

			<div class="lg:ml-auto lg:max-w-md lg:text-right">
				<p class="text-[1.2rem] font-semibold uppercase tracking-[0.14em] text-white">[Client]</p>
				<p class="mt-3 text-[1.8rem] font-semibold uppercase leading-[1.08] tracking-tight text-white">
					{clientLabel}
				</p>
			</div>
		</div>
	</div>
</section>

<style is:global>
	.project-hero-visual.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	.project-hero-background {
		transform: scale(1.12);
		transform-origin: center 42%;
	}

	.project-hero__title {
		font-size: 2.75rem;
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.01em;
	}
</style>

<script>
	import { initCinemaPureNoise } from '../../scripts/initCinemaPureNoise.ts';

	function initProjectHero() {
		initCinemaPureNoise('project-hero-noise-filter', { observeElementId: 'project-hero' });

		const hero = document.getElementById('project-hero');
		const visual = document.getElementById('project-hero-visual');
		if (!hero || !visual) return;

		const syncHeroVisual = () => {
			const heroBottom = hero.getBoundingClientRect().bottom;
			visual.classList.toggle('is-hidden', heroBottom <= 0);
		};

		syncHeroVisual();
		window.addEventListener('scroll', syncHeroVisual, { passive: true });
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectHero, { once: true });
	} else {
		initProjectHero();
	}

	document.addEventListener('astro:page-load', initProjectHero);
</script>
