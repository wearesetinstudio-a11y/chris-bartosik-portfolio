---
import type { GalleryLayoutBlock } from '../../utils/getProjectGallery';
import ProjectGalleryMedia from './ProjectGalleryMedia.astro';

interface Props {
	blocks: GalleryLayoutBlock[];
	title: string;
	startIndex?: number;
}

const { blocks, title, startIndex = 0 } = Astro.props;

let mediaIndex = startIndex;
---

<section class="project-gallery w-full">
	<div class="project-gallery__stack">
		{
			blocks.map((block) => {
				if (block.kind === 'full') {
					const currentIndex = mediaIndex;
					mediaIndex += 1;

					return (
						<div class="project-gallery__row project-gallery__row--full">
							<ProjectGalleryMedia item={block.item} title={title} index={currentIndex} />
						</div>
					);
				}

				const gridItems = block.items.map((item) => {
					const currentIndex = mediaIndex;
					mediaIndex += 1;
					return { item, index: currentIndex };
				});

				return (
					<div
						class:list={[
							'project-gallery__row project-gallery__row--grid',
							block.leadFull && 'project-gallery__row--lead-full',
							!block.leadFull &&
								(gridItems.length === 3
									? 'project-gallery__row--grid-3'
									: 'project-gallery__row--grid-2'),
						]}
					>
						{gridItems.map(({ item, index }) => (
							<ProjectGalleryMedia item={item} title={title} index={index} />
						))}
					</div>
				);
			})
		}
	</div>
</section>

<style>
	:root {
		--project-gallery-gap: 32px;
	}

	@media (max-width: 767px) {
		:root {
			--project-gallery-gap: 20px;
		}
	}

	.project-gallery {
		background: transparent;
		padding-block: 0;
		min-width: 0;
		max-width: 100%;
	}

	.project-gallery__stack {
		display: flex;
		flex-direction: column;
		gap: var(--project-gallery-gap);
		min-width: 0;
		max-width: 100%;
	}

	.project-gallery__row--full,
	.project-gallery__row--grid {
		width: 100%;
		min-width: 0;
		max-width: 100%;
	}

	.project-gallery__row--grid {
		display: grid;
		gap: var(--project-gallery-gap);
	}

	.project-gallery__row--grid-2 {
		grid-template-columns: minmax(0, 1fr);
	}

	@media (min-width: 768px) {
		.project-gallery__row--grid-2 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.project-gallery__row--grid-3 {
		grid-template-columns: minmax(0, 1fr);
	}

	@media (min-width: 768px) {
		.project-gallery__row--grid-3 {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.project-gallery__row--lead-full {
		grid-template-columns: minmax(0, 1fr);
	}

	@media (min-width: 768px) {
		.project-gallery__row--lead-full {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.project-gallery__row--lead-full > :global(:first-child) {
			grid-column: 1 / -1;
		}
	}

	.project-gallery__row :global(.project-gallery__item) {
		min-width: 0;
		max-width: 100%;
	}

	.project-gallery__row :global(.project-gallery__item img),
	.project-gallery__row :global(.project-gallery__item video),
	.project-gallery__row :global(.project-gallery__item object),
	.project-gallery__row :global(.project-gallery__item canvas),
	.project-gallery__row :global(.project-gallery__item .rive-player) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
	}

	@media (max-width: 767px) {
		.project-gallery__row :global(.project-gallery__item img),
		.project-gallery__row :global(.project-gallery__item video),
		.project-gallery__row :global(.project-gallery__item .rive-player) {
			vertical-align: top;
		}
	}
</style>
